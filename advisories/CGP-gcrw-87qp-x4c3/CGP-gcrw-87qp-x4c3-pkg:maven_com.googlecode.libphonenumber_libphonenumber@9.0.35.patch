+  /**
+   * At exactly the cap the polynomial worst case stays small for every adversarial shape, through
+   * all three methods, at the usual default thread stack (no StackOverflowError, well within the
+   * budget): the 250-character cap alone is sufficient.
+   */
+  public void testAdversarialShapesAtExactlyCapAreFast() throws Exception {
+    List<String> harms = new ArrayList<String>();
+    final String[] shapes = {
+      repeat('1', CAP - 1) + ";",
+      "123" + repeat(' ', CAP - 4) + "q",
+      "123" + repeat(' ', CAP - 4) + "x",
+      "123" + repeat(',', CAP - 4) + "a",
+      repeat('1', CAP),
+      repeat('1', CAP - EXTENSION.length()) + EXTENSION,
+    };
+    for (final String shape : shapes) {
+      assertEquals(CAP, shape.length());
+      drive(harms, "isAlphaNumber(at-cap shape)", CAP, DEFAULT_STACK_BYTES, null,
+          () -> phoneUtil.isAlphaNumber(shape));
+      drive(harms, "isViablePhoneNumber(at-cap shape)", CAP, DEFAULT_STACK_BYTES, null,
+          () -> PhoneNumberUtil.isViablePhoneNumber(shape));
+      drive(harms, "maybeStripExtension(at-cap shape)", CAP, DEFAULT_STACK_BYTES, null,
+          () -> phoneUtil.maybeStripExtension(new StringBuilder(shape)));
+    }
+    assertNoHarm(harms);
+  }
