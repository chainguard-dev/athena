+  // ---------------------------------------------------------------------------------------------
+
+  /** Raw input reaching the nested prefix re-evaluation (StackOverflowError shape). */
+  private static String digitsThenExtensionRawInput() {
+    return repeat('1', DOCUMENTED_DIGITS) + EXTENSION;
+  }
