+/**
+ * Security exploit harness for CGP-gcrw-87qp-x4c3 (CWE-1333 / CWE-400 / CWE-789): regular
+ * expression denial of service through {@code PhoneNumberUtil.isAlphaNumber(CharSequence)} and the
+ * two helpers that run the vulnerable patterns.
+ *
+ * <p>{@code isAlphaNumber} hands caller-supplied text of ANY length to
+ * {@code isViablePhoneNumber} ({@code VALID_PHONE_NUMBER_PATTERN.matcher(number).matches()}) and
+ * then to {@code maybeStripExtension} ({@code EXTN_PATTERN.matcher(number).find()} followed by a
+ * second {@code isViablePhoneNumber} on the text before the extension). Both patterns backtrack
+ * polynomially (O(n^2)) on crafted non-matching input, and the {@code (?:[punct]*\d){3,}} group
+ * recurses once per digit, so a long digit run throws an uncontrolled {@link StackOverflowError}
+ * out of a boolean method. {@code parseHelper} bounds its input to {@code MAX_INPUT_STRING_LENGTH}
+ * (250) before any regex runs precisely to prevent this; the other routes skip that bound. A
+ * further route reaches the same {@code EXTN_PATTERN} sink without {@code isAlphaNumber}:
+ * {@code formatOutOfCountryKeepingAlphaChars(PhoneNumber, String)} passes the number's raw input
+ * (public setter, Java-serializable field) to {@code maybeStripExtension}.
+ *
+ * <p>The security invariant each attack test pins: no text longer than the library's own
+ * 250-character cap may be evaluated by those regexes, by any route; over-cap text is refused with
+ * the method's normal non-throwing shape ({@code false} / {@code false} / {@code ""} with the buffer
+ * unchanged), and no more than 250 characters of a caller-supplied {@link CharSequence} are read.
+ * Each payload runs on a dedicated worker thread under a preemptive time budget, so the run FAILS
+ * (never hangs) when the regex engine burns CPU; an escaping {@link StackOverflowError}, a
+ * read-counting {@link CharSequence} read past its budget, or an over-cap input that is evaluated
+ * (accepted, or stripped) are likewise recorded as the harmful effect and FAIL the test. On the
+ * UNPATCHED tree every attack test fails (RED); on a correctly patched tree every test passes, and
+ * the positive controls pass on BOTH trees.
+ */
+public class AlphaNumberRedosTest extends TestMetadataTestCase {
+
+  /** The cap {@code parseHelper} already enforces; mirrored here so the boundary is explicit. */
+  private static final int CAP = 250;
+
+  /**
+   * Wall-clock budget for one call. A correctly bounded call returns in microseconds; the CPU-time
+   * attack sizes below take several seconds on the unpatched tree.
+   */
+  private static final long TIME_BUDGET_MILLIS = 2000L;
+
+  /**
+   * Stack size for the worker threads of the CPU-time attacks: large enough that the quadratic
+   * backtracking (not a stack overflow) is what the unpatched tree exhibits for those shapes.
+   */
+  private static final long LARGE_STACK_BYTES = 256L * 1024 * 1024;
+
+  /** Stack size matching the usual JVM default thread stack (1 MiB on 64-bit Linux). */
+  private static final long DEFAULT_STACK_BYTES = 1024L * 1024;
+
+  /** The documented payload length from the advisory: 100,000 digits followed by ';'. */
+  private static final int DOCUMENTED_DIGITS = 100000;
+
+  /** Separator-run length: quadratic EXTN_PATTERN backtracking takes seconds on the unpatched tree. */
+  private static final int SEPARATOR_RUN = 12000;
+
+  /** Comma-run length: each backtracking step is cheaper than for spaces, so the run is longer. */
+  private static final int COMMA_RUN = 32000;
+
+  /** A real extension suffix that {@code maybeStripExtension} strips from in-cap text. */
+  private static final String EXTENSION = " ext. 1234";
+
+  /** Returns {@code n} copies of {@code c} (Java 8 has no String.repeat). */
+  private static String repeat(char c, int n) {
+    StringBuilder sb = new StringBuilder(n);
+    for (int i = 0; i < n; i++) {
+      sb.append(c);
+    }
+    return sb.toString();
+  }
+
+  /** Pads {@code s} with trailing spaces to exactly {@code length} characters. */
+  private static String padTo(String s, int length) {
+    return s + repeat(' ', length - s.length());
+  }
+
+  /** The advisory's documented payload, verbatim: 100,000 digits followed by ';'. */
+  private static String documentedPayload() {
+    return repeat('1', DOCUMENTED_DIGITS) + ";";
+  }
+
+  /** "123" followed by a long space run and the ambiguous extension label 'x' with no digits. */
+  private static String separatorRunThenX() {
+    return "123" + repeat(' ', SEPARATOR_RUN) + "x";
+  }
+
+  /** Thrown by {@link HostileText} when its read budget is exceeded or the harness cancels it. */
+  private static final class ReadBudgetExceeded extends RuntimeException {
+    ReadBudgetExceeded(String message) {
+      super(message);
+    }
+  }
+
+  /**
+   * A caller-defined (non-JDK) {@link CharSequence} that counts every character the library reads
+   * from it ({@code charAt}, {@code subSequence}, {@code toString}) and aborts with
+   * {@link ReadBudgetExceeded} once a read budget is exceeded or the harness cancels it, so work done
+   * on it is both measurable and stoppable.
+   */
+  private static class HostileText implements CharSequence {
+    private final String text;
+    private final long readBudget;
+    private volatile boolean cancelled;
+    private long reads;
+
+    HostileText(String text, long readBudget) {
+      this.text = text;
+      this.readBudget = readBudget;
+    }
+
+    /** The full length of the underlying text. */
+    int fullLength() {
+      return text.length();
+    }
+
+    /** The character at {@code index} of the underlying text, without counting. */
+    char source(int index) {
+      return text.charAt(index);
+    }
+
+    private void count(long n) {
+      if (cancelled) {
+        throw new ReadBudgetExceeded("cancelled after " + reads + " reads");
+      }
+      reads += n;
+      if (reads > readBudget) {
+        throw new ReadBudgetExceeded(reads + " characters read, exceeding the budget of "
+            + readBudget + ", from a " + fullLength() + "-char input");
+      }
+    }
+
+    @Override
+    public int length() {
+      return fullLength();
+    }
+
+    @Override
+    public char charAt(int index) {
+      count(1);
+      return source(index);
+    }
+
+    @Override
+    public CharSequence subSequence(int start, int end) {
+      count(end - start);
+      StringBuilder sb = new StringBuilder(end - start);
+      for (int i = start; i < end; i++) {
+        sb.append(source(i));
+      }
+      return sb.toString();
+    }
+
+    @Override
+    public String toString() {
+      return subSequence(0, fullLength()).toString();
+    }
+
+    /** Number of characters read so far. */
+    long reads() {
+      return reads;
+    }
+
+    /** Makes every further read throw, stopping work abandoned after a timeout. */
+    void cancel() {
+      cancelled = true;
+    }
+  }
+
+  /**
+   * A {@link HostileText} that reports a huge {@code length()} ({@link Integer#MAX_VALUE}) without
+   * holding any text: every character is the digit '1'.
+   */
+  private static final class EndlessDigits extends HostileText {
+    EndlessDigits(long readBudget) {
+      super("", readBudget);
+    }
+
+    @Override
+    int fullLength() {
+      return Integer.MAX_VALUE;
+    }
+
+    @Override
+    char source(int index) {
+      return '1';
+    }
+  }
+
+  /**
+   * A {@link HostileText} whose {@code length()} is short the first time it is asked and the full
+   * length of the underlying text on every later call (a check-then-use / TOCTOU CharSequence).
+   */
+  private static final class LengthLyingText extends HostileText {
+    private final int firstLength;
+    private int lengthCalls;
+
+    LengthLyingText(String text, int firstLength, long readBudget) {
+      super(text, readBudget);
+      this.firstLength = firstLength;
+    }
+
+    @Override
+    public int length() {
+      return lengthCalls++ == 0 ? firstLength : fullLength();
+    }
+  }
+
+  /** Prints one line of evidence to the test log. */
+  private static void log(String line) {
+    System.out.println("[AlphaNumberRedosTest] " + line);
+  }
+
+  /** Records (and logs) one observed harmful effect. */
+  private static void harm(List<String> harms, String message) {
+    log("HARMFUL " + message);
+    harms.add(message);
+  }
+
+  /** FAILS the test listing every harmful effect recorded; passes when none was. */
+  private static void assertNoHarm(List<String> harms) {
+    if (!harms.isEmpty()) {
+      fail(harms.size() + " harmful effect(s) observed:\n" + String.join("\n", harms));
+    }
+  }
+
+  /** Short printable form of a call's result. */
+  private static String preview(Object result) {
+    String preview = String.valueOf(result);
+    if (preview.length() > 60) {
+      preview = preview.substring(0, 60) + "...(" + preview.length() + " chars)";
+    }
+    return preview;
+  }
+
+  /**
+   * Runs {@code call} on a dedicated daemon worker thread with the given stack size and returns its
+   * result. Exceeding {@link #TIME_BUDGET_MILLIS} (regex CPU exhaustion), escaping a
+   * {@link StackOverflowError} (unbounded recursion on the input) or making a {@link HostileText}
+   * exceed its read budget (over-cap / super-linear reading) is recorded as a harmful effect and
+   * {@code null} is returned. Any other exception means the sink was not driven cleanly and is
+   * surfaced as an error.
+   */
+  private static <T> T drive(List<String> harms, String label, int inputLength, long stackBytes,
+      HostileText cancellable, Callable<T> call) throws InterruptedException {
+    FutureTask<T> task = new FutureTask<T>(call);
+    Thread worker = new Thread(null, task, "redos-" + label, stackBytes);
+    worker.setDaemon(true);
+    long start = System.nanoTime();
+    worker.start();
+    try {
+      T result = task.get(TIME_BUDGET_MILLIS, TimeUnit.MILLISECONDS);
+      log(label + ": returned " + preview(result) + " in "
+          + TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - start) + " ms (input length "
+          + inputLength + ")");
+      return result;
+    } catch (TimeoutException timeout) {
+      if (cancellable != null) {
+        cancellable.cancel();
+      }
+      harm(harms, label + ": still running after " + TIME_BUDGET_MILLIS + " ms on a "
+          + inputLength + "-char input - the regex engine is backtracking over unbounded caller "
+          + "input (CWE-1333 ReDoS CPU exhaustion); expected an O(1) refusal of input longer than "
+          + "MAX_INPUT_STRING_LENGTH=" + CAP);
+      return null;
+    } catch (ExecutionException e) {
+      Throwable cause = e.getCause();
+      if (cause instanceof StackOverflowError) {
+        harm(harms, label + ": uncontrolled StackOverflowError escaped the library call on a "
+            + inputLength + "-char input at a " + (stackBytes >> 10) + " KiB thread stack - the "
+            + "regex recursed once per input character; expected a bounded refusal");
+        return null;
+      }
+      if (cause instanceof ReadBudgetExceeded) {
+        harm(harms, label + ": " + cause.getMessage() + " - over-cap caller input was fed to "
+            + "the regex engine / copied before any length cap was applied");
+        return null;
+      }
+      throw new AssertionError(label + ": unexpected exception driving the sink", cause);
+    }
+  }
+
+  /** Drives {@code isAlphaNumber} and records a harm unless the over-cap input is refused. */
+  private void assertAlphaNumberRefused(List<String> harms, String label, final CharSequence input,
+      int inputLength, long stackBytes) throws InterruptedException {
+    HostileText cancellable = input instanceof HostileText ? (HostileText) input : null;
+    Boolean result = drive(harms, label, inputLength, stackBytes, cancellable,
+        () -> phoneUtil.isAlphaNumber(input));
+    if (Boolean.TRUE.equals(result)) {
+      harm(harms, label + ": a " + inputLength + "-char input (> " + CAP + ") was evaluated by the "
+          + "regexes and ACCEPTED (true); it must be refused (false), as parse() refuses it");
+    }
+  }
+
+  /** Records a harm when a read-counting input was read beyond the cap. */
+  private static void assertReadsBounded(List<String> harms, String label, HostileText text,
+      int inputLength) {
+    if (text.reads() > CAP) {
+      harm(harms, label + ": " + text.reads() + " characters of a " + inputLength + "-char "
+          + "input were read; at most " + CAP + " may be read (the cap must be checked on "
+          + "length() before any copy or regex touches the characters)");
+    }
+  }
+
+  /**
+   * Drives {@code maybeStripExtension} on an over-cap buffer and records a harm unless it returns
+   * no extension and leaves the buffer exactly as it was.
+   */
+  private void assertStripExtensionRefused(List<String> harms, String label, String payload,
+      long stackBytes) throws InterruptedException {
+    final StringBuilder number = new StringBuilder(payload);
+    int before = harms.size();
+    String extension = drive(harms, label, payload.length(), stackBytes, null,
+        () -> phoneUtil.maybeStripExtension(number));
+    if (harms.size() != before) {
+      return;
+    }
+    if (!"".equals(extension) || !payload.equals(number.toString())) {
+      harm(harms, label + ": EXTN_PATTERN was evaluated on a " + payload.length() + "-char buffer"
+          + " (> " + CAP + "): returned extension \"" + extension + "\", buffer length "
+          + payload.length() + " -> " + number.length() + "; expected \"\" and the buffer unchanged");
+    }
+  }
+
+  /**
+   * Drives {@code formatOutOfCountryKeepingAlphaChars} and records a harm unless it returns a
+   * non-null result within the budget.
+   */
+  private void assertFormatKeepingAlphaCharsBounded(List<String> harms, String label,
+      final PhoneNumber number, final String regionCallingFrom, long stackBytes)
+      throws InterruptedException {
+    int before = harms.size();
+    String formatted = drive(harms, label, number.getRawInput().length(), stackBytes, null,
+        () -> phoneUtil.formatOutOfCountryKeepingAlphaChars(number, regionCallingFrom));
+    if (harms.size() == before && formatted == null) {
+      harm(harms, label + ": returned null; it must degrade to a non-null result");
+    }
+  }
+
+  // ---------------------------------------------------------------------------------------------
+  // Entry point: isAlphaNumber(CharSequence) -> isViablePhoneNumber / maybeStripExtension
+  // ---------------------------------------------------------------------------------------------
+
+  /**
+   * The documented payload verbatim (100,000 digits followed by ';'), delivered through a
+   * read-counting caller-defined CharSequence with a budget of 20 reads per character: on the
+   * unpatched tree the regex engine reads it super-linearly; a fixed tree refuses it after reading
+   * at most {@code CAP} characters (the cap is checked on {@code length()} before any copy or regex).
+   */
+  public void testIsAlphaNumberDocumentedHundredThousandDigitsPayload() throws Exception {
+    List<String> harms = new ArrayList<String>();
+    String payload = documentedPayload();
+    HostileText text = new HostileText(payload, 20L * payload.length());
+    String label = "isAlphaNumber(read-counting CharSequence: documented 100,000 digits + ';')";
+    assertAlphaNumberRefused(harms, label, text, payload.length(), LARGE_STACK_BYTES);
+    assertReadsBounded(harms, label, text, payload.length());
+    assertNoHarm(harms);
+  }
+
+  /**
+   * Long digit runs at the usual default thread stack, as String and StringBuilder, including the
+   * documented payload verbatim: the per-digit recursion of VALID_PHONE_NUMBER_PATTERN throws an
+   * uncontrolled StackOverflowError out of this boolean method on the unpatched tree.
+   */
+  public void testIsAlphaNumberStackOverflowShapesAtDefaultStack() throws Exception {
+    List<String> harms = new ArrayList<String>();
+    String digits = repeat('1', DOCUMENTED_DIGITS);
+    assertAlphaNumberRefused(harms, "isAlphaNumber(String: 100,000 digits)", digits,
+        digits.length(), DEFAULT_STACK_BYTES);
+    assertAlphaNumberRefused(harms, "isAlphaNumber(StringBuilder: 100,000 digits)",
+        new StringBuilder(digits), digits.length(), DEFAULT_STACK_BYTES);
+    String payload = documentedPayload();
+    assertAlphaNumberRefused(harms, "isAlphaNumber(String: documented 100,000 digits + ';')",
+        payload, payload.length(), DEFAULT_STACK_BYTES);
+    assertNoHarm(harms);
+  }
+
+  /**
+   * A valid vanity number padded with trailing spaces to {@code CAP + 1} characters, as String,
+   * StringBuilder and a caller-defined CharSequence: the unpatched tree evaluates it and returns
+   * true; it must be refused, exactly as parse() refuses it with TOO_LONG.
+   */
+  public void testIsAlphaNumberOverCapByOneRefused() throws Exception {
+    List<String> harms = new ArrayList<String>();
+    String overCap = padTo("1800 six-flags", CAP + 1);
+    assertEquals(CAP + 1, overCap.length());
+    assertAlphaNumberRefused(harms, "isAlphaNumber(String: vanity padded to 251)", overCap,
+        overCap.length(), DEFAULT_STACK_BYTES);
+    assertAlphaNumberRefused(harms, "isAlphaNumber(StringBuilder: vanity padded to 251)",
+        new StringBuilder(overCap), overCap.length(), DEFAULT_STACK_BYTES);
+    assertAlphaNumberRefused(harms, "isAlphaNumber(caller CharSequence: vanity padded to 251)",
+        new HostileText(overCap, Long.MAX_VALUE), overCap.length(), DEFAULT_STACK_BYTES);
+    assertNoHarm(harms);
+  }
+
+  /**
+   * "123" + 12,000 spaces + "x" (String): passes the first viability check, then EXTN_PATTERN
+   * backtracks quadratically over the space run in maybeStripExtension for several seconds on the
+   * unpatched tree.
+   */
+  public void testIsAlphaNumberSeparatorRunThenX() throws Exception {
+    List<String> harms = new ArrayList<String>();
+    String payload = separatorRunThenX();
+    assertAlphaNumberRefused(harms, "isAlphaNumber(String: \"123\"+12,000 spaces+\"x\")", payload,
+        payload.length(), LARGE_STACK_BYTES);
+    assertNoHarm(harms);
+  }
+
+  /**
+   * "123" + 32,000 commas + "a" (String): commas are admitted only by the optional extension tail
+   * of VALID_PHONE_NUMBER_PATTERN, so the quadratic backtracking happens in the first viability
+   * check, for several seconds on the unpatched tree.
+   */
+  public void testIsAlphaNumberCommaRunThenA() throws Exception {
+    List<String> harms = new ArrayList<String>();
+    String payload = "123" + repeat(',', COMMA_RUN) + "a";
+    assertAlphaNumberRefused(harms, "isAlphaNumber(String: \"123\"+32,000 commas+\"a\")", payload,
+        payload.length(), LARGE_STACK_BYTES);
+    assertNoHarm(harms);
+  }
+
+  /**
+   * The separator-run and comma-run shapes through a read-counting caller-defined CharSequence
