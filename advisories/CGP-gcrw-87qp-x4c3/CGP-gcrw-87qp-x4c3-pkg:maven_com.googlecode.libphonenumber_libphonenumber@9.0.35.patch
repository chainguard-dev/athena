+    String atCapWithExtension = padTo("1800 six-flags", CAP - EXTENSION.length()) + EXTENSION;
+    assertEquals(CAP, atCapWithExtension.length());
+    assertTrue(phoneUtil.isAlphaNumber(atCapWithExtension));
+    assertTrue(phoneUtil.isAlphaNumber(new StringBuilder(atCapWithExtension)));
+    assertTrue(phoneUtil.isAlphaNumber(new HostileText(atCapWithExtension, Long.MAX_VALUE)));
+  }
