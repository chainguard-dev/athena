+        DEFAULT_STACK_BYTES);
+    assertFormatKeepingAlphaCharsBounded(harms,
+        "formatOutOfCountryKeepingAlphaChars(setter rawInput: number+12,000 spaces+\"q\")",
+        numberWithRawInputViaSetter(separatorRunRawInput()), RegionCode.US, LARGE_STACK_BYTES);
+    assertNoHarm(harms);
+  }
