+  /** A GB number (no NANPA early return when formatted from US) carrying {@code rawInput}. */
+  private static PhoneNumber numberWithRawInputViaSetter(String rawInput) {
+    return new PhoneNumber().setCountryCode(44).setNationalNumber(2087654321L)
+        .setRawInput(rawInput);
+  }
+
+  /**
+   * The same number whose raw input arrives through a real Java serialization round trip, with
+   * the private fields written directly (no setter runs) - the delivery a crafted byte stream
+   * gives.
+   */
+  private static PhoneNumber numberWithRawInputViaDeserialization(String rawInput)
+      throws Exception {
+    PhoneNumber crafted = new PhoneNumber().setCountryCode(44).setNationalNumber(2087654321L);
+    setPrivateField(crafted, "rawInput_", rawInput);
+    setPrivateField(crafted, "hasRawInput", Boolean.TRUE);
+    ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+    ObjectOutputStream oos = new ObjectOutputStream(bytes);
+    try {
+      oos.writeObject(crafted);
+    } finally {
+      oos.close();
+    }
+    PhoneNumber deserialized;
+    ObjectInputStream ois = new ObjectInputStream(new ByteArrayInputStream(bytes.toByteArray()));
+    try {
+      deserialized = (PhoneNumber) ois.readObject();
+    } finally {
+      ois.close();
+    }
+    assertEquals("deserialized object lost its raw input", rawInput, deserialized.getRawInput());
+    return deserialized;
+  }
+
+  /** Writes a private field of {@code target} reflectively (stands in for a crafted stream). */
+  private static void setPrivateField(Object target, String name, Object value) throws Exception {
+    Field f = target.getClass().getDeclaredField(name);
+    f.setAccessible(true);
+    f.set(target, value);
+  }
