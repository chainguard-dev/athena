+  /** The existing isAlphaNumber verdicts, also via StringBuilder and a caller-defined CharSequence. */
+  public void testExistingIsAlphaNumberVerdictsPreserved() {
+    String[] accepted = {
+      "1800 six-flags", "1800 six-flags ext. 1234", "+800 six-flags", "180 six-flags",
+    };
+    String[] rejected = {
+      "1800 123-1234", "1 six-flags", "18 six-flags", "1800 123-1234 extension: 1234",
