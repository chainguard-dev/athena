+  /** At exactly the cap both helpers still process their input (250 accepted, not refused). */
+  public void testHelpersAtExactlyCapStillProcessed() {
+    assertTrue(PhoneNumberUtil.isViablePhoneNumber(repeat('1', CAP)));
+    assertTrue(PhoneNumberUtil.isViablePhoneNumber(padTo("1800 six-flags", CAP)));
+    String atCap = padTo("1800 six-flags", CAP - EXTENSION.length()) + EXTENSION;
+    assertEquals(CAP, atCap.length());
+    StringBuilder atCapNumber = new StringBuilder(atCap);
+    assertEquals("1234", phoneUtil.maybeStripExtension(atCapNumber));
+    assertEquals("1800 six-flags", atCapNumber.toString());
