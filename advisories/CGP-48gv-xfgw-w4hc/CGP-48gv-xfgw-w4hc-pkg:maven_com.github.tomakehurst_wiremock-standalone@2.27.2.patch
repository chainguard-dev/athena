+package com.github.tomakehurst.wiremock.admin;
+
+import com.github.tomakehurst.wiremock.admin.model.PathParams;
+import com.github.tomakehurst.wiremock.admin.tasks.DeleteStubFileTask;
+import com.github.tomakehurst.wiremock.common.FileSource;
+import com.github.tomakehurst.wiremock.common.SingleRootFileSource;
+import com.github.tomakehurst.wiremock.core.Admin;
+import com.github.tomakehurst.wiremock.core.Options;
+import com.github.tomakehurst.wiremock.http.Request;
+import com.github.tomakehurst.wiremock.http.ResponseDefinition;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+import static java.net.HttpURLConnection.HTTP_INTERNAL_ERROR;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.hamcrest.Matchers.not;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Path-traversal deletion tests for DELETE /__admin/files/{filename} (CWE-22 / CWE-73).
+ *
+ * <p>The sink is DeleteStubFileTask.execute(Admin,Request,PathParams): the raw {filename} segment is
+ * turned into a file under the __files root and deleted. It used to do
+ * {@code new File(fileSource.getPath(), filename).delete()} with no canonicalisation and no
+ * root-containment check, so a traversal, sibling-collision or symlink {filename} value deleted a
+ * file or directory outside the configured __files root. The delete now goes through
+ * FileSource.deleteFile() -&gt; AbstractFileSource.deleteFile() -&gt; assertFilePathIsUnderRoot(), an
+ * OS-native {@code getCanonicalPath()}-based containment check.
+ *
+ * <p>Every test drives the real sink through a mocked Admin/Options whose filesRoot() returns a real
+ * SingleRootFileSource rooted at a temp dir and asserts that the out-of-root target still exists
+ * after the call and that the sink returned the rejection response (never HTTP 200, never an uncaught
+ * exception). Beyond the plain traversal payloads it covers Windows backslash, drive-letter and UNC
+ * {filename} values, and a platform-independent check that the sink relies on OS-native canonical
+ * path resolution (a symlinked directory component that escapes the root under
+ * {@code getCanonicalPath()} but looks contained under a normalize()-only check).
+ */
+public class DeleteStubFileTaskPathTraversalTest {
+
+    @Rule
+    public TemporaryFolder temp = new TemporaryFolder();
+
+    private DeleteStubFileTask task;
+    private Admin admin;
+    private Request request;
+
+    private File filesRootDir;   // <root>            (what Options.filesRoot() points at)
+    private File filesDir;       // <root>/__files    (the SingleRootFileSource the sink resolves)
+
+    @Before
+    public void setUp() throws Exception {
+        task = new DeleteStubFileTask();
+        request = mock(Request.class);
+
+        // The configured files root, and the __files subdir the task's sink resolves to via
+        // filesRoot().child(FILES_ROOT). Both must exist on disk.
+        filesRootDir = temp.newFolder("filesRoot");
+        filesDir = new File(filesRootDir, "__files");
+        assertTrue(filesDir.mkdirs());
+
+        // A real FileSource pointed at the files root; Options.filesRoot() returns it, and the sink
+        // does filesRoot().child("__files") on it, yielding <root>/__files as the intended base.
+        FileSource filesRoot = new SingleRootFileSource(filesRootDir);
+
+        Options options = mock(Options.class);
+        when(options.filesRoot()).thenReturn(filesRoot);
+        admin = mock(Admin.class);
+        when(admin.getOptions()).thenReturn(options);
+    }
+
+    /**
+     * Drive the exact sink with {@code filenameParam} and assert the secure rejection response: a
+     * blocked deletion is reported as the existing "File not deleted" (HTTP 500) failure response,
+     * never success and never an uncaught crash. This is a specific bound (HTTP_INTERNAL_ERROR), not
+     * a catch-all; the primary security oracle is the out-of-root-survival assertion in each caller.
+     */
+    private void assertAttackRejected(String filenameParam) {
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", filenameParam));
+        assertThat("SECURITY: a blocked delete must return the rejection response, not success",
+                response.getStatus(), is(HTTP_INTERNAL_ERROR));
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Traversal payloads.
+    // ---------------------------------------------------------------------------------------------
+
+    /**
+     * "../important-file.txt": the victim lives directly under the files root, one level above
+     * __files, and is reached by a forward-slash traversal.
+     */
+    @Test
+    public void dotDotSlashFileIsNotDeletedOutsideFilesRoot() throws Exception {
+        File victim = new File(filesRootDir, "important-file.txt");
+        writeMarker(victim);
+        assertTrue("precondition: victim exists before attack", victim.exists());
+
+        assertAttackRejected("../important-file.txt");
+
+        assertThat("SECURITY: '../important-file.txt' must NOT delete a file outside __files",
+                victim.exists(), is(true));
+    }
+
+    /**
+     * "../victimDir": an empty directory outside __files, reachable as "__files/../victimDir".
+     * File.delete() removes an empty directory, so without containment it would be destroyed.
+     */
+    @Test
+    public void dotDotSlashDirectoryIsNotDeletedOutsideFilesRoot() throws Exception {
+        File victimDir = new File(filesRootDir, "victimDir");
+        assertTrue(victimDir.mkdir());
+        assertTrue("precondition: victim dir exists before attack", victimDir.exists());
+
+        assertAttackRejected("../victimDir");
+
+        assertThat("SECURITY: '../victimDir' must NOT delete a directory outside __files",
+                victimDir.exists(), is(true));
+    }
+
+    /**
+     * "../__filesEVIL/marker.txt": sibling-directory-name collision. The target's canonical path
+     * string-starts-with the __files canonical path, so a containment check whose startsWith lacks
+     * the File.separator suffix would let it through.
+     */
+    @Test
+    public void siblingDirectoryPrefixCollisionFileIsNotDeletedOutsideFilesRoot() throws Exception {
+        File evilSibling = new File(filesRootDir, "__filesEVIL");
+        assertTrue(evilSibling.mkdirs());
+        File victim = new File(evilSibling, "marker.txt");
+        writeMarker(victim);
+        assertTrue("precondition: sibling-collision victim exists before attack", victim.exists());
+
+        assertAttackRejected("../__filesEVIL/marker.txt");
+
+        assertThat("SECURITY: '../__filesEVIL/marker.txt' must NOT delete a file outside __files",
+                victim.exists(), is(true));
+    }
+
+    /**
+     * "" (empty string): new File(<...>/__files, "") canonically resolves to the
+     * __files root directory itself, and the raw File handed to .delete() is byte-identical to the
+     * root dir (no trailing "/." the OS would refuse), so an empty {filename} DELETES THE __files
+     * ROOT DIRECTORY ITSELF when it is currently empty (fresh instance / all files already removed) --
+     * strictly worse than a single-file escape.
+     */
+    @Test
+    public void emptyFilenameDoesNotDeleteFilesRootDirectoryItself() throws Exception {
+        assertTrue("precondition: __files root exists before attack", filesDir.exists());
+        assertTrue("precondition: __files root is a directory", filesDir.isDirectory());
+        assertThat("precondition: __files root is currently empty (fresh instance / all files removed)",
+                filesDir.list().length, is(0));
+
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", ""));
+
+        assertThat("SECURITY: an empty {filename} must NOT delete the __files root directory itself",
+                filesDir.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for destroying the root",
+                response.getStatus(), is(not(200)));
+    }
+
+    /**
+     * "..\..\..\Windows\win.ini": the Windows backslash traversal.
+     *
+     * <p>On a Windows JVM java.io.File treats '\' as a separator and this escapes __files; on the
+     * Linux test host '\' is an ordinary filename character, so this value CANNOT by itself reach a
+     * file outside __files here (it names a single in-root file whose name contains backslashes). We
+     * therefore drive the exact payload through the sink and assert the two things that DO hold
+     * platform-independently: no pre-existing out-of-root file with the corresponding Windows target
+     * name is removed, and the sink never reports success for it. The genuinely platform-INDEPENDENT
+     * proof that the sink relies on OS-native canonicalisation (which is what defends this payload on
+     * Windows) is {@link #osNativeCanonicalisationSymlinkEscapeIsBlocked()} below.
+     */
+    @Test
+    public void windowsBackslashTraversalPayloadDeletesNothingOutsideFilesRoot() throws Exception {
+        // A would-be victim one level above __files, named as the last segment of the Windows payload.
+        File victim = new File(filesRootDir, "win.ini");
+        writeMarker(victim);
+        assertTrue("precondition: out-of-root victim exists before attack", victim.exists());
+
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", "..\\..\\..\\Windows\\win.ini"));
+
+        assertThat("SECURITY: the Windows backslash payload must not delete a file outside __files",
+                victim.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for the Windows backslash payload",
+                response.getStatus(), is(not(200)));
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Absolute Windows-drive / UNC {filename}.
+    // ---------------------------------------------------------------------------------------------
+
+    /**
+     * An absolute Windows drive path as {filename}.
+     * On a Windows JVM "C:\Windows\win.ini" is absolute and, via the containment check's
+     * absolute-branch canonicalisation, must be rejected as outside root. Platform-independently on
+     * a Linux host it names an in-root path segment; we assert no out-of-root file is removed and the
+     * sink does not report success.
+     */
+    @Test
+    public void windowsDriveAbsolutePayloadDeletesNothingOutsideFilesRoot() throws Exception {
+        File victim = new File(filesRootDir, "win.ini");
+        writeMarker(victim);
+        assertTrue("precondition: out-of-root victim exists before attack", victim.exists());
+
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", "C:\\Windows\\win.ini"));
+
+        assertThat("SECURITY: a Windows drive-absolute {filename} must not delete a file outside __files",
+                victim.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for a Windows drive-absolute {filename}",
+                response.getStatus(), is(not(200)));
+    }
+
+    /**
+     * A Windows UNC share path as {filename}. On a
+     * Windows JVM "\\host\share\file" targets a remote share outside any local root and must be
+     * rejected. Platform-independently on a Linux host it names an in-root path segment; we assert no
+     * out-of-root file is removed and the sink does not report success.
+     */
+    @Test
+    public void windowsUncPayloadDeletesNothingOutsideFilesRoot() throws Exception {
+        File victim = new File(filesRootDir, "file");
+        writeMarker(victim);
+        assertTrue("precondition: out-of-root victim exists before attack", victim.exists());
+
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", "\\\\host\\share\\file"));
+
+        assertThat("SECURITY: a Windows UNC {filename} must not delete a file outside __files",
+                victim.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for a Windows UNC {filename}",
+                response.getStatus(), is(not(200)));
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Platform-independent check of OS-native canonicalisation.
+    // ---------------------------------------------------------------------------------------------
+
+    /**
+     * Platform-independent check: the sink must defend via genuine OS-native
+     * canonical-path resolution, the same mechanism that resolves Windows backslashes on a Windows
+     * JVM -- NOT a forward-slash-only or normalize()-only string check.
+     *
+     * <p>Construction: a directory OUTSIDE __files containing a real victim file, and a SYMLINK named
+     * "escape" INSIDE __files that points at that outside directory. The {filename} value
+     * "escape/victim.txt" therefore:
+     * <ul>
+     *   <li>under {@code getCanonicalPath()} / {@code toRealPath()} (OS-native) resolves to the real
+     *       file OUTSIDE __files -&gt; a correct containment check REJECTS it;</li>
+     *   <li>under {@code Path.normalize()} or a manual "does it contain ../" style string check
+     *       resolves to a path that still string-starts-with __files -&gt; such a weak check ACCEPTS
+     *       it (bypass).</li>
+     * </ul>
+     * Without containment the sink follows the symlinked directory and deletes the real outside
+     * file; a check that used normalize() or forward-slash-only string matching would do the same.
+     * Fails loudly if the host cannot create symlinks rather than silently passing.
+     */
+    @Test
+    public void osNativeCanonicalisationSymlinkEscapeIsBlocked() throws Exception {
+        // A real victim file in a directory that lives OUTSIDE __files.
+        File outsideDir = new File(filesRootDir, "outsideDir");
+        assertTrue(outsideDir.mkdirs());
+        File victim = new File(outsideDir, "victim.txt");
+        writeMarker(victim);
+        assertTrue("precondition: out-of-root victim exists before attack", victim.exists());
+
+        // A symlink INSIDE __files pointing at the outside directory. If the platform cannot create
+        // symlinks, fail loudly rather than silently passing (org.junit.Assume would hide the gap).
+        Path link = new File(filesDir, "escape").toPath();
+        Path target = outsideDir.toPath();
+        try {
+            Files.createSymbolicLink(link, target);
+        } catch (UnsupportedOperationException | java.io.IOException e) {
+            throw new IllegalStateException(
+                    "OS-native canonicalisation proof requires symlink support on the test host", e);
+        }
+        assertTrue("precondition: symlink inside __files was created", Files.isSymbolicLink(link));
+
+        // Sanity: a normalize()-only view WOULD consider this contained -- the exact weak check this
+        // test exists to defeat. (Not the security oracle, just documents the discriminator.)
+        assertTrue("discriminator: normalize()-only view treats the symlink path as in-root",
+                Paths.get(filesDir.getPath(), "escape", "victim.txt").normalize()
+                        .startsWith(Paths.get(filesDir.getPath())));
+
+        assertAttackRejected("escape/victim.txt");
+
+        assertThat("SECURITY: an OS-native symlink escape must NOT delete a file outside __files",
+                victim.exists(), is(true));
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Legitimate deletes keep working.
+    // ---------------------------------------------------------------------------------------------
+
+    /**
+     * A legitimate single-segment in-root filename must still be deleted and return
+     * the success (HTTP 200) response. Catches an over-tight containment fix.
+     */
+    @Test
+    public void legitimateTopLevelInRootFileIsStillDeleted() throws Exception {
+        File legit = new File(filesDir, "response-body.json");
+        writeMarker(legit);
+        assertTrue("precondition: legit in-root file exists before delete", legit.exists());
+
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", "response-body.json"));
+
+        assertThat("PRESERVATION: a legitimate top-level in-root file must still be deleted",
+                legit.exists(), is(false));
+        assertThat("PRESERVATION: a legitimate delete must still return the success response (HTTP 200)",
+                response.getStatus(), is(200));
+    }
+
+    /**
+     * A legitimate filename inside a legitimately-created SUBDIRECTORY of __files
+     * (a multi-segment relative path under root) must still be deletable and return HTTP 200. A fix
+     * that rejects any {filename} containing a separator would be over-broad and fail this.
+     */
+    @Test
+    public void legitimateNestedSubdirectoryInRootFileIsStillDeleted() throws Exception {
+        File subdir = new File(filesDir, "subdir");
+        assertTrue(subdir.mkdirs());
+        File legit = new File(subdir, "response.json");
+        writeMarker(legit);
+        assertTrue("precondition: legit nested in-root file exists before delete", legit.exists());
+
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", "subdir/response.json"));
+
+        assertThat("PRESERVATION: a legitimate nested-subdirectory in-root file must still be deleted",
+                legit.exists(), is(false));
+        assertThat("PRESERVATION: a legitimate nested delete must still return the success response (HTTP 200)",
+                response.getStatus(), is(200));
+    }
+
+    private static void writeMarker(File f) throws Exception {
+        File parent = f.getParentFile();
+        if (parent != null && !parent.exists()) {
+            assertTrue(parent.mkdirs());
+        }
+        com.google.common.io.Files.write("marker".getBytes("UTF-8"), f);
+    }
+}
