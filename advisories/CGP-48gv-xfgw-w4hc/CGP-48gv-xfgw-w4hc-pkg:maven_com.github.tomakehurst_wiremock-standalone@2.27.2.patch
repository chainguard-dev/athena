+package com.github.tomakehurst.wiremock.admin;
+
+import com.github.tomakehurst.wiremock.admin.model.PathParams;
+import com.github.tomakehurst.wiremock.admin.tasks.DeleteStubFileTask;
+import com.github.tomakehurst.wiremock.common.FileSource;
+import com.github.tomakehurst.wiremock.common.SingleRootFileSource;
+import com.github.tomakehurst.wiremock.core.Admin;
+import com.github.tomakehurst.wiremock.core.Options;
+import com.github.tomakehurst.wiremock.http.Request;
+import com.github.tomakehurst.wiremock.http.ResponseDefinition;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Edge-case {filename} values for DeleteStubFileTask that are not covered by
+ * DeleteStubFileTaskPathTraversalTest: bare "." and ".." single-segment values reachable via the
+ * router's trailing-slash-collapse behaviour, an embedded-separator multi-segment traversal that
+ * combines a legitimate-looking subdirectory prefix with an escaping "..", a NUL-byte injection, and
+ * a genuinely absolute path. Each asserts that the target survives and the sink does not report
+ * success.
+ */
+public class DeleteStubFileTaskEdgeCaseTest {
+
+    @Rule
+    public TemporaryFolder temp = new TemporaryFolder();
+
+    private DeleteStubFileTask task;
+    private Admin admin;
+    private Request request;
+
+    private File filesRootDir;
+    private File filesDir;
+
+    @Before
+    public void setUp() throws Exception {
+        task = new DeleteStubFileTask();
+        request = mock(Request.class);
+
+        filesRootDir = temp.newFolder("filesRoot");
+        filesDir = new File(filesRootDir, "__files");
+        assertTrue(filesDir.mkdirs());
+
+        FileSource filesRoot = new SingleRootFileSource(filesRootDir);
+
+        Options options = mock(Options.class);
+        when(options.filesRoot()).thenReturn(filesRoot);
+        admin = mock(Admin.class);
+        when(admin.getOptions()).thenReturn(options);
+    }
+
+    private static void writeMarker(File f) throws Exception {
+        File parent = f.getParentFile();
+        if (parent != null && !parent.exists()) {
+            assertTrue(parent.mkdirs());
+        }
+        com.google.common.io.Files.write("marker".getBytes("UTF-8"), f);
+    }
+
+    /**
+     * A bare "." {filename}. Reachable via the real HTTP endpoint through the router's
+     * trailing-slash-collapse (DELETE /__admin/files/./ splits to the same part count as
+     * DELETE /__admin/files/{filename}, with the segment "."). "." canonically resolves to EXACTLY
+     * the __files root -- must be blocked the same way the empty-string case is (deleteFile()'s
+     * explicit root-equality guard), not merely by accident.
+     */
+    @Test
+    public void bareDotFilenameDoesNotDeleteFilesRootDirectoryItself() throws Exception {
+        assertTrue("precondition: __files root exists before attack", filesDir.exists());
+        assertThat("precondition: __files root is currently empty", filesDir.list().length, is(0));
+
+        ResponseDefinition response = task.execute(admin, request, PathParams.single("filename", "."));
+
+        assertThat("SECURITY: a bare '.' {filename} must NOT delete the __files root directory itself",
+                filesDir.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for destroying the root via '.'",
+                response.getStatus(), is(not200()));
+    }
+
+    /**
+     * A bare ".." {filename} (no slash) -- reachable via the router's trailing-slash
+     * collapse (DELETE /__admin/files/../ splits to the segment ".."). Canonically resolves to the
+     * PARENT of __files (filesRootDir itself), which does not equal and is not prefixed by rootPath,
+     * so it must be rejected by the same containment check as the "../victimDir" documented payload.
+     */
+    @Test
+    public void bareDotDotFilenameDoesNotDeleteParentDirectory() throws Exception {
+        assertTrue("precondition: parent (filesRootDir) exists before attack", filesRootDir.exists());
+
+        ResponseDefinition response = task.execute(admin, request, PathParams.single("filename", ".."));
+
+        assertThat("SECURITY: a bare '..' {filename} must NOT delete/affect the parent of __files",
+                filesRootDir.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for a bare '..' {filename}",
+                response.getStatus(), is(not200()));
+    }
+
+    /**
+     * An embedded-separator multi-segment value that combines a legitimate-looking
+     * subdirectory prefix with a traversal back out past the root ("subdir/../../important-file.txt").
+     * The containment check must accept legitimate nested relative paths while still rejecting a
+     * multi-segment value that nets out above root. A fix that only checks "does the FIRST segment
+     * start with .." (rather than canonicalising the whole joined path) would miss this.
+     */
+    @Test
+    public void embeddedSeparatorTraversalViaLegitimateLookingSubdirIsBlocked() throws Exception {
+        File subdir = new File(filesDir, "subdir");
+        assertTrue(subdir.mkdirs());
+        File victim = new File(filesRootDir, "important-file.txt");
+        writeMarker(victim);
+        assertTrue("precondition: out-of-root victim exists before attack", victim.exists());
+
+        ResponseDefinition response = task.execute(
+                admin, request, PathParams.single("filename", "subdir/../../important-file.txt"));
+
+        assertThat("SECURITY: 'subdir/../../important-file.txt' must NOT delete a file outside __files",
+                victim.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for the embedded-separator traversal",
+                response.getStatus(), is(not200()));
+    }
+
+    /**
+     * The same embedded-separator class, but netting out to the sibling-prefix-collision
+     * directory ("subdir/../../__filesEVIL/marker.txt") rather than a plain parent-relative file --
+     * combines two evasion classes (legitimate subdir prefix + sibling collision) in one payload.
+     */
+    @Test
+    public void embeddedSeparatorTraversalToSiblingPrefixCollisionIsBlocked() throws Exception {
+        File subdir = new File(filesDir, "subdir");
+        assertTrue(subdir.mkdirs());
+        File evilSibling = new File(filesRootDir, "__filesEVIL");
+        assertTrue(evilSibling.mkdirs());
+        File victim = new File(evilSibling, "marker.txt");
+        writeMarker(victim);
+        assertTrue("precondition: sibling-collision victim exists before attack", victim.exists());
+
+        ResponseDefinition response = task.execute(
+                admin, request, PathParams.single("filename", "subdir/../../__filesEVIL/marker.txt"));
+
+        assertThat("SECURITY: embedded-separator sibling-collision traversal must NOT delete the victim",
+                victim.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for the embedded sibling-collision traversal",
+                response.getStatus(), is(not200()));
+    }
+
+    /**
+     * A NUL byte embedded in an otherwise-traversing {filename}
+     * ("important-file.txt\0/../../important-file.txt"). Tests whether a native/NUL-truncation
+     * discrepancy between what Java's canonicalisation validates and what any lower layer would act
+     * on could let a truncated form slip past the check. Java's File/NIO layer is expected to reject
+     * embedded NULs (fail closed) rather than silently truncate.
+     */
+    @Test
+    public void nulByteEmbeddedInFilenameDoesNotBypassContainment() throws Exception {
+        File victim = new File(filesRootDir, "important-file.txt");
+        writeMarker(victim);
+        assertTrue("precondition: out-of-root victim exists before attack", victim.exists());
+
+        String payload = "safe\u0000/../../important-file.txt";
+        ResponseDefinition response;
+        try {
+            response = task.execute(admin, request, PathParams.single("filename", payload));
+        } catch (RuntimeException e) {
+            // DeleteStubFileTask.execute() catches RuntimeException, so an exception here means the
+            // payload crashed the task instead of being rejected.
+            throw new AssertionError("NUL-byte payload escaped DeleteStubFileTask's catch(RuntimeException): " + e, e);
+        }
+
+        assertThat("SECURITY: a NUL-byte-embedded traversal must NOT delete a file outside __files",
+                victim.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for the NUL-byte-embedded traversal",
+                response.getStatus(), is(not200()));
+    }
+
+    /**
+     * A genuinely absolute path on a Unix JVM, which takes the {@code File.isAbsolute()} branch of
+     * assertFilePathIsUnderRoot(). The Windows drive and UNC payloads in
+     * DeleteStubFileTaskPathTraversalTest are not absolute to java.io.File on Unix, so they do not
+     * reach that branch there. The victim is a real file in the temp folder, outside __files, and must
+     * survive.
+     */
+    @Test
+    public void genuineAbsoluteUnixPathIsBlockedByIsAbsoluteBranch() throws Exception {
+        File absoluteVictim = temp.newFile("absolute-victim.txt");
+        writeMarker(absoluteVictim);
+        assertTrue("precondition: absolute victim exists before attack", absoluteVictim.exists());
+        String absolutePath = absoluteVictim.getAbsolutePath();
+        assertTrue("precondition: payload is genuinely isAbsolute() on this JVM",
+                new File(absolutePath).isAbsolute());
+
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", absolutePath));
+
+        assertThat("SECURITY: a genuinely absolute {filename} must NOT delete the target file",
+                absoluteVictim.exists(), is(true));
+        assertThat("SECURITY: the sink must not report success for a genuinely absolute {filename}",
+                response.getStatus(), is(not200()));
+    }
+
+    private static org.hamcrest.Matcher<Integer> not200() {
+        return org.hamcrest.Matchers.not(200);
+    }
+}
