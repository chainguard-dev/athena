+package com.github.tomakehurst.wiremock.admin;
+
+import com.github.tomakehurst.wiremock.admin.model.PathParams;
+import com.github.tomakehurst.wiremock.admin.tasks.DeleteStubFileTask;
+import com.github.tomakehurst.wiremock.common.FileSource;
+import com.github.tomakehurst.wiremock.common.SingleRootFileSource;
+import com.github.tomakehurst.wiremock.core.Admin;
+import com.github.tomakehurst.wiremock.core.Options;
+import com.github.tomakehurst.wiremock.http.Request;
+import com.github.tomakehurst.wiremock.http.ResponseDefinition;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+
+import static java.net.HttpURLConnection.HTTP_INTERNAL_ERROR;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Regression tests for path traversal in DeleteStubFileTask (CWE-22 / CWE-73):
+ * DeleteStubFileTask.execute() built a File straight from the {filename} path parameter and called
+ * .delete() with no path-containment check, so a traversal or sibling-collision value deleted files
+ * outside the __files root.
+ *
+ * The delete now goes through FileSource.deleteFile(), which enforces path containment via
+ * AbstractFileSource.assertFilePathIsUnderRoot (a canonical-path check anchored to the __files root).
+ * A blocked attempt returns the existing "File not deleted" (HTTP 500) failure response and deletes
+ * nothing outside the root.
+ *
+ * These tests drive the real sink (DeleteStubFileTask.execute(Admin,Request,PathParams)) through a
+ * mocked Admin/Options whose filesRoot() returns a real SingleRootFileSource rooted at a temp dir.
+ * Each attack test asserts that the file outside __files still exists after the call and that the
+ * sink returned the rejection response (never success, never an uncaught exception).
+ */
+public class DeleteStubFileTaskTest {
+
+    @Rule
+    public TemporaryFolder temp = new TemporaryFolder();
+
+    private DeleteStubFileTask task;
+    private Admin admin;
+    private Request request;
+
+    private File filesRootDir;   // <root>            (what Options.filesRoot() points at)
+    private File filesDir;       // <root>/__files    (the SingleRootFileSource the sink resolves)
+
+    @Before
+    public void setUp() throws Exception {
+        task = new DeleteStubFileTask();
+        request = mock(Request.class);
+
+        // The configured files root, and the __files subdir the task's sink resolves to via
+        // filesRoot().child(FILES_ROOT). Both must exist on disk.
+        filesRootDir = temp.newFolder("filesRoot");
+        filesDir = new File(filesRootDir, "__files");
+        assertTrue(filesDir.mkdirs());
+
+        // A real FileSource pointed at the files root; Options.filesRoot() returns it, and the sink
+        // does filesRoot().child("__files") on it, yielding <root>/__files as the intended base.
+        FileSource filesRoot = new SingleRootFileSource(filesRootDir);
+
+        Options options = mock(Options.class);
+        when(options.filesRoot()).thenReturn(filesRoot);
+        admin = mock(Admin.class);
+        when(admin.getOptions()).thenReturn(options);
+    }
+
+    /**
+     * Drive the sink and assert the rejection response for a blocked attempt: a blocked traversal is
+     * reported as the existing "File not deleted" (HTTP 500) failure response, not success and not an
+     * uncaught exception. The primary check is still the file-survival assertion in each test below.
+     */
+    private void assertAttackRejected(String filenameParam) {
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", filenameParam));
+        assertThat("SECURITY: a blocked traversal must return the rejection response, not success",
+                response.getStatus(), is(HTTP_INTERNAL_ERROR));
+    }
+
+    /**
+     * A value reaching the sink containing a literal "../" separator (for example the decoded form of
+     * "..%2Fimportant-file.txt"). The victim lives directly under the files root, one level above
+     * __files.
+     */
+    @Test
+    public void traversalWithSeparatorDoesNotDeleteFileOutsideFilesRoot() throws Exception {
+        File victim = new File(filesRootDir, "important-file.txt");
+        writeMarker(victim);
+        assertTrue("precondition: victim exists before attack", victim.exists());
+
+        // Decoded form of "..%2Fimportant-file.txt".
+        assertAttackRejected("../important-file.txt");
+
+        assertThat("SECURITY: a ../ traversal value must NOT delete a file outside __files",
+                victim.exists(), is(true));
+    }
+
+    /**
+     * A single "../" traversal to a directory. new File(<...>/__files, "../victimDir") resolves to an
+     * empty directory next to __files; File.delete() removes an empty directory, so without the
+     * containment check the directory outside __files would be deleted.
+     */
+    @Test
+    public void bareDotDotSegmentDoesNotDeleteDirectoryOutsideFilesRoot() throws Exception {
+        // An empty directory that sits OUTSIDE __files, reachable as "__files/../victimDir".
+        File victimDir = new File(filesRootDir, "victimDir");
+        assertTrue(victimDir.mkdir());
+        assertTrue("precondition: victim dir exists before attack", victimDir.exists());
+
+        // "../victimDir" is a bare single per-segment traversal (no encoding, no platform quirk).
+        assertAttackRejected("../victimDir");
+
+        assertThat("SECURITY: a traversal value must NOT delete a directory outside __files",
+                victimDir.exists(), is(true));
+    }
+
+    /*
+     * A purely absolute {filename} is not exercised here: the task builds its probe File with
+     * new File(String parent, String child), which appends an absolute child as a relative segment,
+     * so such a value names a path inside __files. Absolute values that escape are covered by
+     * DeleteStubFileTaskEdgeCaseTest.
+     */
+
+    /**
+     * Sibling-directory-name collision: a target under a sibling directory whose name has the __files
+     * root's canonical path as a bare string prefix (e.g. "<root>/__filesEVIL/..."), reached from
+     * __files as "../__filesEVIL/marker.txt". Routing through the containment check only helps if
+     * that check anchors its prefix match on a path separator.
+     */
+    @Test
+    public void siblingDirectoryPrefixCollisionDoesNotDeleteFileOutsideFilesRoot() throws Exception {
+        // <root>/__filesEVIL/marker.txt : canonical path string-starts-with <root>/__files
+        File evilSibling = new File(filesRootDir, "__filesEVIL");
+        assertTrue(evilSibling.mkdirs());
+        File victim = new File(evilSibling, "marker.txt");
+        writeMarker(victim);
+        assertTrue("precondition: sibling-collision victim exists before attack", victim.exists());
+
+        assertAttackRejected("../__filesEVIL/marker.txt");
+
+        assertThat("SECURITY: a sibling-dir-name-prefix value must NOT delete a file outside __files",
+                victim.exists(), is(true));
+    }
+
+    /**
+     * A legitimate single-segment in-root filename must still be deleted and return the success
+     * (HTTP 200) response.
+     */
+    @Test
+    public void legitimateInRootFileIsStillDeleted() throws Exception {
+        File legit = new File(filesDir, "response-body.json");
+        writeMarker(legit);
+        assertTrue("precondition: legit in-root file exists before delete", legit.exists());
+
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", "response-body.json"));
+
+        assertThat("PRESERVATION: a legitimate in-root file must still be deleted",
+                legit.exists(), is(false));
+        assertThat("PRESERVATION: a legitimate delete must still return the success response (HTTP 200)",
+                response.getStatus(), is(200));
+    }
+
+    /**
+     * A legitimate, in-root filename that does NOT exist on disk must still
+     * produce the existing "File not deleted" (HTTP 500) failure response -- a legitimate miss must not
+     * crash and must not be conflated (differently) with a security rejection.
+     */
+    @Test
+    public void legitimateInRootMissStillReturnsFailureResponse() throws Exception {
+        File absent = new File(filesDir, "does-not-exist.json");
+        assertThat("precondition: file is absent", absent.exists(), is(false));
+
+        ResponseDefinition response =
+                task.execute(admin, request, PathParams.single("filename", "does-not-exist.json"));
+
+        assertThat("PRESERVATION: a legitimate in-root miss must return the failure response (HTTP 500)",
+                response.getStatus(), is(HTTP_INTERNAL_ERROR));
+    }
+
+    private static void writeMarker(File f) throws Exception {
+        File parent = f.getParentFile();
+        if (parent != null && !parent.exists()) {
+            assertTrue(parent.mkdirs());
+        }
+        com.google.common.io.Files.write("marker".getBytes("UTF-8"), f);
+    }
+}
