diff --git a/src/main/java/com/github/tomakehurst/wiremock/admin/tasks/DeleteStubFileTask.java b/src/main/java/com/github/tomakehurst/wiremock/admin/tasks/DeleteStubFileTask.java
index a98d0e4f..0d8d1f83 100644
--- a/src/main/java/com/github/tomakehurst/wiremock/admin/tasks/DeleteStubFileTask.java
+++ b/src/main/java/com/github/tomakehurst/wiremock/admin/tasks/DeleteStubFileTask.java
@@ -31,11 +31,24 @@ public class DeleteStubFileTask implements AdminTask {
     @Override
     public ResponseDefinition execute(Admin admin, Request request, PathParams pathParams) {
         FileSource fileSource = admin.getOptions().filesRoot().child(FILES_ROOT);
-        File filename = new File(fileSource.getPath(), pathParams.get("filename"));
-        boolean deleted = filename.delete();
-        if (deleted) {
-            return ResponseDefinition.ok();
-        } else {
+        String filenameParam = pathParams.get("filename");
+        try {
+            // Delete through FileSource.deleteFile, which enforces path containment via
+            // AbstractFileSource.assertFilePathIsUnderRoot (canonical-path check anchored to the
+            // __files root), so a traversal {filename} value cannot delete a file outside the root
+            // (CWE-22 / CWE-73). Deleting the raw File directly would skip that check.
+            File filename = new File(fileSource.getPath(), filenameParam);
+            boolean existedBefore = filename.exists();
+            fileSource.deleteFile(filenameParam);
+            boolean deleted = existedBefore && !filename.exists();
+            if (deleted) {
+                return ResponseDefinition.ok();
+            } else {
+                return new ResponseDefinition(HTTP_INTERNAL_ERROR, "File not deleted");
+            }
+        } catch (RuntimeException e) {
+            // A blocked traversal (NotAuthorisedException) or any resolution failure is reported as
+            // a failed delete rather than crashing the admin request; nothing outside root is removed.
             return new ResponseDefinition(HTTP_INTERNAL_ERROR, "File not deleted");
         }
     }
diff --git a/src/main/java/com/github/tomakehurst/wiremock/common/AbstractFileSource.java b/src/main/java/com/github/tomakehurst/wiremock/common/AbstractFileSource.java
index ee9c2da8..d7c4a20e 100644
--- a/src/main/java/com/github/tomakehurst/wiremock/common/AbstractFileSource.java
+++ b/src/main/java/com/github/tomakehurst/wiremock/common/AbstractFileSource.java
@@ -111,7 +111,21 @@ public abstract class AbstractFileSource implements FileSource {
 
     @Override
     public void deleteFile(String name) {
-        writableFileFor(name).delete();
+        File file = writableFileFor(name);
+
+        // assertFilePathIsUnderRoot() (invoked by writableFileFor()) treats a value that canonically
+        // resolves to exactly the root directory as contained, which is right for reads and writes.
+        // For a delete it would let a name such as "" or "." remove the root directory itself
+        // whenever it is empty, so that case is refused here.
+        try {
+            if (file.getCanonicalFile().equals(rootDirectory.getCanonicalFile())) {
+                throw new NotAuthorisedException("Deleting the file source root directory is not permitted");
+            }
+        } catch (IOException ioe) {
+            throw new NotAuthorisedException("File " + name + " cannot be accessed", ioe);
+        }
+
+        file.delete();
     }
 
     @Override
