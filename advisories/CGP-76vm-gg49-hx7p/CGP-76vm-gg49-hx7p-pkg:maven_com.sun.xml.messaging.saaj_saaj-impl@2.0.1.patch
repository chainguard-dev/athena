+/*
+ * Exploit harness for CGP-76vm-gg49-hx7p (CWE-611 / CWE-776):
+ * XXE / entity-expansion in the lazy StAX SOAP body path
+ * (EnvelopeFactory.parseEnvelopeStax -> XMLInputFactory.createXMLStreamReader).
+ *
+ * This test drives the REAL public entry point exactly as soap.LazySOAPTest does:
+ *   MessageFactory.newInstance().createMessage(headers, in)
+ *     -> msg.setProperty(MessageImpl.LAZY_SOAP_BODY_PARSING, "true")
+ *       -> msg.getSOAPPart().getEnvelope()  (triggers EnvelopeFactory.parseEnvelopeStax)
+ *
+ * It exercises the documented payloads verbatim over BOTH the documented plain-XML
+ * route AND the non-enumerated MIME-multipart (SOAP-with-attachments) route, which
+ * lands on the SAME cached xmlInputFactory chokepoint.
+ *
+ * Polarity: each test asserts the SECURITY PROPERTY (no DOCTYPE/entity may be
+ * processed). On the UNPATCHED build the harmful effect happens and the assertions
+ * FAIL (non-zero exit). Once SUPPORT_DTD=false is installed on the factory, parsing
+ * throws SOAPException, which each test treats as "this payload was refused" -> pass.
+ */
+package soap;
+
+import java.io.ByteArrayInputStream;
+import java.io.File;
+import java.io.FileWriter;
+import java.io.InputStream;
+import java.net.ServerSocket;
+import java.net.Socket;
+
+import jakarta.xml.soap.MessageFactory;
+import jakarta.xml.soap.MimeHeaders;
+import jakarta.xml.soap.SOAPBody;
+import jakarta.xml.soap.SOAPEnvelope;
+import jakarta.xml.soap.SOAPException;
+import jakarta.xml.soap.SOAPMessage;
+
+import com.sun.xml.messaging.saaj.soap.MessageImpl;
+
+import junit.framework.TestCase;
+
+public class LazyStaxXXETest extends TestCase {
+
+    // SOAP 1.1 namespace, matching the "text/xml" Content-Type the lazy StAX path uses.
+    private static final String SOAP_NS = "http://schemas.xmlsoap.org/soap/envelope/";
+
+    /* ------------------------------------------------------------------ *
+     * Helpers that reproduce LazySOAPTest's construction, per route.
+     * ------------------------------------------------------------------ */
+
+    /** Documented plain-XML route: text/xml SOAP message from an InputStream. */
+    private SOAPMessage lazyPlainMessage(String soapXml) throws Exception {
+        MimeHeaders headers = new MimeHeaders();
+        headers.addHeader("Content-Type", "text/xml");
+        InputStream in = new ByteArrayInputStream(soapXml.getBytes("UTF-8"));
+        SOAPMessage msg = MessageFactory.newInstance().createMessage(headers, in);
+        msg.setProperty(MessageImpl.LAZY_SOAP_BODY_PARSING, "true");
+        return msg;
+    }
+
+    /**
+     * Non-enumerated MIME-multipart (SOAP-with-attachments) route: the SOAP part
+     * bytes are carried inside a multipart/related body-part and reach the SAME
+     * StAX sink through MessageImpl's multipart branch
+     * (soapPart.setContent(new StreamSource(soapPartInputStream))).
+     */
+    private SOAPMessage lazyMultipartMessage(String soapXml) throws Exception {
+        String boundary = "----=_Part_XXE_0";
+        String cid = "<soap-part@saaj.test>";
+        StringBuilder mp = new StringBuilder();
+        mp.append("--").append(boundary).append("\r\n");
+        mp.append("Content-Type: text/xml; charset=UTF-8\r\n");
+        mp.append("Content-Transfer-Encoding: 8bit\r\n");
+        mp.append("Content-ID: ").append(cid).append("\r\n");
+        mp.append("\r\n");
+        mp.append(soapXml).append("\r\n");
+        mp.append("--").append(boundary).append("--\r\n");
+
+        MimeHeaders headers = new MimeHeaders();
+        headers.addHeader("Content-Type",
+                "multipart/related; type=\"text/xml\"; boundary=\"" + boundary
+                        + "\"; start=\"" + cid + "\"");
+        InputStream in = new ByteArrayInputStream(mp.toString().getBytes("UTF-8"));
+        SOAPMessage msg = MessageFactory.newInstance().createMessage(headers, in);
+        msg.setProperty(MessageImpl.LAZY_SOAP_BODY_PARSING, "true");
+        return msg;
+    }
+
+    /**
+     * Force full materialization of the (lazily parsed) SOAP body and return the
+     * serialized message text so the caller can look for leaked secrets.
+     *
+     * Serializing the message (writeTo) triggers the deferred StAX body parse (and
+     * thus entity resolution / expansion) and works regardless of body shape,
+     * including a raw-text body such as the documented "<S:Body>&xxe;</S:Body>".
+     * Any parse/serialize failure caused by the DTD being refused surfaces (wrapped)
+     * as a SOAPException, which callers treat as "this payload was refused".
+     */
+    private String materializeBodyText(SOAPMessage msg) throws Exception {
+        SOAPEnvelope env = msg.getSOAPPart().getEnvelope();
+        // Reference the body to kick off the lazy body bridge.
+        SOAPBody body = env.getBody();
+        java.io.ByteArrayOutputStream bos = new java.io.ByteArrayOutputStream();
+        try {
+            msg.writeTo(bos);
+        } catch (SOAPException e) {
+            throw e; // DTD refused -> propagate as the fix's exception
+        } catch (Exception e) {
+            // A serialize-time failure that is NOT the fix's refusal (e.g. the SAAJ
+            // bridge choking on an already-resolved raw-text body) still means the
+            // parser processed the DOCTYPE. Fall back to any DOM text we can reach so
+            // a leaked secret is still observable rather than masked as an error.
+            StringBuilder sb = new StringBuilder();
+            try { collectText(body, sb); } catch (Exception ignore) { }
+            if (sb.length() > 0) {
+                return sb.toString();
+            }
+            throw e;
+        }
+        return new String(bos.toByteArray(), "UTF-8");
+    }
+
+    private void collectText(org.w3c.dom.Node n, StringBuilder sb) {
+        if (n == null) {
+            return;
+        }
+        String v = n.getNodeValue();
+        if (v != null) {
+            sb.append(v);
+        }
+        org.w3c.dom.NodeList kids = n.getChildNodes();
+        for (int i = 0; kids != null && i < kids.getLength(); i++) {
+            collectText(kids.item(i), sb);
+        }
+    }
