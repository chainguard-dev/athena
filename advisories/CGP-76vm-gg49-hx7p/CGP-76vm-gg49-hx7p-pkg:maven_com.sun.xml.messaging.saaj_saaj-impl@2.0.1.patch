+            "<!DOCTYPE foo [<!ENTITY greet \"" + marker + "\">]>"
+          + "<S:Envelope xmlns:S=\"" + SOAP_NS + "\">"
+          + "<S:Body><ns1:x xmlns:ns1=\"urn:x\">&greet;</ns1:x></S:Body></S:Envelope>";
