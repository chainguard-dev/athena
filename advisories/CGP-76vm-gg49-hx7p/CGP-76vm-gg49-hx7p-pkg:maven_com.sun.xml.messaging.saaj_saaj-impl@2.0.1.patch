-                if (xmlInputFactory == null) xmlInputFactory = XMLInputFactory.newInstance();
+                if (xmlInputFactory == null) {
+                    // Harden the shared StAX factory against XXE (CWE-611) and
+                    // entity-expansion DoS (CWE-776). A DOCTYPE is not legal content
+                    // in a SOAP envelope (the SAX path enforces this unconditionally
