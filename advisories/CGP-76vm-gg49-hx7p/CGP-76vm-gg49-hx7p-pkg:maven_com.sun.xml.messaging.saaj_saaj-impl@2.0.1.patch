+    /* ------------------------------------------------------------------ *
+     * 2. SSRF via parameter-entity fetching (documented payload), zero-egress.
+     * ------------------------------------------------------------------ */
+
+    public void testSsrfParameterEntity_plainRoute() throws Exception {
+        assertNoOutboundFetch(false);
+    }
+
+    public void testSsrfParameterEntity_multipartRoute() throws Exception {
+        assertNoOutboundFetch(true);
+    }
+
+    /**
+     * Stand up a local loopback listener and point the parameter entity at it. If the
+     * unhardened parser fetches the external DTD, the listener records a connection ->
+     * harmful effect (SSRF) -> FAIL. If parsing throws (DOCTYPE refused) and no
+     * connection is recorded, the SSRF is closed -> pass. Zero-egress: we assert on
+     * the LOCAL listener, never on real network reachability.
+     */
+    private void assertNoOutboundFetch(boolean multipart) throws Exception {
+        final ServerSocket server = new ServerSocket(0, 1, java.net.InetAddress.getByName("127.0.0.1"));
+        server.setSoTimeout(4000);
+        final boolean[] connected = { false };
+        Thread acceptor = new Thread(new Runnable() {
+            public void run() {
+                try {
+                    Socket s = server.accept();
+                    connected[0] = true;
+                    // Respond with a trivial (harmless) external DTD so a fetching
+                    // parser proceeds far enough for the connection to count.
+                    try {
+                        byte[] req = new byte[512];
+                        s.getInputStream().read(req);
+                    } catch (Exception ignore) { }
+                    try {
+                        String dtd = "<!ENTITY exfil \"pwned\">";
+                        String http = "HTTP/1.1 200 OK\r\nContent-Type: application/xml-dtd\r\n"
+                                + "Content-Length: " + dtd.length() + "\r\n\r\n" + dtd;
+                        s.getOutputStream().write(http.getBytes("UTF-8"));
+                        s.getOutputStream().flush();
+                    } catch (Exception ignore) { }
+                    try { s.close(); } catch (Exception ignore) { }
+                } catch (Exception ignore) {
+                    // accept timed out -> no connection was made
+                }
+            }
+        });
+        acceptor.setDaemon(true);
+        acceptor.start();
+
+        int port = server.getLocalPort();
+        // Documented parameter-entity SSRF shape, pointed at our loopback listener.
+        String dtdUrl = "http://127.0.0.1:" + port + "/evil.dtd";
+        String payload =
+            "<!DOCTYPE foo [<!ENTITY % ext SYSTEM \"" + dtdUrl + "\"> %ext;]>"
+          + "<S:Envelope xmlns:S=\"" + SOAP_NS + "\">"
+          + "<S:Body><ns1:x xmlns:ns1=\"urn:x\">hi</ns1:x></S:Body></S:Envelope>";
+
+        SOAPMessage msg = multipart ? lazyMultipartMessage(payload) : lazyPlainMessage(payload);
+        // Drive the sink. Whether the parse throws is not the security property here:
+        // once the DOCTYPE is refused (SUPPORT_DTD=false) the parameter entity is simply
+        // ignored and the well-formed body parses fine WITHOUT any outbound request.
+        // The harmful effect is the OUTBOUND CONNECTION, so that is the only assertion.
+        try {
+            materializeBodyText(msg);
+        } catch (SOAPException ignore) {
+            // DOCTYPE refused -> also acceptable; either way, assert no connection below.
+        }
+        try { acceptor.join(4500); } catch (InterruptedException ignore) { }
+        try { server.close(); } catch (Exception ignore) { }
+
+        assertFalse("SSRF via parameter entity: the lazy StAX parser made an outbound "
+                + "connection to the attacker-controlled DTD URL " + dtdUrl
+                + " (multipart=" + multipart + ")", connected[0]);
+    }
+
+    /* ------------------------------------------------------------------ *
+     * 3. Billion-laughs entity-expansion DoS (documented payload), bounded.
+     * ------------------------------------------------------------------ */
+
+    public void testBillionLaughs_plainRoute() throws Exception {
+        assertBillionLaughsBlocked(false);
+    }
+
+    public void testBillionLaughs_multipartRoute() throws Exception {
+        assertBillionLaughsBlocked(true);
+    }
+
+    /**
+     * Feed the billion-laughs payload (internal entities only).
+     *
+     * Discriminator: the harmful effect for CWE-776 is that the parser PROCESSES the
+     * DOCTYPE and EXPANDS the internal entities. The JDK ships a default 64000
+     * entity-expansion cap, so an unhardened parser does not OOM here — instead it
+     * expands until the cap and reports "...encountered more than 64000 entity
+     * expansions...". THAT MESSAGE IS THE PROOF THE DTD WAS PROCESSED, so we FAIL on
+     * it (do NOT mistake the JDK cap for the fix). With SUPPORT_DTD=false the DTD is
+     * ignored entirely, so &lol9; is reported as an undeclared entity ("was referenced,
+     * but not declared") with NO expansion -> the DoS vector is closed -> pass.
+     *
+     * Bounded by a timeout thread so a hypothetical true OOM path is caught as a
+     * failure rather than hanging the suite.
+     */
+    private void assertBillionLaughsBlocked(final boolean multipart) throws Exception {
+        // Documented billion-laughs payload, verbatim (wrapped in a SOAP envelope so it
+        // travels the SOAP entry point; the entity is referenced inside the Body).
+        final String payload =
+            "<!DOCTYPE lolz [ "
+          + "<!ENTITY lol \"lol\"> "
+          + "<!ENTITY lol1 \"&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;&lol;\"> "
+          + "<!ENTITY lol2 \"&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;&lol1;\"> "
+          + "<!ENTITY lol3 \"&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;&lol2;\"> "
+          + "<!ENTITY lol4 \"&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;&lol3;\"> "
+          + "<!ENTITY lol5 \"&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;&lol4;\"> "
+          + "<!ENTITY lol6 \"&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;&lol5;\"> "
+          + "<!ENTITY lol7 \"&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;&lol6;\"> "
+          + "<!ENTITY lol8 \"&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;&lol7;\"> "
+          + "<!ENTITY lol9 \"&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;&lol8;\"> "
+          + "]> "
+          + "<S:Envelope xmlns:S=\"" + SOAP_NS + "\">"
+          + "<S:Body><ns1:x xmlns:ns1=\"urn:x\">&lol9;</ns1:x></S:Body></S:Envelope>";
+
+        final String[] outcome = { null };   // serialized output if the parse completed
+        final Throwable[] err = { null };     // any thrown exception
+        Thread worker = new Thread(new Runnable() {
+            public void run() {
+                try {
+                    SOAPMessage msg = multipart ? lazyMultipartMessage(payload)
+                                                : lazyPlainMessage(payload);
+                    outcome[0] = materializeBodyText(msg);
+                } catch (Throwable t) {
+                    err[0] = t;
+                }
+            }
+        });
+        worker.setDaemon(true);
+        worker.start();
+        worker.join(20000);
+
+        if (worker.isAlive()) {
+            // Still expanding after the bound -> billion-laughs DoS is live.
+            fail("Billion-laughs entity expansion did not complete or reject within the "
+                    + "bound (multipart=" + multipart + "): the lazy StAX path is processing "
+                    + "the DTD and expanding internal entities (DoS).");
+        }
+        if (err[0] instanceof OutOfMemoryError) {
+            fail("Billion-laughs caused OutOfMemoryError (multipart=" + multipart + ").");
+        }
+
+        // Case 1: the parse completed and produced expanded output -> DTD processed.
+        if (outcome[0] != null && outcome[0].contains("lollollol")) {
+            fail("Billion-laughs internal entities were expanded into the parsed body "
+                    + "(multipart=" + multipart + "): the lazy StAX path processed the DTD.");
+        }
+        // Case 2: it threw. Inspect the whole cause chain. If any message shows entity
+        // expansion actually took place, the DTD was processed -> harmful effect.
+        String chain = messageChain(err[0]).toLowerCase();
+        if (chain.contains("entity expansion")) {
+            fail("Billion-laughs entity expansion occurred (JDK cap hit) — the lazy StAX "
+                    + "path PROCESSED the DOCTYPE and began expanding internal entities "
+                    + "(multipart=" + multipart + "): " + messageChain(err[0]));
+        }
+        // Reaching here means: no expansion happened. Either the DOCTYPE was refused
+        // outright (SUPPORT_DTD=false -> "entity ... was referenced, but not declared")
+        // or the parse otherwise did not expand. That is the remediated behaviour.
+        assertNotNull("Billion-laughs must be rejected once the DTD is refused "
+                + "(multipart=" + multipart + ")", err[0]);
+    }
+
+    /** Concatenate the message of a throwable and its entire cause chain. */
+    private String messageChain(Throwable t) {
+        StringBuilder sb = new StringBuilder();
+        int depth = 0;
+        while (t != null && depth < 12) {
+            sb.append(t.getClass().getName()).append(": ").append(t.getMessage()).append(" | ");
+            t = t.getCause();
+            depth++;
+        }
+        return sb.toString();
+    }
+
+    /* ------------------------------------------------------------------ *
+     * 3b. DOCTYPE processing / internal-entity expansion (CWE-776 core).
+     *     A crisp positive observation: an internal entity below the JDK cap is
+     *     expanded into the body. The DOCTYPE prohibition (SUPPORT_DTD=false) is
+     *     what closes this — external-entities-off alone does NOT, since this uses
+     *     only internal entities.
+     * ------------------------------------------------------------------ */
+
+    public void testInternalEntityExpansion_plainRoute() throws Exception {
+        assertDoctypeNotProcessed(false);
+    }
+
+    public void testInternalEntityExpansion_multipartRoute() throws Exception {
+        assertDoctypeNotProcessed(true);
+    }
+
+    private void assertDoctypeNotProcessed(boolean multipart) throws Exception {
+        final String marker = "HELLO_FROM_INTERNAL_ENTITY_" + (multipart ? "MP" : "PLAIN");
+        String payload =
+            "<!DOCTYPE foo [<!ENTITY greet \"" + marker + "\">]>"
+          + "<S:Envelope xmlns:S=\"" + SOAP_NS + "\">"
+          + "<S:Body><ns1:x xmlns:ns1=\"urn:x\">&greet;</ns1:x></S:Body></S:Envelope>";
+        SOAPMessage msg = multipart ? lazyMultipartMessage(payload) : lazyPlainMessage(payload);
+        String bodyText;
+        try {
+            bodyText = materializeBodyText(msg);
+        } catch (SOAPException expected) {
+            // DOCTYPE refused (SUPPORT_DTD=false) -> DTD not processed -> pass.
+            return;
+        }
+        assertFalse("DOCTYPE was processed: internal entity was expanded into the parsed "
+                + "SOAP body (multipart=" + multipart + "); SUPPORT_DTD is not disabled",
+                bodyText.contains(marker));
+        fail("DOCTYPE-bearing SOAP envelope parsed without being rejected (multipart="
+                + multipart + "); the lazy StAX path processed the DTD.");
+    }
+
+    /* ------------------------------------------------------------------ *
+     * Positive control: a legitimate DOCTYPE-free lazy SOAP message must still
+     * parse correctly through the SAME cached factory (must-not-break property).
+     * ------------------------------------------------------------------ */
+
+    public void testLegitimateLazyStillParses() throws Exception {
+        String soap =
+            "<S:Envelope xmlns:S=\"" + SOAP_NS + "\">"
+          + "<S:Header/>"
+          + "<S:Body><ns1:Hello xmlns:ns1=\"http://example.com/wsdl\">"
+          + "<String_1>Duke</String_1></ns1:Hello></S:Body></S:Envelope>";
