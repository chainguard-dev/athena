+
+    /**
+     * Marker-file variant: unambiguous crisp observation of local file read via the
+     * DOCTYPE SYSTEM entity. The entity is placed inside a child element so the leaked
+     * bytes land in element text content regardless of body-child handling.
+     */
+    public void testFileReadPlainRoute_markerFile() throws Exception {
+        File secret = File.createTempFile("xxe-marker", ".txt");
+        secret.deleteOnExit();
+        final String marker = "TOP_SECRET_XXE_MARKER_9f3a2b";
+        FileWriter w = new FileWriter(secret);
+        try {
+            w.write(marker);
+        } finally {
+            w.close();
+        }
+        String uri = secret.toURI().toString(); // file:/...
+        String payload =
+            "<!DOCTYPE foo [<!ENTITY xxe SYSTEM \"" + uri + "\">]>"
+          + "<S:Envelope xmlns:S=\"" + SOAP_NS + "\">"
+          + "<S:Body><ns1:leak xmlns:ns1=\"urn:x\">&xxe;</ns1:leak></S:Body></S:Envelope>";
+        assertFileReadBlocked(lazyPlainMessage(payload), uri, marker);
+    }
+
+    public void testFileReadMultipartRoute_markerFile() throws Exception {
+        File secret = File.createTempFile("xxe-marker-mp", ".txt");
+        secret.deleteOnExit();
+        final String marker = "TOP_SECRET_XXE_MARKER_MP_5c7e";
+        FileWriter w = new FileWriter(secret);
+        try {
+            w.write(marker);
+        } finally {
+            w.close();
+        }
+        String uri = secret.toURI().toString();
+        String payload =
+            "<!DOCTYPE foo [<!ENTITY xxe SYSTEM \"" + uri + "\">]>"
+          + "<S:Envelope xmlns:S=\"" + SOAP_NS + "\">"
+          + "<S:Body><ns1:leak xmlns:ns1=\"urn:x\">&xxe;</ns1:leak></S:Body></S:Envelope>";
+        assertFileReadBlocked(lazyMultipartMessage(payload), uri, marker);
+    }
+
+    /**
+     * Drive the lazy StAX parse and force body materialization. If the DOCTYPE/entity
+     * were processed the secret appears in the parsed body -> harmful effect -> FAIL.
+     * A thrown SOAPException means the DOCTYPE was refused (the fix's behaviour) -> pass.
+     */
+    private void assertFileReadBlocked(SOAPMessage msg, String what, String secretNeedle)
+            throws Exception {
+        String bodyText;
+        try {
+            bodyText = materializeBodyText(msg);
+        } catch (SOAPException expected) {
+            // DOCTYPE refused at/after createXMLStreamReader -> vulnerability closed.
+            return;
+        }
+        assertFalse(
+            "XXE file read succeeded: contents of " + what
+                + " were resolved into the parsed SOAP body (leaked marker present)",
+            bodyText.contains(secretNeedle));
+        // A DOCTYPE-bearing document must NOT parse successfully at all.
+        fail("DOCTYPE-bearing SOAP envelope parsed without being rejected (file: " + what
+                + "); the lazy StAX path processed the DTD. Parsed body text=[" + bodyText + "]");
+    }
