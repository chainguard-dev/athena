+        // Documented payload, verbatim.
+        String payload =
+            "<!DOCTYPE foo [<!ENTITY xxe SYSTEM \"file:///etc/passwd\">]>"
+          + "<S:Envelope xmlns:S=\"http://schemas.xmlsoap.org/soap/envelope/\">"
+          + "<S:Body>&xxe;</S:Body></S:Envelope>";
+        assertFileReadBlocked(lazyPlainMessage(payload), "/etc/passwd", "root:");
+    }
+
+    public void testFileReadMultipartRoute_documentedPayload() throws Exception {
+        // Same documented payload, delivered through the non-enumerated multipart route.
+        String payload =
+            "<!DOCTYPE foo [<!ENTITY xxe SYSTEM \"file:///etc/passwd\">]>"
+          + "<S:Envelope xmlns:S=\"http://schemas.xmlsoap.org/soap/envelope/\">"
+          + "<S:Body>&xxe;</S:Body></S:Envelope>";
