@@ -58,17 +59,22 @@ public class DeflateCompressionCodec extends AbstractCompressionCodec {
 
     @Override
     public byte[] doDecompress(byte[] compressed) throws IOException {
-        InflaterOutputStream inflaterOutputStream = null;
+        // Bounded sink: aborts before an oversized (bomb) payload is materialized. The InflaterOutputStream
+        // pushes each inflated chunk through write(...), so the ceiling fires incrementally during
+        // decompression. See AbstractCompressionCodec#newBoundedOutputStream (CWE-409 / CWE-770).
         ByteArrayOutputStream decompressedOutputStream = null;
+        OutputStream boundedSink = null;
+        InflaterOutputStream inflaterOutputStream = null;
 
         try {
-            decompressedOutputStream = new ByteArrayOutputStream();
-            inflaterOutputStream = new InflaterOutputStream(decompressedOutputStream);
+            decompressedOutputStream = newBoundedOutputStream();
+            boundedSink = boundedSink(decompressedOutputStream);
+            inflaterOutputStream = new InflaterOutputStream(boundedSink);
             inflaterOutputStream.write(compressed);
             inflaterOutputStream.flush();
             return decompressedOutputStream.toByteArray();
         } finally {
-            Objects.nullSafeClose(decompressedOutputStream, inflaterOutputStream);
+            Objects.nullSafeClose(decompressedOutputStream, boundedSink, inflaterOutputStream);
         }
     }
 }
