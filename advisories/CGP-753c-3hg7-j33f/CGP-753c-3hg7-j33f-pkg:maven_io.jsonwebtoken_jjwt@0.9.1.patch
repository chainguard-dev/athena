index e1b2e65..284df38 100644
--- a/src/main/java/io/jsonwebtoken/impl/compression/AbstractCompressionCodec.java
+++ b/src/main/java/io/jsonwebtoken/impl/compression/AbstractCompressionCodec.java
@@ -19,7 +19,11 @@ import io.jsonwebtoken.CompressionCodec;
 import io.jsonwebtoken.CompressionException;
 import io.jsonwebtoken.lang.Assert;
 
+import java.io.ByteArrayOutputStream;
 import java.io.IOException;
+import java.io.OutputStream;
+import java.util.logging.Level;
+import java.util.logging.Logger;
 
 /**
  * Abstract class that asserts arguments and wraps IOException with CompressionException.
@@ -28,6 +32,141 @@ import java.io.IOException;
  */
 public abstract class AbstractCompressionCodec implements CompressionCodec {
 
+    private static final Logger LOG = Logger.getLogger(AbstractCompressionCodec.class.getName());
+
+    /**
+     * Deployment-scoped system property (read once at class init) that overrides the maximum number of
+     * bytes any shipped codec's {@link #doDecompress(byte[]) doDecompress} is allowed to produce before it
+     * aborts.  This exists so operators whose legitimate compressed payloads are larger than the curated
+     * default can raise the ceiling without patching, and so operators can disable the protection
+     * entirely.  Setting it logs a WARN naming the decompression-bomb mitigation being altered.  It is NOT
+     * a public runtime setter (no attacker-reachable widening); it is read a single time when this class
+     * loads.
+     *
+     * <ul>
+     *   <li>A positive value raises/lowers the ceiling to that many bytes.</li>
+     *   <li>A value of {@code 0} or less disables the ceiling entirely (escape hatch -- restores the
+     *       pre-fix, vulnerable behavior; logged as a WARN).</li>
+     * </ul>
+     */
+    private static final String MAX_DECOMPRESSED_BYTES_PROPERTY =
+            "io.jsonwebtoken.compression.maxDecompressedBytes";
+
+    /**
+     * Default ceiling on decompressed output for the shipped DEFLATE and GZIP codecs.  Chosen well above
+     * any realistic JWT claims payload (a few KB) yet far below the tens/hundreds of MB a decompression
+     * bomb produces.  Enforced INCREMENTALLY as bytes are produced (never after an oversized buffer has
+     * already been materialized) so a small compressed payload cannot inflate to gigabytes and exhaust the
+     * heap.  See CWE-409 / CWE-770.
+     */
+    private static final int DEFAULT_MAX_DECOMPRESSED_BYTES = 1024 * 1024; // 1 MiB
+
+    /**
+     * The effective ceiling: {@code private static final}, resolved once at class-init from the default
+     * plus the optional deployment-scoped override.  A value {@code <= 0} means the ceiling is disabled.
+     */
+    private static final long MAX_DECOMPRESSED_BYTES = resolveMaxDecompressedBytes();
+
+    private static long resolveMaxDecompressedBytes() {
+        String override = System.getProperty(MAX_DECOMPRESSED_BYTES_PROPERTY);
+        if (override == null) {
+            return DEFAULT_MAX_DECOMPRESSED_BYTES;
+        }
+        long value;
+        try {
+            value = Long.parseLong(override.trim());
+        } catch (NumberFormatException e) {
+            LOG.log(Level.WARNING, "Ignoring non-numeric value \"" + override + "\" for system property " +
+                    MAX_DECOMPRESSED_BYTES_PROPERTY + "; using the default decompression ceiling of " +
+                    DEFAULT_MAX_DECOMPRESSED_BYTES + " bytes (CWE-770).");
+            return DEFAULT_MAX_DECOMPRESSED_BYTES;
+        }
+        if (value <= 0) {
+            LOG.log(Level.WARNING, "System property " + MAX_DECOMPRESSED_BYTES_PROPERTY + " is set to " +
+                    value + ", which DISABLES the JWT decompression-bomb ceiling. The library is now " +
+                    "vulnerable to unbounded GZIP/DEFLATE decompression (CWE-409 / " +
+                    "CWE-770). Unset this property to restore the protection.");
+            return -1L;
+        }
+        LOG.log(Level.WARNING, "System property " + MAX_DECOMPRESSED_BYTES_PROPERTY + " overrides the JWT " +
+                "decompression ceiling to " + value + " bytes (default " + DEFAULT_MAX_DECOMPRESSED_BYTES +
+                "); the decompression-bomb mitigation (CWE-770) is weakened if this " +
+                "is larger than your largest legitimate compressed payload.");
+        return value;
+    }
+
+    /**
+     * Creates a {@link ByteArrayOutputStream} that aborts with an {@link IOException} as soon as the total
+     * number of bytes written would exceed the configured ceiling.  The check happens INSIDE every
+     * {@code write(...)} call, before the offending chunk is stored, so an oversized (bomb) payload is
+     * never fully materialized in memory.  Only bytes actually produced by decompression are counted -- no
+     * length/size field carried inside the compressed stream is trusted.
+     *
+     * <p>This is the single decompression sink shared by every shipped codec
+     * ({@link DeflateCompressionCodec}, {@link GzipCompressionCodec}): each writes its inflated output into
+     * this stream (whether through a read loop or through {@code InflaterOutputStream.write(...)}), so
+     * guarding it here bounds every caller of {@link #decompress(byte[]) decompress}, including callers
+     * that reach a shipped codec through a custom
+     * {@link io.jsonwebtoken.CompressionCodecResolver CompressionCodecResolver}.</p>
+     *
+     * @return a bounded {@link ByteArrayOutputStream} to receive decompressed bytes
+     */
+    protected static ByteArrayOutputStream newBoundedOutputStream() {
+        return new BoundedByteArrayOutputStream(MAX_DECOMPRESSED_BYTES);
+    }
+
+    /**
+     * A {@link ByteArrayOutputStream} that throws an {@link IOException} the moment its accumulated size
+     * would exceed {@code maxBytes}.  A {@code maxBytes} value {@code < 0} disables the ceiling (operator
+     * escape hatch).  Because {@link java.util.zip.InflaterOutputStream InflaterOutputStream} and manual
+     * read loops both funnel their decompressed output through {@code write(...)}, subclassing the sink
+     * makes the bound fire incrementally for either decompression style.
+     */
+    private static final class BoundedByteArrayOutputStream extends ByteArrayOutputStream {
+
+        private final long maxBytes;
+
+        private BoundedByteArrayOutputStream(long maxBytes) {
+            this.maxBytes = maxBytes;
+        }
+
+        private void checkBound(long additional) throws IOException {
+            if (maxBytes >= 0 && (long) this.count + additional > maxBytes) {
+                throw new IOException("Decompressed JWT payload exceeds the maximum allowed size of " +
+                        maxBytes + " bytes; aborting to prevent a decompression-bomb denial-of-service " +
+                        "(CWE-409 / CWE-770).");
+            }
+        }
+
+        // ByteArrayOutputStream.write(int) / write(byte[],int,int) are not declared to throw IOException,
+        // so we cannot override them to signal overflow.  Instead we expose IOException-throwing variants
+        // that the codecs (and the InflaterOutputStream they wrap) route through.
+        void writeChecked(byte[] b, int off, int len) throws IOException {
+            checkBound(len);
+            super.write(b, off, len);
+        }
+    }
+
+    /**
+     * An {@link OutputStream} adapter that forwards to a {@link BoundedByteArrayOutputStream}'s
+     * IOException-throwing write, so that a {@link java.util.zip.InflaterOutputStream InflaterOutputStream}
+     * wrapping it aborts mid-inflation once the ceiling is crossed.
+     */
+    protected static OutputStream boundedSink(final ByteArrayOutputStream out) {
+        final BoundedByteArrayOutputStream bounded = (BoundedByteArrayOutputStream) out;
+        return new OutputStream() {
+            @Override
+            public void write(int b) throws IOException {
+                bounded.writeChecked(new byte[]{(byte) b}, 0, 1);
+            }
+
+            @Override
+            public void write(byte[] b, int off, int len) throws IOException {
+                bounded.writeChecked(b, off, len);
+            }
+        };
+    }
+
     /**
      * Implement this method to do the actual work of compressing the payload
      *
