@@ -315,6 +315,20 @@ public class DefaultJwtParser implements JwtParser {
             claims = new DefaultClaims(claimsMap);
         }
 
+        // =============== Unsigned token on a keyed parser =================
+        // CWE-347: a token without signature bytes (e.g. 'header.payload.' or an alg:none token with an empty
+        // third segment) would otherwise skip the signature block below entirely.  If this parser was given any
+        // verification material it must never return, validate or hand to a JwtHandler such an unverified token.
+        // The decision depends only on the absent signature and the parser's current key state, never on the
+        // token's declared 'alg' header.  It runs before any SigningKeyResolver call, exp/nbf and expected-claim
+        // validation, Jwt construction and JwtHandler callback, so every parse-family method funnels through it.
+        if (base64UrlEncodedDigest == null && hasVerificationMaterial()) {
+            String msg = claims != null ?
+                "Unsigned Claims JWTs are not supported." :
+                "Unsigned plaintext JWTs are not supported.";
+            throw new UnsupportedJwtException(msg);
+        }
+
         // =============== Signature =================
         if (base64UrlEncodedDigest != null) { //it is signed - validate the signature
 
@@ -461,6 +475,17 @@ public class DefaultJwtParser implements JwtParser {
         }
     }
 
+    /**
+     * Returns {@code true} if this parser currently holds any signature verification material: a {@code Key},
+     * key bytes (including a zero-length array, e.g. a base64 key string that decodes to no bytes) or a
+     * {@link SigningKeyResolver}.  Read on every parse so that material set after construction is honored.
+     *
+     * @return whether a verification key, key bytes or a signing key resolver has been configured.
+     */
+    private boolean hasVerificationMaterial() {
+        return this.key != null || this.keyBytes != null || this.signingKeyResolver != null;
+    }
