+        write(new File(base, "sub/escape.xsd"), includeOnly(relative(new File(base, "sub"), new File(outside, "outer.xsd"))));
+        listener = new ServerSocket(0, 50, InetAddress.getLoopbackAddress());
+        hostPort = "127.0.0.1:" + listener.getLocalPort();
+        Thread acceptor = new Thread(() -> {
