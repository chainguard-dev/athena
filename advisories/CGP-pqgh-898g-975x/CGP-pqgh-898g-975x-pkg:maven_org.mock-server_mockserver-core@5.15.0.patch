+    }
+
+    private static String text(String body) throws Exception {
+        return new StringToXmlDocumentParser().buildDocument(body, (xml, exception, level) -> {
+        }, false).getDocumentElement().getTextContent();
+    }
+
+    private static String textOrRefusal(String body) {
