+        outside = Files.createTempDirectory("xml-schema-outside").toFile().getCanonicalFile();
+        write(new File(outside, "outside-ns.xsd"), namespaceSchema("urn:test:outside"));
+        write(new File(outside, "outer.xsd"), OUTER_XSD);
