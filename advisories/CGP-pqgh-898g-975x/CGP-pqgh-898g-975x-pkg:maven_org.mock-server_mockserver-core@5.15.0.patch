+        write(new File(base, "child-ns.xsd"), namespaceSchema("urn:test:child"));
+        write(new File(base, "secret.txt"), SECRET);
+        write(new File(base, "ents.dtd"), "<!ENTITY e \"" + DTD_MARKER + "\">\n");
+        for (String directory : new String[]{"sub", "dir with space/sub", "extra root/sub"}) {
