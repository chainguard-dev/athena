+
+    @Test
+    public void shouldNotMatchXpathOrXmlOnExternalEntityContent() throws Exception {
+        String body = "<?xml version=\"1.0\"?><!DOCTYPE v [ <!ENTITY x SYSTEM \"" + secret.toURI() + "\"> ]><v>&x;</v>";
