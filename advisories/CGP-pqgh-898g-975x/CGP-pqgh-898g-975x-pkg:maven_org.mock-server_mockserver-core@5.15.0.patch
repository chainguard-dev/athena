+        assertThat(textOrRefusal("<!DOCTYPE note SYSTEM \"" + dtd.toURI() + "\"><note>&b;</note>"), not(containsString(SECRET)));
+        assertThat(textOrRefusal("<!DOCTYPE note [ <!ENTITY % p SYSTEM \"" + dtd.toURI() + "\"> %p; ]><note>&b;</note>"), not(containsString(SECRET)));
+    }
+
+    @Test
+    public void shouldNotConnectForExternalEntityDtdOrParameterEntity() throws Exception {
