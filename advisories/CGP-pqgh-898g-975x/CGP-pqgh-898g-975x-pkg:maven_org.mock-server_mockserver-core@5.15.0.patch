+            @Override
+            public void sendResponse(HttpRequest request, HttpResponse response) {
+            }
+        }, false);
+        HttpRequest request = request("/probe").withBody(requestBody);
+        if (contentType != null) {
+            request.withHeader("Content-Type", contentType);
+        }
+        return httpState.firstMatchingExpectation(request) != null;
+    }
+}
