+/**
+ * Bodies matched by XPath, and XML bodies matched by a JSON schema, may carry a DOCTYPE with an internal subset;
+ * external entities and external DTDs in them are not loaded.
+ */
+public class StringToXmlDocumentParserExternalEntityTest {
+
+    private static final String SECRET = "XMLPARSERSECRET";
+    private static final String DOCTYPE_BODY = "<!DOCTYPE note [ <!ELEMENT note ANY> ]><note><to>Bob</to></note>";
+    private static final String DOCTYPE_ENTITY_BODY = "<!DOCTYPE note [ <!ENTITY b \"Bob\"> ]><note><to>&b;</to></note>";
+    private static final String JSON_SCHEMA = "{\"type\": \"object\", \"properties\": {\"to\": {\"enum\": [\"Bob\"]}}, \"required\": [\"to\"]}";
+    private static final AtomicInteger CONNECTIONS = new AtomicInteger();
+
+    private static File secret;
+    private static File dtd;
+    private static ServerSocket listener;
+    private static String http;
+
+    @BeforeClass
+    public static void createFilesAndListener() throws IOException {
+        secret = new File("target/xml-parser-entity-test/secret.txt").getCanonicalFile();
+        dtd = new File("target/xml-parser-entity-test/note.dtd").getCanonicalFile();
+        Files.createDirectories(secret.getParentFile().toPath());
+        Files.write(secret.toPath(), SECRET.getBytes(UTF_8));
+        Files.write(dtd.toPath(), ("<!ENTITY b \"" + SECRET + "\">").getBytes(UTF_8));
+        listener = new ServerSocket(0, 50, InetAddress.getLoopbackAddress());
+        http = "http://127.0.0.1:" + listener.getLocalPort();
+        Thread acceptor = new Thread(() -> {
+            while (!listener.isClosed()) {
+                try (Socket ignored = listener.accept()) {
+                    CONNECTIONS.incrementAndGet();
+                } catch (IOException e) {
+                    return;
+                }
+            }
+        });
+        acceptor.setDaemon(true);
+        acceptor.start();
+    }
+
+    @AfterClass
+    public static void stopListener() throws IOException {
+        listener.close();
+    }
+
+    @Test
+    public void shouldExpandInternalEntity() throws Exception {
+        assertThat(text(DOCTYPE_ENTITY_BODY), is("Bob"));
+    }
+
+    @Test
+    public void shouldNotReadExternalEntity() throws Exception {
+        assertThat(text("<!DOCTYPE v [ <!ENTITY x SYSTEM \"" + secret.toURI() + "\"> ]><v>&x;</v>"), not(containsString(SECRET)));
+        assertThat(text("<!DOCTYPE v [ <!ENTITY x SYSTEM \"target/xml-parser-entity-test/secret.txt\"> ]><v>&x;</v>"), not(containsString(SECRET)));
+    }
+
+    @Test
+    public void shouldNotLoadExternalDtdOrParameterEntity() {
