+    // ---- helpers
+
+    /**
+     * "" when the schema compiles and the body is valid, the validation error when it is not, or "not compiled: ..."
+     */
+    private static String outcome(String schema, String xml) {
+        XmlSchemaValidator validator;
+        try {
+            validator = new XmlSchemaValidator(new MockServerLogger(), schema);
+        } catch (RuntimeException e) {
+            return "not compiled: " + messages(e);
+        }
+        return validator.isValid(xml);
+    }
+
+    /**
+     * outcome(schema, xml), or "blocked" when it has not finished after ten seconds; the pipe is then opened for
+     * writing and closed, so the waiting compilation reads end of file and releases the lock other tests need
+     */
+    private static String outcomeWithin(File pipe, String schema, String xml) throws Exception {
+        FutureTask<String> task = new FutureTask<>(() -> outcome(schema, xml));
+        Thread compilation = new Thread(task);
+        compilation.setDaemon(true);
+        compilation.start();
+        try {
+            return task.get(10, TimeUnit.SECONDS);
+        } catch (TimeoutException e) {
+            Thread release = new Thread(() -> {
+                try (FileOutputStream ignored = new FileOutputStream(pipe)) {
+                    // opening and closing the pipe for writing gives its reader end of file
+                } catch (IOException ignore) {
+                    // the compilation is reported as blocked either way
+                }
+            });
+            release.setDaemon(true);
+            release.start();
+            try {
+                task.get(10, TimeUnit.SECONDS);
+            } catch (TimeoutException | ExecutionException ignore) {
+                // the compilation is reported as blocked either way
+            }
+            return "blocked";
+        }
+    }
+
+    private static void assertNotLoaded(String schema, String xml) {
+        assertThat(schema, outcome(schema, xml), not(""));
+    }
+
+    private static void assertNotRead(String schema, String marker) {
+        String outcome = outcome(schema, "<v>x</v>");
+        assertThat(outcome, startsWith("not compiled"));
+        assertThat(outcome, not(containsString(marker)));
+    }
+
+    private static String messages(Throwable throwable) {
+        StringBuilder messages = new StringBuilder();
+        for (Throwable cause = throwable; cause != null; cause = cause.getCause() == cause ? null : cause.getCause()) {
+            messages.append(' ').append(cause.getMessage());
+        }
+        return messages.toString();
+    }
+
+    private static int connectionsDuring(Runnable action) throws InterruptedException {
+        CONNECTIONS.set(0);
+        action.run();
+        Thread.sleep(300);
+        return CONNECTIONS.get();
+    }
+
+    private static HttpState httpState() {
+        return new HttpState(configuration(), new MockServerLogger(), mock(Scheduler.class));
+    }
+
+    /**
+     * PUT /mockserver/expectation; returns the status code, or "failed: " and the exception text
+     */
+    private static String putExpectation(HttpState httpState, Body<?> body) {
+        String json = new ExpectationSerializer(new MockServerLogger()).serialize(new Expectation(request("/probe").withBody(body)).thenRespond(response("ok")));
+        CapturingResponseWriter writer = new CapturingResponseWriter();
+        try {
+            httpState.handle(request("/mockserver/expectation").withMethod("PUT").withBody(json), writer, false);
+        } catch (RuntimeException e) {
+            return "failed: " + messages(e);
+        }
+        return writer.response == null ? "no response" : String.valueOf(writer.response.getStatusCode());
+    }
+
+    private static boolean matches(HttpState httpState, HttpRequest request) {
+        return httpState.firstMatchingExpectation(request.withPath("/probe")) != null;
+    }
+
+    private static MockServerLogger capturingLogger(StringBuilder logged) {
+        return new MockServerLogger() {
+            @Override
+            public void logEvent(LogEntry logEntry) {
+                logged.append(logEntry.getMessage()).append(' ');
+                if (logEntry.getThrowable() != null) {
+                    logged.append(messages(logEntry.getThrowable())).append(' ');
+                }
+            }
+        };
+    }
+
+    private static final class CapturingResponseWriter extends ResponseWriter {
+        private HttpResponse response;
+
+        CapturingResponseWriter() {
+            super(configuration(), new MockServerLogger());
+        }
+
+        @Override
+        public void sendResponse(HttpRequest request, HttpResponse response) {
+            this.response = response;
+        }
+    }
+
+    private static void write(File file, String content) throws IOException {
+        Files.createDirectories(file.getParentFile().toPath());
+        Files.write(file.toPath(), content.getBytes(UTF_8));
+    }
+
+    private static String relative(File from, File to) {
+        return from.toPath().relativize(to.toPath()).toString().replace(File.separatorChar, '/');
+    }
+
+    private static String namespaceSchema(String namespace) {
+        return "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" targetNamespace=\"" + namespace + "\" elementFormDefault=\"qualified\">"
+            + "<xs:element name=\"child\" type=\"xs:string\"/></xs:schema>";
+    }
+
+    private static String importing(String location, String namespace) {
+        return "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" xmlns:c=\"" + namespace + "\" elementFormDefault=\"qualified\">\n"
+            + "  <xs:import namespace=\"" + namespace + "\" schemaLocation=\"" + location + "\"/>\n"
+            + "  <xs:element name=\"parent\"><xs:complexType><xs:sequence><xs:element ref=\"c:child\"/></xs:sequence></xs:complexType></xs:element>\n"
+            + "</xs:schema>";
+    }
+
+    private static String importingXml(String namespace) {
+        return "<parent xmlns:c=\"" + namespace + "\"><c:child>x</c:child></parent>";
+    }
+
+    private static String includeOnly(String location) {
+        return "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\"><xs:include schemaLocation=\"" + location + "\"/></xs:schema>";
+    }
+
+    private static String includeWithElement(String location) {
+        return "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\"><xs:include schemaLocation=\"" + location + "\"/>"
+            + "<xs:element name=\"v\" type=\"xs:string\"/></xs:schema>";
+    }
+
+    private static String chainTop(String location) {
+        return "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" elementFormDefault=\"qualified\">\n"
+            + "  <xs:include schemaLocation=\"" + location + "\"/>\n"
+            + "  <xs:element name=\"top\"><xs:complexType><xs:sequence><xs:element ref=\"mid\"/></xs:sequence></xs:complexType></xs:element>\n"
+            + "</xs:schema>";
+    }
+
+    private static String doctypeSchema() {
+        return NOTE_XSD.replace("<xs:schema", "<!DOCTYPE xs:schema [ <!ENTITY str \"xs:string\"> ]>\n<xs:schema").replace("type=\"xs:string\"", "type=\"&str;\"");
+    }
+
+    /**
+     * the entity is character content of xs:schema, so the parser's error names its text if it is read
+     */
+    private static String contentEntitySchema(String doctype) {
+        return "<?xml version=\"1.0\"?>\n" + doctype + "\n"
+            + "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\">&e;<xs:element name=\"v\" type=\"xs:string\"/></xs:schema>";
+    }
+
+    /**
+     * compiles only if the DTD is loaded, since the entity e is declared there
+     */
+    private static String enumerationSchema(String doctype) {
+        return "<?xml version=\"1.0\"?>\n" + doctype + "\n"
+            + "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\"><xs:element name=\"v\"><xs:simpleType>"
+            + "<xs:restriction base=\"xs:string\"><xs:enumeration value=\"&e;\"/></xs:restriction>"
+            + "</xs:simpleType></xs:element></xs:schema>";
+    }
