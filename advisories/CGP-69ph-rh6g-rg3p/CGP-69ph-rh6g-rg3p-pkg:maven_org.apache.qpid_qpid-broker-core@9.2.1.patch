+    // ******* Helpers ********** //
+
+    /** A password check whose running time is measured. */
+    @FunctionalInterface
+    private interface PasswordCheck
+    {
+        boolean check(char[] candidate) throws AccountNotFoundException;
+    }
+
+    /** A named class of candidate passwords together with the verdict it must produce. */
+    private static final class Candidate
+    {
+        private final String _label;
+        private final char[] _value;
+        private final boolean _expectedVerdict;
+
+        private Candidate(final String label, final char[] value, final boolean expectedVerdict)
+        {
+            _label = label;
+            _value = value;
+            _expectedVerdict = expectedVerdict;
+        }
+    }
+
+    private static List<Candidate> positionCandidates(final char[] stored)
+    {
+        final int length = stored.length;
+        final List<Candidate> candidates = new ArrayList<>();
+        candidates.add(new Candidate("wrong at element 0", differingAt(stored, 0), false));
+        candidates.add(new Candidate("wrong at element N/2", differingAt(stored, length / 2), false));
+        candidates.add(new Candidate("wrong only at element N-1", differingAt(stored, length - 1), false));
+        candidates.add(new Candidate("exact match", stored.clone(), true));
+        return candidates;
+    }
+
+    private static List<Candidate> lengthCandidates(final char[] stored, final char extra)
+    {
+        final int length = stored.length;
+        final char[] extension = Arrays.copyOf(stored, length + 1);
+        extension[length] = extra;
+        final List<Candidate> candidates = new ArrayList<>();
+        candidates.add(new Candidate("wrong only at element N-1", differingAt(stored, length - 1), false));
+        candidates.add(new Candidate("empty candidate", new char[0], false));
+        candidates.add(new Candidate("length 1 (first character of the secret)", new char[]{stored[0]}, false));
+        candidates.add(new Candidate("strict prefix of length N-1", Arrays.copyOf(stored, length - 1), false));
+        candidates.add(new Candidate("strict extension of length N+1", extension, false));
+        return candidates;
+    }
+
+    private static List<Candidate> allCandidates(final char[] stored, final char extra)
+    {
+        final List<Candidate> candidates = new ArrayList<>(positionCandidates(stored));
+        final List<Candidate> lengthCandidates = lengthCandidates(stored, extra);
+        candidates.addAll(lengthCandidates.subList(1, lengthCandidates.size()));
+        return candidates;
+    }
+
+    private static char[] differingAt(final char[] stored, final int index)
+    {
+        final char[] candidate = stored.clone();
+        candidate[index] = (char) (candidate[index] ^ 1);
+        return candidate;
+    }
+
+    private void assertTimingIndependentOfCandidate(final String route,
+                                                    final PasswordCheck check,
+                                                    final List<Candidate> candidates) throws AccountNotFoundException
+    {
+        final int count = candidates.size();
+        for (int round = 0; round < WARM_UP_ROUNDS; round++)
+        {
+            for (final Candidate candidate : candidates)
+            {
+                assertVerdict(route, candidate, check.check(candidate._value));
+            }
+        }
+
+        final long[][] samples = new long[count][MEASURED_ROUNDS];
+        for (int round = 0; round < MEASURED_ROUNDS; round++)
+        {
+            for (int k = 0; k < count; k++)
+            {
+                final int index = (k + round) % count;
+                final Candidate candidate = candidates.get(index);
+                final long start = System.nanoTime();
+                final boolean verdict = check.check(candidate._value);
+                samples[index][round] = System.nanoTime() - start;
+                assertVerdict(route, candidate, verdict);
+            }
+        }
+
+        final long[] medians = new long[count];
+        int slowest = 0;
+        for (int i = 0; i < count; i++)
+        {
+            final long[] sorted = samples[i].clone();
+            Arrays.sort(sorted);
+            medians[i] = sorted[sorted.length / 2];
+            if (medians[i] > medians[slowest])
+            {
+                slowest = i;
+            }
+        }
+
+        final StringBuilder report = new StringBuilder();
+        final List<String> leaking = new ArrayList<>();
+        for (int i = 0; i < count; i++)
+        {
+            report.append(String.format("%n  %-45s median %,12d ns", candidates.get(i)._label, medians[i]));
+            if (medians[i] * MAX_TIMING_RATIO < medians[slowest])
+            {
+                leaking.add(String.format("'%s' (%,d ns vs %,d ns)",
+                                          candidates.get(i)._label, medians[i], medians[slowest]));
+            }
+        }
+        timingLogger().info("Timing of {} against a {}-character stored operand:{}", route, SECRET_LENGTH, report);
+
+        if (!leaking.isEmpty())
+        {
+            fail(String.format("CWE-208 timing oracle in %s: candidate classes compared more than %dx faster than "
+                               + "the slowest class '%s': %s. Medians:%s",
+                               route, MAX_TIMING_RATIO, candidates.get(slowest)._label, leaking, report));
+        }
+    }
+
+    private void assertVerdict(final String route, final Candidate candidate, final boolean verdict)
+    {
+        _sink += verdict ? 1 : 0;
+        assertEquals(candidate._expectedVerdict, verdict,
+                     "Unexpected verdict from " + route + " for candidate '" + candidate._label + "'");
+    }
+
+    private static void assertCompareVerdict(final AbstractPasswordFilePrincipalDatabase<?> database,
+                                             final String stored,
+                                             final String supplied,
+                                             final boolean expected)
+    {
+        assertEquals(expected, database.compareCharArray(stored.toCharArray(), supplied.toCharArray()),
+                     database.getClass().getSimpleName() + ": unexpected compareCharArray verdict (lengths "
+                     + stored.length() + " / " + supplied.length() + ")");
+    }
+
+    private static boolean compareTreatingNullPointerAsRejection(final AbstractPasswordFilePrincipalDatabase<?> database,
+                                                                 final char[] stored,
+                                                                 final char[] supplied)
+    {
+        try
+        {
+            return database.compareCharArray(stored, supplied);
+        }
+        catch (NullPointerException e)
+        {
+            // rejecting a null operand by throwing is fail-closed: it is never a positive verdict
+            return false;
+        }
+    }
+
+    private void assertPlainVerdict(final String stored, final String supplied, final boolean expected)
+            throws AccountNotFoundException
+    {
+        final String user = "verdictUser" + (_verdictUsers++);
+        assertTrue(_plainDatabase.createPrincipal(new UsernamePrincipal(user, null), stored.toCharArray()),
+                   "Could not create user for stored password");
+        assertEquals(expected, _plainDatabase.verifyPassword(user, supplied.toCharArray()),
+                     "Unexpected verdict for supplied password against stored password (lengths "
+                     + supplied.length() + " / " + stored.length() + ")");
+    }
+
+    private File writePasswordFile(final String content) throws IOException
+    {
+        final File file = File.createTempFile(getTestName(), "tmp");
+        file.deleteOnExit();
+        _passwordFiles.add(file);
+        try (final BufferedWriter writer = new BufferedWriter(new FileWriter(file, StandardCharsets.US_ASCII)))
+        {
+            writer.write(content);
+            writer.newLine();
+        }
+        return file;
+    }
+
+    private static byte[] md5(final byte[] data)
+    {
+        try
+        {
+            return MessageDigest.getInstance("MD5").digest(data);
+        }
+        catch (NoSuchAlgorithmException e)
+        {
+            throw new AssertionError("MD5 must be available", e);
+        }
+    }
+
+    private static Logger timingLogger()
+    {
+        return LoggerFactory.getLogger(PasswordFilePrincipalDatabaseTimingTest.class);
+    }
+
+    /**
+     * Caller-defined (out-of-tree style) principal database that verifies passwords through the inherited
+     * {@link AbstractPasswordFilePrincipalDatabase#compareCharArray(char[], char[])}.
+     */
+    private static final class ThirdPartyPrincipalDatabase extends AbstractPasswordFilePrincipalDatabase<PlainUser>
+    {
+        private ThirdPartyPrincipalDatabase(final PasswordCredentialManagingAuthenticationProvider<?> provider)
+        {
+            super(provider);
+        }
+
+        @Override
+        public boolean verifyPassword(final String principal, final char[] password) throws AccountNotFoundException
+        {
+            final char[] stored = lookupPassword(principal);
+            if (stored == null)
+            {
+                throw new AccountNotFoundException(principal);
+            }
+            return compareCharArray(stored, password);
+        }
+
+        @Override
+        protected PlainUser createUserFromFileData(final String[] result)
+        {
+            return new PlainUser(result, getAuthenticationProvider());
+        }
+
+        @Override
+        protected PlainUser createUserFromPassword(final Principal principal, final char[] passwd)
+        {
+            return new PlainUser(principal.getName(), passwd, getAuthenticationProvider());
+        }
+
+        @Override
+        protected Logger getLogger()
+        {
+            return LoggerFactory.getLogger(ThirdPartyPrincipalDatabase.class);
+        }
+
+        @Override
+        public List<String> getMechanisms()
+        {
+            return List.of();
+        }
+
+        @Override
+        public SaslNegotiator createSaslNegotiator(final String mechanism, final SaslSettings saslSettings)
+        {
+            return null;
+        }
+    }
