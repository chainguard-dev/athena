+    /**
+     * Compares a stored password (or password digest) with a supplied one. The comparison takes time that depends
+     * only on the length of the stored operand: it neither stops at the first differing character nor returns
+     * early when the lengths differ, so its running time does not reveal how much of the stored value a candidate
+     * matches.
+     *
+     * @param a the stored password or digest
+     * @param b the supplied password or digest
+     *
+     * @return true if both arrays have the same length and contain the same characters
+     */
     protected boolean compareCharArray(char[] a, char[] b)
     {
-        boolean equal = false;
-        if (a.length == b.length)
+        return constantTimeEquals(a, b);
+    }
+
+    /**
+     * Compares a stored secret with a supplied candidate without an early exit. The loop always runs over the full
+     * length of the stored operand, accumulates the differences of the full 16-bit characters without branching on
+     * them, and folds the length difference into the verdict instead of returning early on it.
+     *
+     * @param stored   the stored secret; its length bounds the amount of work done
+     * @param supplied the candidate to check, typically attacker supplied
+     *
+     * @return true if both arrays have the same length and contain the same characters
+     */
+    private static boolean constantTimeEquals(final char[] stored, final char[] supplied)
+    {
+        final int storedLength = stored.length;
+        final int suppliedLength = supplied.length;
+        // An empty candidate is scanned against the stored secret itself so that the loop below still runs over
+        // the full stored length; the length term keeps the verdict false.
+        final char[] other = suppliedLength == 0 ? stored : supplied;
+        final int otherLength = other.length;
+        int difference = storedLength ^ suppliedLength;
+        for (int i = 0; i < storedLength; i++)
         {
-            equal = true;
-            int index = 0;
-            while (equal && index < a.length)
-            {
-                equal = a[index] == b[index];
-                index++;
-            }
+            difference |= stored[i] ^ other[candidateIndex(i, otherLength)];
         }
-        return equal;
+        return difference == 0;
+    }
+
+    /**
+     * Returns {@code i} when {@code i < length} and {@code 0} otherwise, without a branch, so that indexing the
+     * supplied operand never reads past its end while the scan runs over the stored operand's full length.
+     *
+     * @param i      the current position in the stored operand, never negative
+     * @param length the length of the operand being read (the supplied one, or the stored one when the supplied
+     *               one is empty), greater than zero whenever this method is called
+     *
+     * @return the position to read in the supplied operand
+     */
+    private static int candidateIndex(final int i, final int length)
+    {
+        return ((i - length) >>> 31) * i;
     }
 
