 .../main/java/com/auth0/jwt/TokenUtils.java   |  65 +++++-
 .../TokenUtilsHeapAmplificationRedTest.java   | 213 ++++++++++++++++++
 2 files changed, 270 insertions(+), 8 deletions(-)
