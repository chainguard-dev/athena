+    /**
+     * Deserializes the collection using default deserialization, then re-validates every restored
+     * element against the configured predicate.
+     * <p>
+     * Security fix (CGP-4p5c-894r-qqmc, CWE-502): {@code readObject} is an alternate construction
+     * path that bypasses the validating constructor. This class (and its subclasses, none of which
+     * declare their own {@code readObject}) previously relied on default deserialization, which
+     * restored the decorated collection without re-asserting the predicate. That let an
+     * attacker-controlled stream inject predicate-violating elements the constructor and every public
+     * mutator would reject. This method re-establishes the class invariant by running every restored
+     * element through the SAME {@link #validate(Object)} chokepoint the constructor and mutators use;
+     * a violation throws {@link IllegalArgumentException}, which propagates out to the
+     * {@link ObjectInputStream#readObject()} caller rather than handing back a live,
+     * predicate-violating instance.
+     *
+     * @param in  the input stream
+     * @throws IOException if an error occurs while reading from the stream
+     * @throws ClassNotFoundException if an object read from the stream cannot be loaded
+     */
+    private void readObject(final ObjectInputStream in) throws IOException, ClassNotFoundException {
+        in.defaultReadObject();
+        final Collection<E> restored = decorated();
+        if (restored != null) {
+            for (final E item : restored) {
+                validate(item);
+            }
+        }
+    }
