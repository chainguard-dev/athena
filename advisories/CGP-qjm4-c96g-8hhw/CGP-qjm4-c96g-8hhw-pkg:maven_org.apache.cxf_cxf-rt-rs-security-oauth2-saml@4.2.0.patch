+package org.apache.cxf.rs.security.saml;
+
+import java.util.Locale;
+import java.util.logging.Logger;
+
+import org.apache.cxf.common.logging.LogUtils;
+import org.apache.wss4j.common.saml.SamlAssertionWrapper;
+
+/**
+ * Shared, fail-closed decision point for whether an UNSIGNED SAML assertion may be trusted as proof
+ * of identity over a mutual-TLS connection (CGP-qjm4-c96g-8hhw / CWE-345, related
+ * CWE-287/346/347/940).
+ *
+ * <p>Historically both {@code Saml2BearerGrantHandler.validateToken} and
+ * {@code AbstractSamlInHandler.validateToken} accepted an unsigned assertion whenever the transport
+ * session presented <em>any</em> client TLS certificate ({@code getTLSCertificates(message) != null}).
+ * That is a channel property ("a two-way TLS handshake completed"), NOT proof of who the peer is
+ * claiming to be: any lower-trust party holding a certificate the container truststore accepts could
+ * submit an unsigned assertion naming any subject (including privileged accounts) and be authenticated
+ * as that subject.
+ *
+ * <p><b>Why "bind the TLS cert to the assertion's own key material" is not a fix.</b> An unsigned
+ * assertion is authored <em>in its entirety</em> by the sender: the {@code <Issuer>}, the
+ * {@code <Subject>} NameID that ultimately becomes the authenticated principal, the declared
+ * {@code SubjectConfirmation} method(s), and any {@code SubjectKeyInfo} are all attacker-controlled.
+ * Comparing the assertion's own {@code SubjectKeyInfo} to the presented TLS peer certificate is a
+ * tautology -- the attacker chooses both the certificate they present for the handshake and the key
+ * bytes they write into their own assertion, so they can always make the two match while writing any
+ * {@code <Subject>} NameID they like. Nothing in an unsigned assertion is authenticated by a trust
+ * anchor, so no field of it can establish that the presenter is the subject it names.
+ *
+ * <p><b>Invariant enforced here (fail closed).</b> An unsigned assertion is therefore never treated
+ * as proof of identity by default, regardless of which (or whether any) {@code SubjectConfirmation}
+ * method it declares -- Bearer, Sender-Vouches, Holder-of-Key, an unrecognized/custom method, or
+ * none. Identity over these paths must be established by a signature that chains to the configured
+ * {@code sigVerCrypto} trust anchor (the signed-assertion path, unchanged), i.e. the sender must
+ * demonstrate control of a key that a trust anchor vouches for -- exactly what an unsigned assertion
+ * cannot do.
+ *
+ * <p><b>Operator escape hatch.</b> A deployment that genuinely relies on the previous, weaker
+ * presence-only acceptance of unsigned assertions may re-enable it with the deployment-scoped system
+ * property {@value #ALLOW_UNBOUND_PROPERTY} set to an explicit affirmative ("true"/"1"/"yes"/"on").
+ * The default is off (secure); when engaged it logs a WARN naming the CVE/CWE so the weakened control
+ * is never silent. The property is read through a single strict true/false parser: every other value
+ * -- including {@code "false"}, {@code "0"}, empty, or junk -- leaves the protection ON (fail closed).
+ */
+public final class SamlTlsIdentityBinding {
+
+    /**
+     * Deployment-scoped escape hatch (default OFF). When set to an explicit affirmative, an unsigned
+     * assertion is accepted whenever any accepted TLS client certificate is present (the legacy,
+     * pre-CGP-qjm4-c96g-8hhw presence-only behavior). WARN-logged on every use.
+     */
+    public static final String ALLOW_UNBOUND_PROPERTY =
+        "org.apache.cxf.saml.allow-unbound-unsigned-assertion";
+
+    private static final Logger LOG = LogUtils.getL7dLogger(SamlTlsIdentityBinding.class);
+
+    private SamlTlsIdentityBinding() {
+    }
+
+    /**
+     * Decide whether an unsigned SAML assertion may be trusted as proof of identity.
+     *
+     * <p>This always returns {@code false} for an unsigned assertion: because the whole assertion is
+     * attacker-authored and nothing in it is authenticated by a trust anchor, no field of it (Issuer,
+     * Subject NameID, or SubjectConfirmation/SubjectKeyInfo) can establish that the presenter is the
+     * subject it names, no matter which confirmation method it declares. The caller must reject unless
+     * the operator has explicitly opted in via {@link #isUnboundAcceptanceAllowed()}.
+     *
+     * <p>The parameters are retained so that a future, genuinely-sound binding mechanism (e.g. an
+     * operator-configured mapping from a specific trusted certificate to a specific permitted
+     * subject/Issuer) could be added here without changing either sink; today none exists, so the
+     * method is fail closed.
+     *
+     * @return {@code false} always -- an unsigned assertion is never self-authenticating.
+     */
+    public static boolean isUnsignedAssertionTlsBound(SamlAssertionWrapper assertion,
+                                                      java.security.cert.Certificate[] tlsCerts,
+                                                      org.apache.wss4j.dom.handler.RequestData data) {
+        // Deliberately no accept branch: see the class javadoc. An unsigned assertion cannot bind its
+        // named identity to the verified TLS peer, so it is never trusted here.
+        return false;
+    }
+
+    /**
+     * @return {@code true} only when the operator has explicitly opted in to the legacy, weaker
+     *         presence-only acceptance of unsigned assertions. Logs a WARN on each engagement so the
+     *         weakened control is never silent.
+     */
+    public static boolean isUnboundAcceptanceAllowed() {
+        String value = getProperty(ALLOW_UNBOUND_PROPERTY);
+        if (parseStrictBoolean(value)) {
+            LOG.warning("SECURITY: '" + ALLOW_UNBOUND_PROPERTY + "' is enabled -- unsigned SAML "
+                + "assertions are accepted whenever any TLS client certificate is present, WITHOUT "
+                + "binding the TLS identity to the assertion's Subject/Issuer. This re-enables the "
+                + "impersonation weakness CGP-qjm4-c96g-8hhw (CWE-345) and must not be used in "
+                + "production.");
+            return true;
+        }
+        return false;
+    }
+
+    private static String getProperty(String key) {
+        try {
+            return System.getProperty(key);
+        } catch (SecurityException ex) {
+            return null;
+        }
+    }
+
+    /**
+     * The single strict boolean parse for every knob this fix introduces. Engages only on an explicit
+     * affirmative; {@code "false"}, {@code "0"}, empty, unset, and unparseable values all return
+     * {@code false} (protection ON).
+     */
+    static boolean parseStrictBoolean(String value) {
+        if (value == null) {
+            return false;
+        }
+        switch (value.trim().toLowerCase(Locale.ROOT)) {
+        case "1":
+        case "true":
+        case "yes":
+        case "on":
+            return true;
+        default:
+            return false;
+        }
+    }
+}
