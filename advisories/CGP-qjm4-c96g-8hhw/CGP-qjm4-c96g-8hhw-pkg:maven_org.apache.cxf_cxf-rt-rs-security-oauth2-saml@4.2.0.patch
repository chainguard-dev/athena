+    private static boolean isAuthRejection(Throwable ex) {
+        for (Throwable t = ex; t != null; t = t.getCause()) {
+            String n = t.getClass().getName();
+            if (n.contains("NotAuthorized") || n.contains("WSSecurityException")
+                || t instanceof OAuthServiceException) {
+                return true;
+            }
+        }
+        return false;
+    }
