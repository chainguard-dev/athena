+    private Element buildUnsignedHolderOfKeyAssertionElement(String subject, String issuer,
+                                                             String audience,
+                                                             X509Certificate keyInfoCert) throws Exception {
+        UnsignedSamlCallbackHandler callbackHandler = new UnsignedSamlCallbackHandler(
+            subject, issuer, audience, SAML2Constants.CONF_HOLDER_KEY, keyInfoCert);
+        SAMLCallback samlCallback = new SAMLCallback();
+        SAMLUtil.doSAMLCallback(callbackHandler, samlCallback);
+        SamlAssertionWrapper assertion = new SamlAssertionWrapper(samlCallback);
+        // Deliberately NO signAssertion(...) call -- the assertion is left unsigned.
