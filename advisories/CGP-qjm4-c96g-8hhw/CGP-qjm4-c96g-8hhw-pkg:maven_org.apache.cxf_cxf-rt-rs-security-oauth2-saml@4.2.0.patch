+    /** Builds a well-formed but UNSIGNED SAML assertion element (the exploit never signs it). */
+    private Element buildUnsignedAssertionElement(String subject, String issuer, String audience,
+                                                  String confirmationMethod) throws Exception {
+        UnsignedSamlCallbackHandler callbackHandler =
+            new UnsignedSamlCallbackHandler(subject, issuer, audience, confirmationMethod);
+        SAMLCallback samlCallback = new SAMLCallback();
+        SAMLUtil.doSAMLCallback(callbackHandler, samlCallback);
+        SamlAssertionWrapper assertion = new SamlAssertionWrapper(samlCallback);
