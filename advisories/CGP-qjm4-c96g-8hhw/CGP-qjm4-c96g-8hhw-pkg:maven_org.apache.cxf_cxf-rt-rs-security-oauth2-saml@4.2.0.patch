+    /** Builds a well-formed SIGNED SAML assertion whose signing certificate is {@code alias} from
+     *  {@code signer}. Used only by the signed-path preservation control -- the fix must not touch
+     *  this path. */
+    private Element buildSignedAssertionElement(String subject, String issuer, String audience,
+                                               Crypto signer, String alias) throws Exception {
+        ExploitSamlCallbackHandler callbackHandler =
+            new ExploitSamlCallbackHandler(subject, issuer, audience);
+        SAMLCallback samlCallback = new SAMLCallback();
+        SAMLUtil.doSAMLCallback(callbackHandler, samlCallback);
+        SamlAssertionWrapper assertion = new SamlAssertionWrapper(samlCallback);
