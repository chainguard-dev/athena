+    private Message newMessageWithTlsCerts(Crypto sigVerCrypto, Certificate[] tlsCerts) {
+        Message m = new MessageImpl();
+        Exchange e = new ExchangeImpl();
+        e.put(Bus.class, BusFactory.getThreadDefaultBus());
+        m.setExchange(e);
+        e.setInMessage(m);
+        m.put(SecurityConstants.SIGNATURE_CRYPTO, sigVerCrypto);
+        // A documented SAML-over-mTLS deployment that accepts unsigned assertions to populate the
+        // principal. This property gates whether an unsigned assertion's principal may be USED; it
+        // performs NO binding between the TLS client identity and the assertion's Subject/Issuer --
+        // which is exactly the control this finding shows is missing. With it enabled the vulnerable
+        // validateToken's acceptance materializes as a concrete harm (token issued / SecurityContext
+        // installed for the attacker-chosen subject) rather than a null downstream context.
+        m.put(SecurityConstants.ENABLE_UNSIGNED_SAML_ASSERTION_PRINCIPAL, "true");
+        if (tlsCerts != null) {
+            TLSSessionInfo tlsInfo = new TLSSessionInfo("TLS", null, tlsCerts);
+            m.put(TLSSessionInfo.class, tlsInfo);
+        }
+        return m;
+    }
