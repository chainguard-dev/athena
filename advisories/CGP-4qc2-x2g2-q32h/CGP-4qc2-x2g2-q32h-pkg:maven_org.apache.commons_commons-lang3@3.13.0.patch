+    /** {@code Thread.threadLocalRandomSeed} is the entire mutable state of the calling thread's TLR. */
+    private static Field threadLocalRandomSeedField() throws Exception {
+        final Field f = Thread.class.getDeclaredField("threadLocalRandomSeed");
+        f.setAccessible(true);
+        return f;
+    }
