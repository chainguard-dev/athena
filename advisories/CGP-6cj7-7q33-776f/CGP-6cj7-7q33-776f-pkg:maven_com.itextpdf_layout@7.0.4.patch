+    /**
+     * A dead-simple loopback HTTP server. Any inbound connection is recorded (proving an
+     * outbound fetch fired -- SSRF / OOB) and answered with a harmless empty DTD so the
+     * parser does not blow up before we can observe the hit.
+     */
+    private static final class Sink implements Runnable, AutoCloseable {
+        final ServerSocket server;
+        final List<String> requestLines = new CopyOnWriteArrayList<>();
+        final AtomicBoolean stop = new AtomicBoolean(false);
+        final Thread thread;
+
+        Sink() throws IOException {
+            server = new ServerSocket();
+            server.setReuseAddress(true);
+            server.bind(new InetSocketAddress("127.0.0.1", 0));
+            server.setSoTimeout(500);
+            thread = new Thread(this, "xxe-sink");
+            thread.setDaemon(true);
+            thread.start();
+        }
+
+        int port() { return server.getLocalPort(); }
+        boolean wasHit() { return !requestLines.isEmpty(); }
+
+        public void run() {
+            while (!stop.get()) {
+                try (Socket s = server.accept()) {
+                    byte[] buf = new byte[1024];
+                    int n = s.getInputStream().read(buf);
+                    if (n > 0) {
+                        requestLines.add(new String(buf, 0, n, StandardCharsets.ISO_8859_1).split("\r\n")[0]);
+                    }
+                    // Return an empty but well-formed DTD body.
+                    OutputStream out = s.getOutputStream();
+                    byte[] body = "<!-- -->".getBytes(StandardCharsets.ISO_8859_1);
+                    out.write(("HTTP/1.0 200 OK\r\nContent-Length: " + body.length + "\r\n\r\n").getBytes(StandardCharsets.ISO_8859_1));
+                    out.write(body);
+                    out.flush();
+                } catch (IOException ignored) {
+                    // accept timeout or client reset -- keep looping
+                }
+            }
+        }
+
+        public void close() {
+            stop.set(true);
+            try { server.close(); } catch (IOException ignored) {}
+        }
+    }
