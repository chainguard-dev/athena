+    private static final class CapturingConsumer implements IPatternConsumer {
+        final List<String> captured = new ArrayList<>();
+        public void addClass(String chargroup) { captured.add(chargroup); }
+        public void addException(String word, List hyphenatedword) { captured.add(word); }
+        public void addPattern(String pattern, String values) { captured.add(pattern); }
+        String all() {
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < captured.size(); i++) {
+                if (i > 0) { sb.append('|'); }
