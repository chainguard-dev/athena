+    // ------------------------------------------------------------------
+    @Test
+    public void fieldProcessMessageComponentsWithManyOccurrencesDoesNotBlowStack() throws Exception {
+        final int n = 15000;
+        final String tokenName = "myConst";
+        final String token = "${" + tokenName + "}";
+        final StringBuilder sb = new StringBuilder(token.length() * n);
+        for (int i = 0; i < n; i++) {
+            sb.append(token);
+        }
+
+        final Field field = new Field();
+        field.setProperty("unrelated");
+        final Msg msg = new Msg();
+        msg.setName("msg1");
+        msg.setKey(sb.toString());
+        field.addMsg(msg);
+
+        final Map<String, String> constants = new HashMap<String, String>();
+        constants.put(tokenName, "X");
+        final Map<String, String> globalConstants = new HashMap<String, String>();
+
+        final Outcome o = runBounded(new Callable<String>() {
+            @Override
+            public String call() {
+                invokeProcess(field, globalConstants, constants);
+                return field.getMsg("msg1");
+            }
+        });
+        assertNoStackExhaustion(o, "field-processMessageComponents-many-occurrences");
+        assertEquals(n, o.result.length());
+    }
+
+    // ------------------------------------------------------------------
+    // (5) Enumerated caller site Field.processArg (Field.java:658).
+    // ------------------------------------------------------------------
+    @Test
+    public void fieldProcessArgWithManyOccurrencesDoesNotBlowStack() throws Exception {
+        final int n = 15000;
+        final String tokenName = "myConst";
+        final String token = "${" + tokenName + "}";
+        final StringBuilder sb = new StringBuilder(token.length() * n);
+        for (int i = 0; i < n; i++) {
+            sb.append(token);
+        }
+
+        final Field field = new Field();
+        field.setProperty("unrelated");
+        final Arg arg = new Arg();
+        arg.setKey(sb.toString());
+        arg.setPosition(0);
+        field.addArg(arg);
+
+        final Map<String, String> constants = new HashMap<String, String>();
+        constants.put(tokenName, "X");
+        final Map<String, String> globalConstants = new HashMap<String, String>();
+
+        final Outcome o = runBounded(new Callable<String>() {
+            @Override
+            public String call() {
+                invokeProcess(field, globalConstants, constants);
+                return field.getArg(0).getKey();
+            }
+        });
+        assertNoStackExhaustion(o, "field-processArg-many-occurrences");
+        assertEquals(n, o.result.length());
+    }
+
+    // ------------------------------------------------------------------
+    // (6) The exact key shape used by ValidatorAction.handleIndexedField
+    // (ValidatorAction.java:741) — key = Field.TOKEN_INDEXED ("[]"), many
+    // occurrences in the field key.
+    // ------------------------------------------------------------------
+    @Test
+    public void tokenIndexedKeyShapeWithManyOccurrencesDoesNotBlowStack() throws Exception {
+        final int n = 15000;
+        final String key = Field.TOKEN_INDEXED; // "[]"
+        final StringBuilder sb = new StringBuilder(key.length() * n);
+        for (int i = 0; i < n; i++) {
+            sb.append(key);
+        }
+        final String fieldKey = sb.toString();
+
+        final Outcome o = runBounded(new Callable<String>() {
+            @Override
+            public String call() {
+                return ValidatorUtils.replace(fieldKey, key, "[3]");
+            }
+        });
+        assertNoStackExhaustion(o, "token-indexed-key-shape");
+        assertEquals(n * "[3]".length(), o.result.length());
+    }
+
+    /** Invoke the package-private Field.process(Map,Map) reflectively (same pattern as RED). */
+    private static void invokeProcess(Field field, Map<String, String> globalConstants, Map<String, String> constants) {
+        try {
+            Method m = Field.class.getDeclaredMethod("process", Map.class, Map.class);
+            m.setAccessible(true);
+            m.invoke(field, globalConstants, constants);
+        } catch (java.lang.reflect.InvocationTargetException ite) {
+            Throwable cause = ite.getCause();
+            if (cause instanceof Error) {
+                throw (Error) cause;
+            }
+            if (cause instanceof RuntimeException) {
+                throw (RuntimeException) cause;
+            }
+            throw new RuntimeException(cause);
+        } catch (ReflectiveOperationException roe) {
+            throw new RuntimeException(roe);
+        }
+    }
+}
