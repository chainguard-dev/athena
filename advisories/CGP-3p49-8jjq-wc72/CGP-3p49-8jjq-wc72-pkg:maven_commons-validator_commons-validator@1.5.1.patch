+/**
+ * Bypass-hunt probes for CGP-3p49-8jjq-wc72 (CWE-674) against the PATCHED
+ * {@link ValidatorUtils#replace(String, String, String)}. Exercises: (a) an
+ * order-of-magnitude larger occurrence count than RED's N=15000, (b) the
+ * zero-length-key degenerate case on a much larger value, (c) the three
+ * enumerated caller sites RED did not individually exercise
+ * (Field.processVars / Field.processMessageComponents / Field.processArg),
+ * and (d) the exact TOKEN_INDEXED ("[]") key shape used by
+ * ValidatorAction.handleIndexedField. All are expected to PASS (no
+ * StackOverflowError / hang) on the patched build if the fix is complete.
+ */
+public class ValidatorUtilsReplaceBypassTest {
+
+    private static final long JOIN_TIMEOUT_MS = 30000L;
+
+    private static final class Outcome {
+        final String result;
+        final Throwable thrown;
+        final boolean finished;
+        Outcome(final String result, final Throwable thrown, final boolean finished) {
+            this.result = result;
+            this.thrown = thrown;
+            this.finished = finished;
+        }
+    }
+
+    private static Outcome runBounded(final Callable<String> body) throws InterruptedException {
+        final AtomicReference<String> out = new AtomicReference<String>();
+        final AtomicReference<Throwable> err = new AtomicReference<Throwable>();
+        final Thread t = new Thread(new Runnable() {
+            @Override
+            public void run() {
+                try {
+                    out.set(body.call());
+                } catch (final Throwable th) {
+                    err.set(th);
+                }
+            }
+        }, "replace-bypass-worker");
+        t.setUncaughtExceptionHandler(new Thread.UncaughtExceptionHandler() {
+            @Override
+            public void uncaughtException(final Thread th, final Throwable ex) {
+                err.compareAndSet(null, ex);
+            }
+        });
+        t.start();
+        t.join(JOIN_TIMEOUT_MS);
+        final boolean finished = !t.isAlive();
+        if (!finished) {
+            t.interrupt();
+        }
+        return new Outcome(out.get(), err.get(), finished);
+    }
+
+    private static void assertNoStackExhaustion(final Outcome o, final String route) {
+        if (!o.finished) {
+            fail(route + ": did not terminate within " + JOIN_TIMEOUT_MS + "ms");
+        }
+        if (o.thrown instanceof StackOverflowError) {
+            fail(route + ": threw StackOverflowError — unbounded recursion still reachable");
+        }
+        if (o.thrown != null) {
+            fail(route + ": threw unexpected " + o.thrown);
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // (1) An order of magnitude beyond RED's documented N=15,000.
+    // ------------------------------------------------------------------
+    @Test
+    public void directReplaceWithVeryLargeOccurrenceCount() throws Exception {
+        final int n = 200000;
+        final String key = "${var}";
+        final StringBuilder sb = new StringBuilder(key.length() * n);
+        for (int i = 0; i < n; i++) {
+            sb.append(key);
+        }
+        final String value = sb.toString();
+
+        final Outcome o = runBounded(new Callable<String>() {
+            @Override
+            public String call() {
+                return ValidatorUtils.replace(value, key, "X");
+            }
+        });
+        assertNoStackExhaustion(o, "direct-200k-occurrences");
+        assertEquals(n, o.result.length());
+        boolean allX = true;
+        for (int i = 0; i < o.result.length(); i++) {
+            if (o.result.charAt(i) != 'X') {
+                allX = false;
+                break;
+            }
+        }
+        assertTrue(allX);
+    }
+
+    // ------------------------------------------------------------------
+    // (2) Zero-length key on a much larger value than RED's "abc".
+    // ------------------------------------------------------------------
+    @Test
+    public void directReplaceWithZeroLengthKeyOnLargeValue() throws Exception {
+        final StringBuilder sb = new StringBuilder(100000);
+        for (int i = 0; i < 100000; i++) {
