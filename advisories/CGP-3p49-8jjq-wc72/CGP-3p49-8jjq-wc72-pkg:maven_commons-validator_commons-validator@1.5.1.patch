+            sb.append(token);
+        }
+
+        final Field field = new Field();
+        field.setProperty("unrelated"); // keep property substitution out of this probe
+        field.addVar("someVar", sb.toString(), "int"); // Var.value carries the N-occurrence payload
+
+        final Map<String, String> constants = new HashMap<String, String>();
+        constants.put(tokenName, "X");
+        final Map<String, String> globalConstants = new HashMap<String, String>();
+
+        final Outcome o = runBounded(new Callable<String>() {
+            @Override
+            public String call() {
+                invokeProcess(field, globalConstants, constants);
+                return field.getVarValue("someVar");
+            }
+        });
+        assertNoStackExhaustion(o, "field-processVars-many-occurrences");
+        assertEquals(n, o.result.length());
+    }
