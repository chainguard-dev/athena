+package org.apache.commons.validator.util;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.fail;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+
+import org.apache.commons.validator.Field;
+import org.junit.Test;
+
+/**
+ * Exploit harness for CGP-3p49-8jjq-wc72 (CWE-674 — Uncontrolled Recursion in
+ * {@link ValidatorUtils#replace(String, String, String)}).
+ *
+ * <p>{@code ValidatorUtils.replace} performs string substitution with unbounded
+ * self-recursion: one stack frame per occurrence of {@code key} in {@code value}.
+ * A {@code value} carrying tens of thousands of occurrences of {@code key} drives
+ * recursion depth == occurrence count, exhausting the JVM thread stack and throwing
+ * {@link StackOverflowError}. The zero-length-key case makes zero forward progress
+ * per call and recurses without bound even for a tiny input.</p>
+ *
+ * <p>Each dangerous call is executed on a dedicated worker thread with the default
+ * stack size, and any {@link Throwable} that escapes is captured via an
+ * uncaught-exception handler so the assertion targets the SPECIFIC harmful effect
+ * ({@code StackOverflowError} escaping) rather than using a catch-all. A bounded
+ * join also catches an iterative-but-hanging (infinite-loop / quadratic) mis-fix.
+ * On the UNPATCHED build the StackOverflowError-detecting tests FAIL (RED); once
+ * {@code replace} no longer consumes stack proportional to occurrence count they
+ * PASS (GREEN).</p>
+ */
+public class ValidatorUtilsReplaceTest {
+
+    /** Documented payload: 10,000+ repeated occurrences of the placeholder token. */
+    private static final int OCCURRENCES = 15000;
+
+    /** Wall-clock bound so an iterative-but-hanging (infinite/quadratic) mis-fix is also caught. */
+    private static final long JOIN_TIMEOUT_MS = 30000L;
+
+    /** Result of running a payload on a worker thread. */
+    private static final class Outcome {
+        final String result;
+        final Throwable thrown;
+        final boolean finished;
+        Outcome(final String result, final Throwable thrown, final boolean finished) {
+            this.result = result;
+            this.thrown = thrown;
+            this.finished = finished;
+        }
+    }
+
+    /**
+     * Run {@code body} on a fresh thread with the default stack size, capturing any
+     * escaping {@link Throwable}. Returns whether it finished within the wall-clock bound.
+     */
+    private static Outcome runBounded(final java.util.concurrent.Callable<String> body) throws InterruptedException {
+        final AtomicReference<String> out = new AtomicReference<String>();
+        final AtomicReference<Throwable> err = new AtomicReference<Throwable>();
+        final Thread t = new Thread(new Runnable() {
+            @Override
+            public void run() {
+                try {
+                    out.set(body.call());
+                } catch (final Throwable th) {
+                    err.set(th);
+                }
+            }
+        }, "replace-exploit-worker");
+        // Also catch anything the try/catch above cannot (defensive).
+        t.setUncaughtExceptionHandler(new Thread.UncaughtExceptionHandler() {
+            @Override
+            public void uncaughtException(final Thread th, final Throwable ex) {
+                err.compareAndSet(null, ex);
+            }
+        });
+        t.start();
+        t.join(JOIN_TIMEOUT_MS);
+        final boolean finished = !t.isAlive();
+        if (!finished) {
+            t.interrupt();
+        }
+        return new Outcome(out.get(), err.get(), finished);
+    }
+
+    private static void assertNoStackExhaustion(final Outcome o, final String route) {
+        if (!o.finished) {
+            fail(route + ": ValidatorUtils.replace did not terminate within " + JOIN_TIMEOUT_MS
+                    + "ms (unbounded loop/quadratic mis-fix) — CWE-674");
+        }
+        if (o.thrown instanceof StackOverflowError) {
+            fail(route + ": ValidatorUtils.replace threw StackOverflowError — unbounded recursion, "
+                    + "one stack frame per key occurrence (CWE-674)");
+        }
+        if (o.thrown != null) {
+            fail(route + ": ValidatorUtils.replace threw unexpected " + o.thrown);
+        }
+    }
+
+    // ---------------------------------------------------------------------------
+    // Primary exploit — DIRECT public-API route (proves the fix lives in the utility,
+    // not only at the Field/ValidatorAction call sites).
+    // ---------------------------------------------------------------------------
+
+    @Test
+    public void directReplaceWithManyOccurrencesDoesNotBlowStack() throws Exception {
+        final String key = "${var}";
+        final StringBuilder sb = new StringBuilder(key.length() * OCCURRENCES);
+        for (int i = 0; i < OCCURRENCES; i++) {
+            sb.append(key);
+        }
+        final String value = sb.toString(); // '${var}' repeated 15,000 times
+
+        final Outcome o = runBounded(new java.util.concurrent.Callable<String>() {
+            @Override
+            public String call() {
+                return ValidatorUtils.replace(value, key, "X");
+            }
+        });
+
+        assertNoStackExhaustion(o, "direct-many-occurrences");
+        // Content check: a fix that returns wrong/truncated output for huge N must also fail.
+        final StringBuilder expected = new StringBuilder(OCCURRENCES);
+        for (int i = 0; i < OCCURRENCES; i++) {
+            expected.append('X');
+        }
+        assertEquals("direct-many-occurrences: replacement result incorrect",
+                expected.toString(), o.result);
+    }
+
+    // ---------------------------------------------------------------------------
+    // Enumerated pipeline route — through Field.process() (sink caller, Field.java:576).
+    // Proves the pipeline-level route is fixed too, not only the direct call.
+    // ---------------------------------------------------------------------------
+
+    @Test
+    public void fieldProcessWithManyOccurrencesDoesNotBlowStack() throws Exception {
+        final String tokenName = "myConst";
+        final String token = "${" + tokenName + "}"; // key2 built by Field.process
+        final StringBuilder sb = new StringBuilder(token.length() * OCCURRENCES);
+        for (int i = 0; i < OCCURRENCES; i++) {
+            sb.append(token);
+        }
+
+        final Field field = new Field();
+        field.setProperty(sb.toString()); // property = '${myConst}' x 15,000
+
+        final Map<String, String> constants = new HashMap<String, String>();
+        constants.put(tokenName, "X");           // -> key2 = ${myConst}, replaceValue = X
+        final Map<String, String> globalConstants = new HashMap<String, String>();
+
+        final Outcome o = runBounded(new java.util.concurrent.Callable<String>() {
+            @Override
+            public String call() {
+                // Field.process is package-private; this test lives in a subpackage,
+                // so invoke it reflectively to drive the real pipeline sink (line 576).
+                try {
+                    java.lang.reflect.Method m = Field.class.getDeclaredMethod(
+                            "process", Map.class, Map.class);
+                    m.setAccessible(true);
+                    m.invoke(field, globalConstants, constants);
+                } catch (java.lang.reflect.InvocationTargetException ite) {
+                    Throwable cause = ite.getCause();
+                    if (cause instanceof Error) {
+                        throw (Error) cause;
+                    }
+                    if (cause instanceof RuntimeException) {
+                        throw (RuntimeException) cause;
+                    }
+                    throw new RuntimeException(cause);
+                } catch (ReflectiveOperationException roe) {
+                    throw new RuntimeException(roe);
+                }
+                return field.getProperty();
+            }
+        });
+
+        assertNoStackExhaustion(o, "field-process-many-occurrences");
+        final StringBuilder expected = new StringBuilder(OCCURRENCES);
+        for (int i = 0; i < OCCURRENCES; i++) {
+            expected.append('X');
+        }
+        assertEquals("field-process-many-occurrences: property not fully substituted",
+                expected.toString(), o.result);
+    }
+
+    // ---------------------------------------------------------------------------
+    // Non-enumerated degenerate route — zero-length key. No forward progress per call:
+    // recurses/loops without bound even for a tiny value (distinct from "many
+    // occurrences"). ## Analyze's payload list only covers repeated non-empty keys.
+    // ---------------------------------------------------------------------------
+
+    @Test
+    public void directReplaceWithZeroLengthKeyTerminates() throws Exception {
+        final Outcome o = runBounded(new java.util.concurrent.Callable<String>() {
+            @Override
+            public String call() {
+                return ValidatorUtils.replace("abc", "", "X");
+            }
+        });
+        assertNoStackExhaustion(o, "zero-length-key");
+        // The exact output of empty-key replacement is a fix-design choice; the invariant
+        // is termination in bounded resources. We only require the call returns non-null.
+        if (o.result == null) {
+            fail("zero-length-key: replace returned null for a non-null value");
+        }
+    }
+
+    // ---------------------------------------------------------------------------
+    // Positive-control tests — pin existing semantics so a fix that breaks normal
+    // use also fails this suite. These pass on the unpatched build.
+    // ---------------------------------------------------------------------------
+
+    @Test
+    public void nullArgumentsReturnValueUnchanged() {
+        assertNull(ValidatorUtils.replace(null, "a", "b"));
+        assertEquals("abc", ValidatorUtils.replace("abc", null, "b"));
+        assertEquals("abc", ValidatorUtils.replace("abc", "a", null));
+    }
+
+    @Test
+    public void smallLegitimateSubstitutionIsCorrect() {
+        // 3 occurrences fully and correctly substituted.
+        assertEquals("XbXbX", ValidatorUtils.replace("aba" + "ba", "a", "X"));
+        assertEquals("Q Q Q", ValidatorUtils.replace("k k k", "k", "Q"));
+    }
+
+    @Test
+    public void exactMatchAndTailOccurrenceSemantics() {
+        // value exactly equals key
+        assertEquals("REP", ValidatorUtils.replace("KEY", "KEY", "REP"));
+        // key at the tail of value
