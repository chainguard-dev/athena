+package com.github.tomakehurst.wiremock.common;
+
+import com.github.tomakehurst.wiremock.security.NotAuthorisedException;
+import com.google.common.io.Files;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+
+import static com.google.common.base.Charsets.UTF_8;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.junit.Assert.fail;
+
+/**
+ * A ClasspathFileSource backed by a directory on the file system must not read files outside
+ * that directory, including files in sibling directories whose names start with the root's name.
+ */
+public class ClasspathFileSourceContainmentTest {
+
+    @Rule
+    public TemporaryFolder temporaryFolder = new TemporaryFolder();
+
+    private File root;
+    private ClasspathFileSource source;
+
+    @Before
+    public void init() throws Exception {
+        File base = temporaryFolder.newFolder("base");
+        root = new File(base, "__files");
+        File sibling = new File(base, "__files-archive");
+        File nested = new File(root, "nested");
+        assertThat(nested.mkdirs(), is(true));
+        assertThat(sibling.mkdirs(), is(true));
+
+        Files.write("inside", new File(root, "inside.txt"), UTF_8);
+        Files.write("nested-inside", new File(nested, "inside.txt"), UTF_8);
+        Files.write("secret-sibling", new File(sibling, "secret.txt"), UTF_8);
+        Files.write("secret-parent", new File(base, "secret.txt"), UTF_8);
+
+        // An absolute path is not found on the classpath, so the source is backed by that directory
+        source = new ClasspathFileSource(root.getAbsolutePath());
+    }
+
+    @Test
+    public void readsTopLevelFile() {
+        assertThat(new String(source.getBinaryFileNamed("inside.txt").readContents(), UTF_8), is("inside"));
+        assertThat(source.getTextFileNamed("inside.txt").readContentsAsString(), is("inside"));
+    }
+
+    @Test
+    public void readsNestedFile() {
+        assertThat(new String(source.getBinaryFileNamed("nested/inside.txt").readContents(), UTF_8), is("nested-inside"));
+        assertThat(source.getTextFileNamed("nested/inside.txt").readContentsAsString(), is("nested-inside"));
+    }
+
+    @Test
+    public void readsFileNamedWithLeadingSeparator() {
+        assertThat(source.getTextFileNamed("/inside.txt").readContentsAsString(), is("inside"));
+    }
+
+    @Test
+    public void binaryReadRejectsTraversalOutOfRoot() {
+        assertBinaryRejected("../secret.txt");
+    }
+
+    @Test
+    public void textReadRejectsTraversalOutOfRoot() {
+        assertTextRejected("../secret.txt");
+    }
+
+    @Test
+    public void binaryReadRejectsSiblingDirectorySharingRootNamePrefix() {
+        assertBinaryRejected("../__files-archive/secret.txt");
+    }
+
+    @Test
+    public void textReadRejectsSiblingDirectorySharingRootNamePrefix() {
+        assertTextRejected("../__files-archive/secret.txt");
+    }
+
+    private void assertBinaryRejected(String name) {
+        try {
+            byte[] contents = source.getBinaryFileNamed(name).readContents();
+            fail("Expected " + name + " to be rejected but read " + new String(contents, UTF_8));
+        } catch (NotAuthorisedException expected) {
+            // expected
+        }
+    }
+
+    private void assertTextRejected(String name) {
+        try {
+            String contents = source.getTextFileNamed(name).readContentsAsString();
+            fail("Expected " + name + " to be rejected but read " + contents);
+        } catch (NotAuthorisedException expected) {
+            // expected
+        }
+    }
+}
