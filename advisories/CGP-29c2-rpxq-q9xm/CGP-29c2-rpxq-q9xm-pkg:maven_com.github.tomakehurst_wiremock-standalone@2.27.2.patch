+    private void assertFilePathIsUnderRoot(String name) {
+        try {
+            String rootPath = rootDirectory.getCanonicalPath();
+            // Check the same path the readers open: the name is always joined to the root.
+            String filePath = new File(rootDirectory, name).getCanonicalPath();
+
+            if (!filePath.equals(rootPath) && !filePath.startsWith(rootPath + File.separator)) {
+                throw new NotAuthorisedException("Access to file " + name + " is not permitted");
+            }
+        } catch (IOException ioe) {
+            throw new NotAuthorisedException("File " + name + " cannot be accessed", ioe);
+        }
+    }
