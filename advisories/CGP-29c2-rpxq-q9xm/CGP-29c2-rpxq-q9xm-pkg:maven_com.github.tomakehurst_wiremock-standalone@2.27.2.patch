+package com.github.tomakehurst.wiremock.admin;
+
+import com.github.tomakehurst.wiremock.WireMockServer;
+import com.github.tomakehurst.wiremock.common.SingleRootFileSource;
+import com.github.tomakehurst.wiremock.security.NotAuthorisedException;
+import com.github.tomakehurst.wiremock.testsupport.WireMockResponse;
+import com.github.tomakehurst.wiremock.testsupport.WireMockTestClient;
+import org.junit.After;
+import org.junit.Assume;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.nio.file.Files;
+
+import static com.github.tomakehurst.wiremock.core.WireMockConfiguration.wireMockConfig;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+/**
+ * Sibling-directory escape tests (CWE-22 / CWE-73) driven through the real Jetty HTTP stack and the
+ * real admin router (AdminRoutes / AdminUriTemplate / AdminRequestHandler), rather than by calling
+ * EditStubFileTask.execute() directly. AdminUriTemplate.matches()/parse() split both the template and
+ * the URL on "/" and require an exact segment count, so these tests check that a literal or
+ * percent-encoded traversal payload in the URL path either does not route to the file sink at all,
+ * or routes to it and is still refused by the containment check. Either way, no file outside the
+ * __files root may be modified.
+ */
+public class AdminApiFileTraversalHttpTest {
+
+    @Rule
+    public TemporaryFolder temp = new TemporaryFolder();
+
+    private WireMockServer wm;
+    private WireMockTestClient client;
+
+    private File filesRootDir;   // <root>
+    private File filesDir;       // <root>/__files
+    private File archiveSibling; // <root>/__files-archive
+    private File secret;         // <root>/__files-archive/secret.txt
+
+    @Before
+    public void setUp() throws Exception {
+        filesRootDir = temp.newFolder("filesRoot");
+        filesDir = new File(filesRootDir, "__files");
+        assertTrue(filesDir.mkdirs());
+
+        archiveSibling = new File(filesRootDir, "__files-archive");
+        assertTrue(archiveSibling.mkdirs());
+        secret = new File(archiveSibling, "secret.txt");
+        Files.write(secret.toPath(), "TOP-SECRET-HTTP".getBytes("UTF-8"));
+
+        wm = new WireMockServer(wireMockConfig().dynamicPort().withRootDirectory(filesRootDir.getAbsolutePath()));
+        wm.start();
+        client = new WireMockTestClient(wm.port());
+    }
+
+    @After
+    public void tearDown() {
+        wm.stop();
+    }
+
+    private String secretContents() throws Exception {
+        return new String(Files.readAllBytes(secret.toPath()), "UTF-8");
+    }
+
+    // ---------------------------------------------------------- WRITE via real HTTP: literal slashes
+
+    /**
+     * Literal (unencoded) "../" sibling-collision payload as the raw {filename} path segment of a
+     * real HTTP PUT. Whatever the router does with it (404/not-matched, or a route match that then
+     * hits assertFilePathIsUnderRoot), the sibling secret must never be overwritten.
+     */
+    @Test
+    public void httpPutWithLiteralTraversalDoesNotOverwriteSibling() throws Exception {
+        WireMockResponse response = client.putWithBody(
+                "/__admin/files/../__files-archive/secret.txt", "INJECTED-LITERAL", "text/plain");
+
+        assertThat("SECURITY: sibling file must be untouched after an HTTP PUT traversal attempt (status "
+                        + response.statusCode() + ")",
+                secretContents(), is("TOP-SECRET-HTTP"));
+    }
+
+    // ------------------------------------------------------ WRITE via real HTTP: percent-encoded "/"
+
+    /**
+     * Percent-encoded "../" sibling-collision payload ("..%2F__files-archive%2Fsecret.txt"). Since
+     * AdminRequestHandler.getUrl() reads HttpServletRequest.getRequestURI() (the RAW, un-decoded URI
+     * per servlet spec) and AdminUriTemplate.matches()/parse() split on a literal "/", an encoded "/"
+     * inside {filename} could -- in principle -- make the whole payload look like ONE path segment
+     * to the router (matching "/files/{filename}") while still smuggling an embedded separator. This
+     * probes whether that lets the payload route to EditStubFileTask AND whether the value handed to
+     * fileSource.writeBinaryFile() ever gets decoded into a real "/" before reaching
+     * assertFilePathIsUnderRoot (it must not, or the guard is checking a different string than the
+     * one that lands on disk).
+     */
+    @Test
+    public void httpPutWithPercentEncodedTraversalDoesNotOverwriteSibling() throws Exception {
+        WireMockResponse response = client.putWithBody(
+                "/__admin/files/..%2F__files-archive%2Fsecret.txt", "INJECTED-ENCODED", "text/plain");
+
+        assertThat("SECURITY: sibling file must be untouched after an HTTP PUT percent-encoded traversal "
+                        + "attempt (status " + response.statusCode() + ")",
+                secretContents(), is("TOP-SECRET-HTTP"));
+
+        // Diagnostic: confirm the write, if it succeeded (200), landed at a LITERAL filename
+        // (containing "%2F" as three literal characters) directly inside __files -- proving the
+        // router matched this as ONE path segment but nothing downstream ever decoded it into a
+        // real separator, so it cannot reach the sibling. Recursively dump what actually exists
+        // under __files so a reviewer can see there is no escape, not just that the secret is intact.
+        StringBuilder listing = new StringBuilder();
+        dumpTree(filesDir, listing);
+        System.out.println("__files tree after encoded PUT:\n" + listing);
+        File literalInRoot = new File(filesDir, "..%2F__files-archive%2Fsecret.txt");
+        if (response.statusCode() == 200) {
+            assertThat("the write landed at the literal (undecoded) filename INSIDE __files, not the sibling",
+                    literalInRoot.exists(), is(true));
+        }
+    }
+
+    private static void dumpTree(File dir, StringBuilder out) {
+        File[] children = dir.listFiles();
+        if (children == null) {
+            return;
+        }
+        for (File child : children) {
+            out.append(child.getPath()).append('\n');
+            if (child.isDirectory()) {
+                dumpTree(child, out);
+            }
+        }
+    }
+
+    /** Double-encoded variant ("%252e%252e%252f..."), in case some layer decodes exactly once first. */
+    @Test
+    public void httpPutWithDoubleEncodedTraversalDoesNotOverwriteSibling() throws Exception {
+        WireMockResponse response = client.putWithBody(
+                "/__admin/files/%2e%2e%2F__files-archive%2Fsecret.txt", "INJECTED-DOUBLE-ENCODED", "text/plain");
+
+        assertThat("SECURITY: sibling file must be untouched after an HTTP PUT double/mixed-encoded "
+                        + "traversal attempt (status " + response.statusCode() + ")",
+                secretContents(), is("TOP-SECRET-HTTP"));
+    }
+
+    // -------------------------------------------------------------------------- Positive control
+
+    /** A genuine single-segment filename must still route and write correctly over real HTTP. */
+    @Test
+    public void httpPutWithLegitimateFilenameStillWrites() throws Exception {
+        WireMockResponse response = client.putWithBody("/__admin/files/legit.json", "LEGIT-BODY", "text/plain");
+        assertThat(response.statusCode(), is(200));
+        File legit = new File(filesDir, "legit.json");
+        assertThat(new String(Files.readAllBytes(legit.toPath()), "UTF-8"), is("LEGIT-BODY"));
+    }
+
+    // ----------------------------------------------------------------------- Unit-level sinks
+
+    /**
+     * Absolute-path sibling-collision payload through FileSource.deleteFile(). deleteFile() ->
+     * writableFileFor() -> assertFilePathIsUnderRoot() is the same call chain the write sinks use,
+     * and writableFileFor() returns an absolute File unmodified, so the containment check is the only
+     * thing standing between this value and the real sibling file.
+     */
+    @Test
+    public void deleteAbsoluteSiblingCollisionDoesNotDeleteOutOfRootFile() throws Exception {
+        SingleRootFileSource filesSource = new SingleRootFileSource(filesDir);
+        String absSibling = secret.getCanonicalPath();
+        try {
+            filesSource.deleteFile(absSibling);
+            fail("SECURITY: deleteFile with an absolute sibling-collision path was admitted without rejection; "
+                    + "sibling still exists: " + secret.exists());
+        } catch (NotAuthorisedException expected) {
+            assertThat("SECURITY: sibling file must still exist after a rejected absolute-path delete",
+                    secret.exists(), is(true));
+        }
+    }
+
+    /**
+     * A NUL byte embedded in an otherwise-relative sibling-collision payload for the WRITE family
+     * (not just checked against getCanonicalPath() in isolation, but driven through the real
+     * writeBinaryFile() sink) -- must fail closed via the try/catch(IOException) in
+     * assertFilePathIsUnderRoot, never silently truncate and proceed.
+     */
+    @Test
+    public void writeWithEmbeddedNulByteInPayloadDoesNotEscapeRoot() throws Exception {
+        SingleRootFileSource filesSource = new SingleRootFileSource(filesDir);
+        String nulPayload = "legit.txt\u0000/../../__files-archive/secret.txt";
+        byte[] before = Files.readAllBytes(secret.toPath());
+        try {
+            filesSource.writeBinaryFile(nulPayload, "INJECTED-NUL".getBytes("UTF-8"));
+            byte[] after = Files.readAllBytes(secret.toPath());
+            assertThat("SECURITY: a NUL-byte payload must NOT overwrite the out-of-root sibling",
+                    new String(after, "UTF-8"), is(new String(before, "UTF-8")));
+        } catch (NotAuthorisedException expected) {
+            // correct: fails closed
+        }
+        assertThat(new String(Files.readAllBytes(secret.toPath()), "UTF-8"), is("TOP-SECRET-HTTP"));
+    }
+
+    /**
+     * The sibling itself is a SYMLINK (not a plain directory) pointing to a completely separate
+     * victim directory outside the whole filesRoot temp tree. canonicalize-then-compare must
+     * dereference the symlink and reject the resolved (real) target, exactly as it does for a plain
+     * sibling directory -- confirms the missing-trailing-separator fix is not defeated by routing the
+     * "sibling" through a symlink instead of a real directory.
+     */
+    @Test
+    public void writeSiblingSymlinkDoesNotEscapeToRealTarget() throws Exception {
+        Assume.assumeTrue("symlink support required", isSymlinkSupported());
+
+        File realVictimDir = temp.newFolder("realVictimOutsideEverything");
+        File realVictim = new File(realVictimDir, "secret.txt");
+        Files.write(realVictim.toPath(), "REAL-VICTIM-SECRET".getBytes("UTF-8"));
+
+        File symlinkSibling = new File(filesRootDir, "__filesEVILLINK");
+        Files.createSymbolicLink(symlinkSibling.toPath(), realVictimDir.toPath());
+
+        SingleRootFileSource filesSource = new SingleRootFileSource(filesDir);
+        try {
+            filesSource.writeBinaryFile("../__filesEVILLINK/secret.txt", "INJECTED-VIA-SYMLINK".getBytes("UTF-8"));
+            fail("SECURITY: writeBinaryFile through a sibling SYMLINK was admitted without rejection; "
+                    + "real victim now: " + new String(Files.readAllBytes(realVictim.toPath()), "UTF-8"));
+        } catch (NotAuthorisedException expected) {
+            assertThat("SECURITY: the real symlink target must be untouched after a rejected write",
+                    new String(Files.readAllBytes(realVictim.toPath()), "UTF-8"), is("REAL-VICTIM-SECRET"));
+        }
+    }
+
+    private static boolean isSymlinkSupported() {
+        try {
+            File tmp = File.createTempFile("symlink-support-check", ".tmp");
+            tmp.deleteOnExit();
+            File link = new File(tmp.getParentFile(), tmp.getName() + ".link");
+            Files.createSymbolicLink(link.toPath(), tmp.toPath());
+            link.delete();
+            tmp.delete();
+            return true;
+        } catch (Throwable t) {
+            return false;
+        }
+    }
+}
