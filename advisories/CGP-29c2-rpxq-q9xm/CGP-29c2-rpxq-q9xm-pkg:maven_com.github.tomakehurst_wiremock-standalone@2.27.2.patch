+package com.github.tomakehurst.wiremock.admin;
+
+import com.github.tomakehurst.wiremock.admin.model.PathParams;
+import com.github.tomakehurst.wiremock.admin.tasks.EditStubFileTask;
+import com.github.tomakehurst.wiremock.common.BinaryFile;
+import com.github.tomakehurst.wiremock.common.FileSource;
+import com.github.tomakehurst.wiremock.common.SingleRootFileSource;
+import com.github.tomakehurst.wiremock.common.TextFile;
+import com.github.tomakehurst.wiremock.core.Admin;
+import com.github.tomakehurst.wiremock.core.Options;
+import com.github.tomakehurst.wiremock.http.Request;
+import com.github.tomakehurst.wiremock.security.NotAuthorisedException;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.nio.file.Files;
+
+import static com.github.tomakehurst.wiremock.core.WireMockApp.FILES_ROOT;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+/**
+ * Regression tests for the sibling-directory escape in WireMock file operations (CWE-22 / CWE-73).
+ *
+ * AbstractFileSource.assertFilePathIsUnderRoot(String) canonicalized both the __files root and the
+ * target path (which defeats plain "../" traversal) but then compared them with a bare
+ * filePath.startsWith(rootPath), without appending File.separator. A sibling directory whose name
+ * merely has the root's canonical path as a string prefix (root "/x/__files", sibling
+ * "/x/__files-archive" or "/x/__filesEVIL") therefore passed the check, so a caller-supplied
+ * bodyFileName or {filename} value that canonically resolves into that sibling could read or write a
+ * file outside the intended root.
+ *
+ * These tests drive both:
+ *   - the SingleRootFileSource read/write sinks
+ *     (getBinaryFileNamed, getTextFileNamed, writeBinaryFile, writeTextFile -> assertFilePathIsUnderRoot), and
+ *   - the PUT /__admin/files/{name} route via
+ *     EditStubFileTask.execute(Admin,Request,PathParams) -> fileSource.writeBinaryFile(...),
+ * with the sibling payload "../__files-archive/secret.txt", a bare-suffix sibling
+ * ("../__filesEVIL/..."), and an absolute-path variant of the sibling collision.
+ *
+ * Each attack test asserts the security property, not just the exception: the sibling file's bytes
+ * are not read out (read family) and are not overwritten, and no new sibling file is created (write
+ * family), and the sink throws the NotAuthorisedException a correct containment check raises.
+ */
+public class EditStubFileTaskPathTraversalTest {
+
+    /** Sibling-collision payload: resolves into "__files-archive", next to "__files". */
+    private static final String SIBLING_PAYLOAD = "../__files-archive/secret.txt";
+
+    @Rule
+    public TemporaryFolder temp = new TemporaryFolder();
+
+    private File filesRootDir;   // <root>                 (Options.filesRoot())
+    private File filesDir;       // <root>/__files         (the guarded base the sinks resolve)
+    private File archiveSibling; // <root>/__files-archive (sibling sharing the "__files" prefix)
+    private File secret;         // <root>/__files-archive/secret.txt (the out-of-root victim)
+
+    private SingleRootFileSource filesSource;  // rooted at <root>/__files -- what EVERY sink guards
+
+    private EditStubFileTask editTask;
+    private Admin admin;
+
+    @Before
+    public void setUp() throws Exception {
+        filesRootDir = temp.newFolder("filesRoot");
+        filesDir = new File(filesRootDir, "__files");
+        assertTrue(filesDir.mkdirs());
+
+        // Sibling directory whose name ("__files-archive") has the "__files" root name as a raw
+        // string prefix but is NOT nested under it.
+        archiveSibling = new File(filesRootDir, "__files-archive");
+        assertTrue(archiveSibling.mkdirs());
+        secret = new File(archiveSibling, "secret.txt");
+        Files.write(secret.toPath(), "TOP-SECRET".getBytes("UTF-8"));
+
+        filesSource = new SingleRootFileSource(filesDir);
+
+        // End-to-end wiring for the admin PUT /__admin/files/{name} route: Options.filesRoot() returns
+        // <root>, and EditStubFileTask does filesRoot().child(FILES_ROOT) == <root>/__files.
+        FileSource filesRoot = new SingleRootFileSource(filesRootDir);
+        // Sanity: the sink's resolved base is the __files dir we guard.
+        assertThat(filesRoot.child(FILES_ROOT).getPath(), is(filesDir.getPath()));
+        Options options = mock(Options.class);
+        when(options.filesRoot()).thenReturn(filesRoot);
+        admin = mock(Admin.class);
+        when(admin.getOptions()).thenReturn(options);
+        editTask = new EditStubFileTask();
+    }
+
+    // ---------------------------------------------------------------- READ family (unit-level sinks)
+
+    /** getBinaryFileNamed with the sibling payload must NOT return the sibling file's bytes. */
+    @Test
+    public void readBinarySiblingCollisionDoesNotLeakOutOfRootFile() throws Exception {
+        try {
+            BinaryFile bf = filesSource.getBinaryFileNamed(SIBLING_PAYLOAD);
+            byte[] leaked = bf.readContents();               // harmful effect: bytes of the sibling file
+            fail("SECURITY: getBinaryFileNamed leaked out-of-root file contents: " + new String(leaked, "UTF-8"));
+        } catch (NotAuthorisedException expected) {
+            // payload refused by the containment check -- correct
+        }
+    }
+
+    /** getTextFileNamed with the sibling payload must NOT return the sibling file's text. */
+    @Test
+    public void readTextSiblingCollisionDoesNotLeakOutOfRootFile() throws Exception {
+        try {
+            TextFile tf = filesSource.getTextFileNamed(SIBLING_PAYLOAD);
+            String leaked = tf.readContentsAsString();       // harmful effect: sibling file text
+            fail("SECURITY: getTextFileNamed leaked out-of-root file contents: " + leaked);
+        } catch (NotAuthorisedException expected) {
+            // correct
+        }
+    }
+
+    /** Bare-suffix sibling ("__filesEVIL") -- no path separator between root name and suffix. */
+    @Test
+    public void readBareSuffixSiblingCollisionDoesNotLeakOutOfRootFile() throws Exception {
+        File evil = new File(filesRootDir, "__filesEVIL");
+        assertTrue(evil.mkdirs());
+        File evilSecret = new File(evil, "secret.txt");
+        Files.write(evilSecret.toPath(), "EVIL-SECRET".getBytes("UTF-8"));
+        try {
+            String leaked = filesSource.getTextFileNamed("../__filesEVIL/secret.txt").readContentsAsString();
+            fail("SECURITY: bare-suffix sibling read leaked out-of-root file contents: " + leaked);
+        } catch (NotAuthorisedException expected) {
+            // correct
+        }
+    }
+
+    /**
+     * Absolute-path variant of the sibling collision on the read sinks. The read sinks open
+     * new File(rootDirectory, name), and new File(File, absoluteString) appends the absolute value as
+     * a relative segment, so an absolute "<root>/__files-archive/secret.txt" resolves to a
+     * nonexistent path inside __files rather than to the real sibling. The test therefore asserts only
+     * the invariant that must hold either way: the real out-of-root secret is never returned.
+     */
+    @Test
+    public void readAbsoluteSiblingCollisionDoesNotLeakOutOfRootFile() throws Exception {
+        String absSibling = secret.getCanonicalPath();       // <root>/__files-archive/secret.txt (absolute)
+        File realSecretCanonical = secret.getCanonicalFile();
+        TextFile resolved;
+        try {
+            resolved = filesSource.getTextFileNamed(absSibling);
+        } catch (NotAuthorisedException refused) {
+            return; // refused by the containment check -- also acceptable
+        }
+        // The sink returned a file handle without rejecting. Prove it does NOT point at the real
+        // out-of-root sibling secret: new File(rootDirectory, absSibling) appends the absolute value
+        // as a relative segment, so it resolves to a nonexistent path INSIDE __files, never the sibling.
+        File actual = new File(resolved.getPath()).getCanonicalFile();
+        assertThat("SECURITY: an absolute sibling path must NOT resolve to the real out-of-root secret",
+                actual.equals(realSecretCanonical), is(false));
+    }
+
+    // --------------------------------------------------------------- WRITE family (unit-level sinks)
+
+    /** writeBinaryFile with the sibling payload must NOT overwrite the sibling file. */
+    @Test
+    public void writeBinarySiblingCollisionDoesNotOverwriteOutOfRootFile() throws Exception {
+        byte[] before = Files.readAllBytes(secret.toPath());
+        try {
+            filesSource.writeBinaryFile(SIBLING_PAYLOAD, "INJECTED".getBytes("UTF-8"));
+            // If no exception, prove nothing was written to the sibling.
+            byte[] after = Files.readAllBytes(secret.toPath());
+            assertThat("SECURITY: writeBinaryFile must NOT overwrite an out-of-root sibling file",
+                    new String(after, "UTF-8"), is(new String(before, "UTF-8")));
+            fail("SECURITY: writeBinaryFile with a sibling-collision path was admitted without rejection");
+        } catch (NotAuthorisedException expected) {
+            assertThat("SECURITY: sibling file must be untouched after a rejected write",
+                    new String(Files.readAllBytes(secret.toPath()), "UTF-8"), is("TOP-SECRET"));
+        }
+    }
+
+    /**
+     * Absolute-path variant of the sibling collision, write family. Unlike the read sinks,
+     * AbstractFileSource.writableFileFor(String) returns the caller-supplied File unmodified when
+     * File(name).isAbsolute() is true, so if assertFilePathIsUnderRoot(name) admitted an absolute
+     * sibling path, writeBinaryFile/writeTextFile would write straight to the real out-of-root file.
+     */
+    @Test
+    public void writeAbsoluteSiblingCollisionDoesNotOverwriteOutOfRootFile() throws Exception {
+        String absSibling = secret.getCanonicalPath(); // <root>/__files-archive/secret.txt (absolute)
+        byte[] before = Files.readAllBytes(secret.toPath());
+        try {
+            filesSource.writeBinaryFile(absSibling, "INJECTED-ABS".getBytes("UTF-8"));
+            byte[] after = Files.readAllBytes(secret.toPath());
+            assertThat("SECURITY: an absolute sibling path must NOT overwrite the real out-of-root secret",
+                    new String(after, "UTF-8"), is(new String(before, "UTF-8")));
+            fail("SECURITY: writeBinaryFile with an absolute sibling-collision path was admitted without rejection");
+        } catch (NotAuthorisedException expected) {
+            assertThat("SECURITY: sibling file must be untouched after a rejected absolute-path write",
+                    new String(Files.readAllBytes(secret.toPath()), "UTF-8"), is("TOP-SECRET"));
+        }
+    }
+
+    /** writeTextFile creating a NEW file in the sibling must be rejected -- no new file appears. */
+    @Test
+    public void writeTextSiblingCollisionDoesNotCreateOutOfRootFile() throws Exception {
+        File injected = new File(archiveSibling, "injected.txt");
+        assertThat("precondition: no injected file yet", injected.exists(), is(false));
+        try {
+            filesSource.writeTextFile("../__files-archive/injected.txt", "INJECTED-TEXT");
+            assertThat("SECURITY: writeTextFile must NOT create a file in an out-of-root sibling",
+                    injected.exists(), is(false));
+            fail("SECURITY: writeTextFile with a sibling-collision path was admitted without rejection");
+        } catch (NotAuthorisedException expected) {
+            assertThat("SECURITY: no out-of-root file must exist after a rejected write",
+                    injected.exists(), is(false));
+        }
+    }
+
+    // ------------------------------------------- WRITE family END-TO-END (PUT /__admin/files/{name})
+
+    /**
+     * The admin PUT /__admin/files/{name} request handler (EditStubFileTask) with a {filename} value
+     * that canonically resolves into the "__files-archive" sibling. The write must be refused and the
+     * sibling left untouched.
+     */
+    @Test
+    public void editStubFileTaskEndToEndSiblingCollisionDoesNotOverwriteOutOfRootFile() throws Exception {
+        Request request = mock(Request.class);
+        when(request.getBody()).thenReturn("INJECTED-VIA-ADMIN".getBytes("UTF-8"));
+
+        try {
+            editTask.execute(admin, request, PathParams.single("filename", SIBLING_PAYLOAD));
+            // No exception: prove the request body did not land in the sibling file.
+            assertThat("SECURITY: PUT /__admin/files must NOT overwrite an out-of-root sibling file",
+                    new String(Files.readAllBytes(secret.toPath()), "UTF-8"), is("TOP-SECRET"));
+            fail("SECURITY: PUT /__admin/files with a sibling-collision {filename} was admitted");
+        } catch (NotAuthorisedException expected) {
+            assertThat("SECURITY: sibling file must be untouched after a rejected admin write",
+                    new String(Files.readAllBytes(secret.toPath()), "UTF-8"), is("TOP-SECRET"));
+        }
+    }
+
+    // ------------------------------------------------------------------------- Positive controls
+
+    /** PRESERVATION: a legitimate top-level in-root read still works. */
+    @Test
+    public void legitimateTopLevelReadStillWorks() throws Exception {
+        File ok = new File(filesDir, "response.json");
+        Files.write(ok.toPath(), "OK-BODY".getBytes("UTF-8"));
+        assertThat(filesSource.getTextFileNamed("response.json").readContentsAsString(), is("OK-BODY"));
+    }
+
+    /** PRESERVATION: a legitimate nested-subdirectory in-root read still works. */
+    @Test
+    public void legitimateNestedReadStillWorks() throws Exception {
+        File sub = new File(filesDir, "subdir");
+        assertTrue(sub.mkdirs());
+        File ok = new File(sub, "nested.json");
+        Files.write(ok.toPath(), "NESTED-BODY".getBytes("UTF-8"));
+        assertThat(filesSource.getTextFileNamed("subdir/nested.json").readContentsAsString(), is("NESTED-BODY"));
+    }
+
+    /** PRESERVATION: a legitimate top-level in-root write still works. */
+    @Test
+    public void legitimateTopLevelWriteStillWorks() throws Exception {
+        filesSource.writeTextFile("written.json", "WRITTEN");
+        assertThat(new String(Files.readAllBytes(new File(filesDir, "written.json").toPath()), "UTF-8"),
+                is("WRITTEN"));
+    }
+
+    /** PRESERVATION: a legitimate nested-subdirectory in-root write still works. */
+    @Test
+    public void legitimateNestedWriteStillWorks() throws Exception {
+        File sub = new File(filesDir, "subdir");
+        assertTrue(sub.mkdirs());
+        filesSource.writeTextFile("subdir/written.json", "NESTED-WRITTEN");
+        assertThat(new String(Files.readAllBytes(new File(sub, "written.json").toPath()), "UTF-8"),
+                is("NESTED-WRITTEN"));
+    }
+
+    /** PRESERVATION end-to-end: a legitimate PUT /__admin/files/{name} still writes into __files. */
+    @Test
+    public void legitimateEditStubFileTaskEndToEndStillWrites() throws Exception {
+        Request request = mock(Request.class);
+        when(request.getBody()).thenReturn("LEGIT-BODY".getBytes("UTF-8"));
+        editTask.execute(admin, request, PathParams.single("filename", "legit.json"));
+        assertThat(new String(Files.readAllBytes(new File(filesDir, "legit.json").toPath()), "UTF-8"),
+                is("LEGIT-BODY"));
+    }
+}
