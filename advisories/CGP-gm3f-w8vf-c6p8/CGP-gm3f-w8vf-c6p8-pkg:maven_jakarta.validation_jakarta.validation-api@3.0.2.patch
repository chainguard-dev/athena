diff --git a/src/main/java/jakarta/validation/Validation.java b/src/main/java/jakarta/validation/Validation.java
index cac9304..88c5e99 100755
--- a/src/main/java/jakarta/validation/Validation.java
+++ b/src/main/java/jakarta/validation/Validation.java
@@ -607,6 +607,16 @@ public class Validation {
 
 		@Override
 		public T run() {
+			// Deny-by-default guard for CGP-gm3f-w8vf-c6p8 (CWE-470/CWE-266/CWE-913):
+			// the caller-supplied Class reaches this sink through the erased generic bound
+			// <U extends ValidationProvider<T>>, which a raw type / unchecked cast can violate.
+			// Positively confirm — with an identity-based Class supertype comparison, never a
+			// name/string comparison — that the class is assignable to ValidationProvider BEFORE
+			// its constructor runs, so no arbitrary caller-supplied class is ever instantiated
+			// (whether this action is invoked via AccessController.doPrivileged or action.run()).
+			if ( clazz == null || !ValidationProvider.class.isAssignableFrom( clazz ) ) {
+				throw new ValidationException( "Unable to find provider: " + clazz );
+			}
 			try {
 				return clazz.newInstance();
 			}
