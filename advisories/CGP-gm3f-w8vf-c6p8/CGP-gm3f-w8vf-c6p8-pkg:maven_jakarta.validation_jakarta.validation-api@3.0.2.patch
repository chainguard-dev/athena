+/*
+ * Jakarta Bean Validation API
+ *
+ * License: Apache License, Version 2.0
+ * See the license.txt file in the root directory or <http://www.apache.org/licenses/LICENSE-2.0>.
+ */
+package jakarta.validation;
+
+import static org.testng.Assert.assertFalse;
+import static org.testng.Assert.assertTrue;
+import static org.testng.Assert.fail;
+
+import org.testng.annotations.Test;
+
+import jakarta.validation.NonRegisteredValidationProvider.NonRegisteredConfiguration;
+import jakarta.validation.spi.ValidationProvider;
+
+/**
+ * Bypass-hunt probes against the guard added in commit 69a08ec ({@code NewProviderInstance.run()}
+ * in {@code Validation.java}). Each probe targets a gap class the patch's own checklist did not
+ * explicitly exercise: interface/abstract Class objects that trivially satisfy
+ * {@code isAssignableFrom} but cannot structurally be instantiated, an INDIRECT (transitive)
+ * ValidationProvider implementer, and a non-provider class that subclasses a class whose
+ * constructor performs a side effect (to confirm inheritance from a "privileged-looking"
+ * superclass does not let a non-provider class slip past the type check).
+ *
+ * <p>All probes are run with NO SecurityManager installed (the default, hardest-to-defend
+ * configuration per the Plan's completeness property) so any escape is immediately observable via
+ * the action.run() arm.
+ */
+public class BypassHunterTest {
+
+	// ---- Probe 1: an interface that extends ValidationProvider -------------------------------
+	// isAssignableFrom(SubProviderInterface.class) is trivially true (interface inheritance), but
+	// an interface Class object has no constructor at all -- newInstance() must fail structurally,
+	// not via the guard's own exception message. Confirms no side effect can occur regardless.
+	public interface SubProviderInterface extends ValidationProvider<NonRegisteredConfiguration> {
+	}
+
+	@Test(singleThreaded = true)
+	@SuppressWarnings({ "unchecked", "rawtypes" })
+	public void bypass_interfaceExtendingValidationProvider_noConstructorRuns() {
+		SecurityManager previous = System.getSecurityManager();
+		System.setSecurityManager( null );
+		try {
+			try {
+				Validation.byProvider( (Class) SubProviderInterface.class ).configure();
+				fail( "expected a ValidationException; an interface cannot be instantiated" );
+			}
+			catch ( ValidationException expected ) {
+				// either the pre-newInstance guard's own message, or the post-newInstance
+				// InstantiationException wrap -- both are safe (no constructor ran either way)
+			}
+		}
+		finally {
+			System.setSecurityManager( previous );
+		}
+	}
+
+	// ---- Probe 2: an abstract class implementing ValidationProvider --------------------------
+	// isAssignableFrom is true, but Class#newInstance() on an abstract class always throws
+	// InstantiationException before any constructor body (even the abstract class's own) executes.
+	public abstract static class AbstractProvider implements ValidationProvider<NonRegisteredConfiguration> {
+		static volatile boolean constructed = false;
+
+		public AbstractProvider() {
+			constructed = true;
+		}
+	}
+
+	@Test(singleThreaded = true)
+	@SuppressWarnings({ "unchecked", "rawtypes" })
+	public void bypass_abstractClassImplementingValidationProvider_noConstructorRuns() {
+		AbstractProvider.constructed = false;
+		SecurityManager previous = System.getSecurityManager();
+		System.setSecurityManager( null );
+		try {
+			try {
+				Validation.byProvider( (Class) AbstractProvider.class ).configure();
+				fail( "expected a ValidationException; an abstract class cannot be instantiated" );
+			}
+			catch ( ValidationException expected ) {
+				// safe: abstract classes cannot be instantiated regardless of the type check
+			}
+		}
+		finally {
+			System.setSecurityManager( previous );
+		}
+		assertFalse( AbstractProvider.constructed,
+				"an abstract ValidationProvider's constructor must never run (it cannot be instantiated)" );
+	}
+
+	// ---- Probe 3: a NON-provider class that subclasses a class whose constructor performs a
+	// side effect (stand-in for a "privileged-looking" superclass already on the classpath).
+	// Gadget itself does NOT implement ValidationProvider (only its superclass's constructor runs
+	// as part of Gadget's construction chain), so it must still be rejected by the type check
+	// before any construction -- proving that inheriting from an arbitrary class does not let a
+	// non-provider type slip past the identity-based isAssignableFrom guard.
+	public static class SideEffectSuper {
+		static volatile boolean superConstructed = false;
+
+		public SideEffectSuper() {
+			superConstructed = true;
+		}
+	}
+
+	public static class NonProviderSubclass extends SideEffectSuper {
+		// deliberately NOT implements ValidationProvider
+	}
+
+	@Test(singleThreaded = true)
+	@SuppressWarnings({ "unchecked", "rawtypes" })
+	public void bypass_nonProviderSubclassOfSideEffectSuperclass_rejectedBeforeConstruction() {
+		SideEffectSuper.superConstructed = false;
+		SecurityManager previous = System.getSecurityManager();
+		System.setSecurityManager( null );
+		try {
+			try {
+				Validation.byProvider( (Class) NonProviderSubclass.class ).configure();
+				fail( "expected ValidationException rejecting the non-provider subclass before construction" );
+			}
+			catch ( ValidationException expected ) {
+				// rejected before newInstance(); superclass constructor must never run
+			}
+		}
+		finally {
+			System.setSecurityManager( previous );
+		}
+		assertFalse( SideEffectSuper.superConstructed,
+				"BYPASS: a non-ValidationProvider class's superclass constructor ran via "
+						+ "Validation.byProvider(...).configure() despite the class itself failing "
+						+ "the ValidationProvider assignability check." );
+	}
+
+	// ---- Probe 4 (control, not a bypass): an INDIRECT (transitive) ValidationProvider
+	// implementer -- via a sub-interface -- must still be correctly ACCEPTED (isAssignableFrom is
+	// transitive). This confirms the guard is not accidentally over-narrow in a way that would
+	// tempt a future maintainer to loosen it (e.g. to a direct-supertype-only check).
+	public interface ExtendedProvider extends ValidationProvider<NonRegisteredConfiguration> {
+	}
+
+	public static class IndirectProviderImpl implements ExtendedProvider {
+		static volatile boolean constructed = false;
+
+		public IndirectProviderImpl() {
+			constructed = true;
+		}
+
+		@Override
+		public NonRegisteredConfiguration createSpecializedConfiguration(jakarta.validation.spi.BootstrapState state) {
+			return new NonRegisteredConfiguration();
+		}
+
+		@Override
+		public NonRegisteredConfiguration createGenericConfiguration(jakarta.validation.spi.BootstrapState state) {
+			return new NonRegisteredConfiguration();
+		}
+
+		@Override
+		public ValidatorFactory buildValidatorFactory(jakarta.validation.spi.ConfigurationState configurationState) {
+			return null;
+		}
+	}
+
+	@Test(singleThreaded = true)
+	@SuppressWarnings({ "unchecked", "rawtypes" })
+	public void control_indirectValidationProviderImplementer_stillAccepted() {
+		IndirectProviderImpl.constructed = false;
+		SecurityManager previous = System.getSecurityManager();
+		System.setSecurityManager( null );
+		try {
+			Object configuration = Validation.byProvider( (Class) IndirectProviderImpl.class ).configure();
+			assertTrue( configuration != null, "a legitimate transitive ValidationProvider must still construct" );
+		}
+		finally {
+			System.setSecurityManager( previous );
+		}
+		assertTrue( IndirectProviderImpl.constructed,
+				"sanity: the legitimate indirect provider's constructor should have run" );
+	}
+}
diff --git a/src/test/java/jakarta/validation/ConfusedDeputyExploitTest.java b/src/test/java/jakarta/validation/ConfusedDeputyExploitTest.java
