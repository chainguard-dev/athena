Subject: [PATCH] fix: stop cleaner thread clearing the map on interrupt

Vuln-ID: CGP-57cr-9rvh-qh62
Cgp-Finding: CGP-57cr-9rvh-qh62
---
 .../weaklockfree/WeakConcurrentMap.java       |   9 +-
 .../CleanerInterruptDataLossExploitTest.java  | 354 ++++++++++++++++++
 2 files changed, 361 insertions(+), 2 deletions(-)
 create mode 100644 src/test/java/com/blogspot/mydailyjava/weaklockfree/CleanerInterruptDataLossExploitTest.java

diff --git a/src/main/java/com/blogspot/mydailyjava/weaklockfree/WeakConcurrentMap.java b/src/main/java/com/blogspot/mydailyjava/weaklockfree/WeakConcurrentMap.java
index 1f0e61c..0948c8f 100644
--- a/src/main/java/com/blogspot/mydailyjava/weaklockfree/WeakConcurrentMap.java
+++ b/src/main/java/com/blogspot/mydailyjava/weaklockfree/WeakConcurrentMap.java
@@ -136,11 +136,16 @@ public class WeakConcurrentMap<K, V> extends ReferenceQueue<K> implements Runnab
     @Override
     public void run() {
         try {
-            while (true) {
+            while (!Thread.interrupted()) {
                 target.remove(remove());
             }
         } catch (InterruptedException ignored) {
-            clear();
+            // Terminate cleanly on interruption WITHOUT clearing the backing map.
+            // Clearing here would silently drop every live (strongly-reachable-keyed) entry,
+            // not just stale ones (CGP-57cr-9rvh-qh62 / CWE-404). Restore the interrupt status
+            // per the Java interruption contract so callers/frameworks that inspect the flag
+            // after run() returns still observe the interruption.
+            Thread.currentThread().interrupt();
         }
     }
 
diff --git a/src/test/java/com/blogspot/mydailyjava/weaklockfree/CleanerInterruptDataLossExploitTest.java b/src/test/java/com/blogspot/mydailyjava/weaklockfree/CleanerInterruptDataLossExploitTest.java
