+++ b/mockserver-netty/src/main/java/org/mockserver/dashboard/DashboardHandler.java
@@ -54,7 +54,17 @@ public class DashboardHandler {
             if (path.isEmpty() || path.equals("/")) {
                 path = "/index.html";
             }
-            try (InputStream contentStream = DashboardHandler.class.getResourceAsStream("/org/mockserver/dashboard" + path)) {
+            // CWE-22 / CGP-ww9v-8jj3-4xr6: the attacker-controlled URL suffix is concatenated onto the
+            // fixed classpath prefix and handed to getResourceAsStream(). Without containment, ".."
+            // segments (and lexical-prefix / sibling names) let an attacker read arbitrary classpath
+            // resources outside /org/mockserver/dashboard on an exploded classpath. Resolve the
+            // concatenated resource name to its canonical form (collapsing "."/".." segments) and
+            // require the result to remain inside the dashboard subtree with a separator-aware
+            // boundary. Fail closed: a name that escapes the subtree yields the ordinary not-found
+            // response (no bytes, no leaked diagnostic detail — CWE-200), indistinguishable from a
+            // genuinely missing in-tree resource.
+            final String resourceName = resolveContainedResourceName(path);
+            try (InputStream contentStream = resourceName == null ? null : DashboardHandler.class.getResourceAsStream(resourceName)) {
                 if (contentStream != null) {
                     final String extension = substringAfterLast(path, ".");
                     if (IS_STRING_CONTENT.contains(extension)) {
@@ -84,4 +94,56 @@ public class DashboardHandler {
             ctx.writeAndFlush(response);
         }
     }
+
+    /**
+     * The single classpath resource base the dashboard is allowed to serve from.
+     */
+    private static final String DASHBOARD_BASE = "/org/mockserver/dashboard";
+
+    /**
+     * Canonicalize the concatenated classpath resource name ({@code DASHBOARD_BASE + suffix}) and
+     * enforce that the resolved name stays INSIDE {@link #DASHBOARD_BASE}. Returns the safe, canonical
+     * resource name to open, or {@code null} when the requested name would escape the dashboard
+     * subtree (traversal, sibling/lexical-prefix collision, absolute-path injection, etc.) — the caller
+     * treats {@code null} as "resource not found" and fails closed.
+     *
+     * <p>This is an allow-by-containment check (CWE-184: positive containment, not a deny-list of bad
+     * substrings) evaluated on the fully normalized form (CWE-22: canonicalize-then-check ordering, no
+     * strip-and-continue), with a separator-aware boundary so a sibling such as
+     * {@code /org/mockserver/dashboard-marker.txt} is rejected even though it textually shares the base
+     * prefix.
+     */
+    private static String resolveContainedResourceName(final String suffix) {
+        // The suffix is a "/"-separated classpath sub-path. Normalize it segment-by-segment relative
+        // to the dashboard base, resolving "." and ".." and collapsing empty (duplicate-slash)
+        // segments. Any ".." that would rise above the base escapes the subtree -> reject.
+        final java.util.Deque<String> segments = new java.util.ArrayDeque<>();
+        for (final String segment : suffix.split("/", -1)) {
+            if (segment.isEmpty() || segment.equals(".")) {
+                // empty (leading/duplicate/trailing slash) or current-dir segment: skip.
+                continue;
+            }
+            if (segment.equals("..")) {
+                if (segments.isEmpty()) {
+                    // would escape above the dashboard base.
+                    return null;
+                }
+                segments.removeLast();
+                continue;
+            }
+            segments.add(segment);
+        }
+        final StringBuilder resolved = new StringBuilder(DASHBOARD_BASE);
+        for (final String segment : segments) {
+            resolved.append('/').append(segment);
+        }
+        final String resolvedName = resolved.toString();
+        // Separator-aware containment: the resolved name must be the base itself or live strictly
+        // beneath it. "startsWith(DASHBOARD_BASE)" alone would wrongly accept the sibling
+        // "/org/mockserver/dashboard-marker.txt"; requiring the next char be "/" closes that gap.
+        if (resolvedName.equals(DASHBOARD_BASE) || resolvedName.startsWith(DASHBOARD_BASE + "/")) {
+            return resolvedName;
+        }
+        return null;
+    }
 }
diff --git a/mockserver-netty/src/test/java/org/mockserver/dashboard/DashboardHandlerPathTraversalTest.java b/mockserver-netty/src/test/java/org/mockserver/dashboard/DashboardHandlerPathTraversalTest.java
