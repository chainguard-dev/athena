@@ -0,0 +1,301 @@
+package org.mockserver.dashboard;
+
+import com.google.common.io.ByteStreams;
+import io.netty.channel.ChannelFuture;
+import io.netty.channel.ChannelHandlerContext;
+import org.junit.Before;
+import org.junit.Test;
+import org.mockito.ArgumentCaptor;
+import org.mockserver.model.HttpRequest;
+import org.mockserver.model.HttpResponse;
+
+import java.io.InputStream;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.equalTo;
+import static org.hamcrest.Matchers.is;
+import static org.hamcrest.Matchers.not;
+import static org.hamcrest.Matchers.nullValue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+/**
+ * Exploit / regression harness for CGP-ww9v-8jj3-4xr6 (CWE-22 path traversal in
+ * {@link DashboardHandler}, related CWE-200 information exposure, CWE-184 incomplete list).
+ *
+ * <p>Drives the REAL runtime sink
+ * {@code DashboardHandler.renderDashboard(ChannelHandlerContext, HttpRequest)} which concatenates the
+ * attacker-controlled URL suffix (everything after {@code /mockserver/dashboard}) onto the fixed
+ * classpath prefix {@code /org/mockserver/dashboard} and hands the result to
+ * {@code DashboardHandler.class.getResourceAsStream(...)} at DashboardHandler.java:57, then streams
+ * the bytes back to the client via {@code ctx.writeAndFlush(response)}.
+ *
+ * <p>Response-shape facts (verified against the model):
+ * <ul>
+ *   <li>Resource-served (200) branch builds its response via {@code response()} — a bare
+ *       {@code new HttpResponse()} whose {@code getStatusCode()} is {@code null} (Netty applies the
+ *       default 200 only at serialization) but whose <em>body is populated</em> with the resource
+ *       bytes.</li>
+ *   <li>Not-found / rejection branch builds its response via {@code notFoundResponse()} —
+ *       {@code getStatusCode() == 404} with a {@code null} body.</li>
+ * </ul>
+ * The concrete HARMFUL EFFECT of the vulnerability is therefore: a traversal payload produces a
+ * response whose body contains the bytes of a resource resolved OUTSIDE
+ * {@code /org/mockserver/dashboard}. Each exploit test asserts that no out-of-tree bytes are returned
+ * and that the response is instead the not-found shape (404, empty body). On the unpatched build the
+ * body <em>does</em> contain the out-of-tree bytes, so these tests FAIL (RED); a correct containment
+ * fix makes them PASS (GREEN). The preservation tests pass on both builds.
+ */
+public class DashboardHandlerPathTraversalTest {
+
+    private static final String PREFIX = "/mockserver/dashboard";
+
+    private DashboardHandler handler;
+
+    @Before
+    public void setUp() {
+        handler = new DashboardHandler();
+    }
+
+    /**
+     * Invoke the real sink with a GET request whose path is {@code /mockserver/dashboard + suffix}
+     * and return the exact HttpResponse the handler wrote to the channel.
+     */
+    private HttpResponse renderAndCapture(String suffix) throws Exception {
+        HttpRequest request = new HttpRequest()
+            .withMethod("GET")
+            .withPath(PREFIX + suffix)
+            .withKeepAlive(false);
+
+        // Mock the Netty context; writeAndFlush(...).addListener(...) must not NPE.
+        ChannelHandlerContext ctx = mock(ChannelHandlerContext.class);
+        ChannelFuture future = mock(ChannelFuture.class);
+        when(ctx.writeAndFlush(org.mockito.ArgumentMatchers.any())).thenReturn(future);
+        when(future.addListener(org.mockito.ArgumentMatchers.any())).thenReturn(future);
+
+        handler.renderDashboard(ctx, request);
+
+        ArgumentCaptor<Object> captor = ArgumentCaptor.forClass(Object.class);
+        verify(ctx, times(1)).writeAndFlush(captor.capture());
+        return (HttpResponse) captor.getValue();
+    }
+
+    /** Read an in-tree resource's raw bytes directly, to compare against what the handler returns. */
+    private byte[] rawResourceBytes(String classpathName) throws Exception {
+        try (InputStream is = DashboardHandler.class.getResourceAsStream(classpathName)) {
+            assertThat("test setup: expected resource to exist: " + classpathName, is, is(not(nullValue())));
+            return ByteStreams.toByteArray(is);
+        }
+    }
+
+    private String rawResourceString(String classpathName) throws Exception {
+        return new String(rawResourceBytes(classpathName), "UTF-8");
+    }
+
+    /**
+     * Assert a response is the not-found / rejection shape: HTTP 404, no body, and (CWE-200) no leaked
+     * diagnostic detail (stack trace, exception message, resolved classpath path) in body or headers.
+     * This is the shape a traversal payload MUST produce — indistinguishable from the ordinary
+     * "resource not found inside the tree" response.
+     */
+    private void assertNotFoundShaped(HttpResponse response, String suffix) {
+        String body = response.getBodyAsString();
+        assertThat("rejection response must have no body, suffix=" + suffix,
+            (body == null || body.isEmpty()), is(true));
+        assertThat("traversal payload must yield the 404 not-found response, not the resource, suffix=" + suffix,
+            response.getStatusCode(), is(equalTo(404)));
+        // CWE-200: no leaked path / exception detail anywhere.
+        String headers = response.getHeaders() == null ? "" : response.getHeaders().toString();
+        String haystack = (body == null ? "" : body) + " " + headers;
+        assertThat("must not leak classpath path", haystack, not(containsString("/org/mockserver/dashboard")));
+        assertThat("must not leak exception detail", haystack.toLowerCase(), not(containsString("exception")));
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // RED: enumerated route — raw ".." traversal to a REAL out-of-tree classpath-root resource.
+    // On the unpatched build the response body contains the file's contents (harmful effect).
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    public void rawDotDotTraversalMustNotDiscloseOutOfTreeProperties() throws Exception {
+        String secret = rawResourceString("/example_logging_configuration.properties");
+        // sanity: the leak target genuinely exists at the classpath root, 3 levels above the base.
+        assertThat(secret, containsString("java.util.logging.FileHandler.pattern"));
+
+        HttpResponse response = renderAndCapture("/../../../example_logging_configuration.properties");
+
+        // HARMFUL EFFECT on unpatched build: the out-of-tree file's bytes are returned to the client.
+        String body = response.getBodyAsString();
+        assertThat("VULNERABLE: out-of-tree resource contents disclosed via '..' traversal",
+            body == null ? "" : body, not(containsString("java.util.logging.FileHandler.pattern")));
+        assertNotFoundShaped(response, "/../../../example_logging_configuration.properties");
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // RED: NON-ENUMERATED route — lexical-prefix / missing-separator collision. The suffix lands one
+    // level above the base then names a sibling whose classpath name textually starts with
+    // "/org/mockserver/dashboard" but is NOT inside it (/org/mockserver/dashboard-marker.txt).
+    // A naive startsWith(base) containment check passes this; a separator-aware check rejects it.
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    public void lexicalPrefixCollisionMustNotDiscloseSiblingResource() throws Exception {
+        String marker = rawResourceString("/org/mockserver/dashboard-marker.txt");
+        assertThat(marker, containsString("LEXICAL_PREFIX_COLLISION_SECRET_MARKER"));
+
+        HttpResponse response = renderAndCapture("/../dashboard-marker.txt");
+
+        // HARMFUL EFFECT on unpatched build: sibling-of-base resource contents disclosed.
+        String body = response.getBodyAsString();
+        assertThat("VULNERABLE: lexical-prefix sibling resource disclosed",
+            body == null ? "" : body, not(containsString("LEXICAL_PREFIX_COLLISION_SECRET_MARKER")));
+        assertNotFoundShaped(response, "/../dashboard-marker.txt");
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // RED: NON-ENUMERATED route — .class bytecode disclosure (the binary IS_STRING_CONTENT=false
+    // branch in the handler). Reads /org/mockserver/cli/Main.class via '..' traversal. Proves the fix
+    // must also close the binary branch, not only the string branch.
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    public void dotDotTraversalMustNotDiscloseClassBytecode() throws Exception {
+        byte[] classBytes = rawResourceBytes("/org/mockserver/cli/Main.class");
+        assertThat(classBytes.length > 0, is(true));
+
+        HttpResponse response = renderAndCapture("/../../../org/mockserver/cli/Main.class");
+
+        // HARMFUL EFFECT on unpatched build: .class file bytes returned (starts with 0xCAFEBABE).
+        byte[] returned = response.getBodyAsRawBytes();
+        boolean leakedClass = returned != null && returned.length >= 4
+            && (returned[0] & 0xFF) == 0xCA && (returned[1] & 0xFF) == 0xFE
+            && (returned[2] & 0xFF) == 0xBA && (returned[3] & 0xFF) == 0xBE;
+        assertThat("VULNERABLE: classpath .class bytecode disclosed via '..' traversal",
+            leakedClass, is(false));
+        assertNotFoundShaped(response, "/../../../org/mockserver/cli/Main.class");
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // OSV literal enumerated payloads — must be not-found-shaped (no throw, no leak). These target a
+    // file absent from THIS tree, so they 404 either way today; pinned so a future decode/refactor
+    // cannot silently reopen them, and to prove no exception escapes to the client (CWE-200).
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    public void osvLiteralApplicationPropertiesPayloadIsRejectedCleanly() throws Exception {
+        HttpResponse response = renderAndCapture("/../../../../application.properties");
+        assertNotFoundShaped(response, "/../../../../application.properties");
+    }
+
+    @Test
+    public void osvLiteralEncodedTraversalPayloadIsRejectedCleanly() throws Exception {
+        // KNOWN-BYPASS style payload, tested verbatim from ## Analyze.
+        HttpResponse response = renderAndCapture("/%2e%2e/%2e%2e/%2e%2e/%2e%2e/application.properties");
+        assertNotFoundShaped(response, "/%2e%2e/%2e%2e/%2e%2e/%2e%2e/application.properties");
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Additional bypass-class coverage: absolute-path/trailing-separator suffix and duplicate-separator
+    // variant. Must be not-found-shaped (never disclose out-of-tree content, never throw/leak).
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    public void trailingSeparatorTraversalVariantIsRejectedCleanly() throws Exception {
+        HttpResponse response = renderAndCapture("/../../../example_logging_configuration.properties/");
+        String body = response.getBodyAsString();
+        assertThat("trailing-separator variant must not disclose out-of-tree content",
+            body == null ? "" : body, not(containsString("java.util.logging.FileHandler.pattern")));
+        assertNotFoundShaped(response, "/../../../example_logging_configuration.properties/");
+    }
+
+    @Test
+    public void duplicateSlashTraversalVariantIsRejectedCleanly() throws Exception {
+        HttpResponse response = renderAndCapture("//../dashboard-marker.txt");
+        String body = response.getBodyAsString();
+        assertThat("duplicate-slash variant must not disclose sibling marker",
+            body == null ? "" : body, not(containsString("LEXICAL_PREFIX_COLLISION_SECRET_MARKER")));
+        assertNotFoundShaped(response, "//../dashboard-marker.txt");
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Genuine not-found baseline — a real, non-existent resource INSIDE the tree. Establishes the
+    // exact response shape the traversal rejections must be indistinguishable from.
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    public void genuineNotFoundInsideTreeIs404WithNoBody() throws Exception {
+        HttpResponse response = renderAndCapture("/does-not-exist.html");
+        assertThat(response.getStatusCode(), is(equalTo(404)));
+        String body = response.getBodyAsString();
+        assertThat(body == null || body.isEmpty(), is(true));
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Preservation (must-not-break) — legitimate resources still served with correct body + headers.
+    // These pass on BOTH the unpatched and patched builds; they guard against an over-broad fix.
+    // NOTE: the served (200) branch uses response() which leaves getStatusCode()==null, so we assert
+    // on body bytes and the Content-Type/Content-Length headers, not on the status code.
+    // ---------------------------------------------------------------------------------------------
+    private void assertServedOk(String suffix, String classpathName, String expectedContentType,
+                                boolean stringContent) throws Exception {
+        HttpResponse response = renderAndCapture(suffix);
+        byte[] expected = rawResourceBytes(classpathName);
+        // served branch: statusCode is null (default 200 applied at serialization), body populated.
+        assertThat("legitimate resource must be served (non-404), suffix=" + suffix,
+            response.getStatusCode(), is(nullValue()));
+        assertThat("Content-Type header, suffix=" + suffix,
+            response.getFirstHeader("Content-Type"), is(equalTo(expectedContentType)));
+        if (stringContent) {
+            String expectedStr = new String(expected, "UTF-8");
+            assertThat("body content, suffix=" + suffix,
+                response.getBodyAsString(), is(equalTo(expectedStr)));
+            assertThat("Content-Length header, suffix=" + suffix,
+                response.getFirstHeader("Content-Length"),
+                is(equalTo(String.valueOf(expectedStr.getBytes().length))));
+        } else {
+            byte[] actual = response.getBodyAsRawBytes();
+            assertThat("body bytes length, suffix=" + suffix, actual.length, is(equalTo(expected.length)));
+            assertThat("Content-Length header, suffix=" + suffix,
+                response.getFirstHeader("Content-Length"), is(equalTo(String.valueOf(expected.length))));
+        }
+    }
+
+    @Test
+    public void defaultIndexIsServed() throws Exception {
+        // "" and "/" both map to /index.html
+        String index = rawResourceString("/org/mockserver/dashboard/index.html");
+
+        HttpResponse rootEmpty = renderAndCapture("");
+        assertThat(rootEmpty.getBodyAsString(), is(equalTo(index)));
+
+        HttpResponse rootSlash = renderAndCapture("/");
+        assertThat(rootSlash.getBodyAsString(), is(equalTo(index)));
+
+        assertServedOk("/index.html", "/org/mockserver/dashboard/index.html", "text/html; charset=utf-8", true);
+    }
+
+    @Test
+    public void topLevelStaticFilesAreServed() throws Exception {
+        assertServedOk("/favicon.ico", "/org/mockserver/dashboard/favicon.ico", "image/x-icon", false);
+        assertServedOk("/apple-touch-icon.png", "/org/mockserver/dashboard/apple-touch-icon.png", "image/png", false);
+        assertServedOk("/asset-manifest.json", "/org/mockserver/dashboard/asset-manifest.json", "application/json; charset=UTF-8", true);
+        assertServedOk("/service-worker.js", "/org/mockserver/dashboard/service-worker.js", "application/javascript; charset=UTF-8", true);
+        assertServedOk("/AveriaSansLibre-Regular.ttf", "/org/mockserver/dashboard/AveriaSansLibre-Regular.ttf", "application/octet-stream", false);
+        assertServedOk("/AveriaSansLibre-Regular.woff2", "/org/mockserver/dashboard/AveriaSansLibre-Regular.woff2", "application/font-woff2", false);
+        assertServedOk("/precache-manifest.7e5b6099c96247cc327e95964d344a55.js",
+            "/org/mockserver/dashboard/precache-manifest.7e5b6099c96247cc327e95964d344a55.js",
+            "application/javascript; charset=UTF-8", true);
+    }
+
+    @Test
+    public void nestedStaticFilesWithMultiDotAndTildeNamesAreServed() throws Exception {
+        assertServedOk("/static/css/main.66fded09.chunk.css",
+            "/org/mockserver/dashboard/static/css/main.66fded09.chunk.css", "text/css; charset=utf-8", true);
+        assertServedOk("/static/css/main.66fded09.chunk.css.map",
+            "/org/mockserver/dashboard/static/css/main.66fded09.chunk.css.map", "application/json; charset=UTF-8", true);
+        assertServedOk("/static/js/main.defc53a6.chunk.js",
+            "/org/mockserver/dashboard/static/js/main.defc53a6.chunk.js", "application/javascript; charset=UTF-8", true);
+        assertServedOk("/static/js/2.d40871cb.chunk.js",
+            "/org/mockserver/dashboard/static/js/2.d40871cb.chunk.js", "application/javascript; charset=UTF-8", true);
+        // multi-dot AND tilde in the filename — must not be mistaken for a traversal signal
+        assertServedOk("/static/js/runtime~main.26e8d0d9.js",
+            "/org/mockserver/dashboard/static/js/runtime~main.26e8d0d9.js", "application/javascript; charset=UTF-8", true);
+    }
+}
