diff --git a/src/main/java/io/jsonwebtoken/impl/DefaultJwtParser.java b/src/main/java/io/jsonwebtoken/impl/DefaultJwtParser.java
index 4e4b9c7..5a8e2c8 100644
--- a/src/main/java/io/jsonwebtoken/impl/DefaultJwtParser.java
+++ b/src/main/java/io/jsonwebtoken/impl/DefaultJwtParser.java
@@ -242,6 +242,22 @@ public class DefaultJwtParser implements JwtParser {
             throw new MalformedJwtException("JWT string '" + jwt + "' is missing a body/payload.");
         }
 
+        // Signature-stripping guard (CGP-xpq5-jm7p-884r / CWE-347): if this parser has verification
+        // material configured (a Key, key bytes, or a SigningKeyResolver), a compact string whose
+        // signature segment is absent has NOT been cryptographically verified, so its
+        // header/claims/body must never be handed back to the caller. Presence of the third segment
+        // is attacker-controlled input; it must not be the sole gate that decides whether
+        // verification runs. Enforce this at the single parse(String) chokepoint -- before any
+        // Header/Claims/body is constructed -- so every public entry point (parse(String),
+        // parse(String, JwtHandler), parsePlaintextJwt, parseClaimsJwt, parsePlaintextJws,
+        // parseClaimsJws) is covered uniformly, and independently of the header's claimed 'alg'.
+        if (base64UrlEncodedDigest == null && isVerificationMaterialConfigured()) {
+            String msg = "JWT string has no signature segment, but this parser is configured with a " +
+                         "signing key / key bytes / SigningKeyResolver. The signature cannot be verified, " +
+                         "so the JWT is not trusted and must not be accepted.";
+            throw new SignatureException(msg);
+        }
+
         // =============== Header =================
         Header header = null;
 
@@ -465,6 +481,17 @@ public class DefaultJwtParser implements JwtParser {
         }
     }
 
+    /**
+     * Returns {@code true} if this parser has any verification material configured -- a {@link Key},
+     * key bytes (from {@code setSigningKey(byte[])}/{@code setSigningKey(String)}), or a
+     * {@link SigningKeyResolver}. When any of these is set, an incoming compact JWT whose signature
+     * segment is absent has not been (and cannot be) cryptographically verified and must be rejected
+     * rather than trusted (CGP-xpq5-jm7p-884r / CWE-347).
+     */
+    private boolean isVerificationMaterialConfigured() {
+        return this.key != null || !Objects.isEmpty(this.keyBytes) || this.signingKeyResolver != null;
+    }
+
     /*
      * @since 0.5 mostly to allow testing overrides
      */
