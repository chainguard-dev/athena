+package io.jsonwebtoken
+
+import io.jsonwebtoken.impl.TextCodec
+import org.junit.Test
+
+import javax.crypto.spec.SecretKeySpec
+import java.security.Key
+import java.security.SecureRandom
+
+import static org.junit.Assert.fail
+
+/**
+ * Exploit harness for CGP-xpq5-jm7p-884r (CWE-347 signature-stripping authentication bypass).
+ *
+ * Root cause: DefaultJwtParser.parse(String jwt) gates the ENTIRE signature-verification block
+ * solely on `base64UrlEncodedDigest != null`. An attacker strips the third (signature) segment
+ * (sending "header.payload." -- a trailing dot, empty third segment). The digest is then null, the
+ * verification block is skipped, and the parser returns a DefaultJwt / DefaultJws carrying the
+ * attacker's claims as authentic -- even though a Key, key bytes, or SigningKeyResolver is
+ * configured. This is a complete authentication bypass.
+ *
+ * Security invariant proven here (from ## Plan): a parser with verification material configured
+ * MUST NEVER hand back a Header/Claims/body derived from a compact string whose signature segment
+ * was absent-and-unverified, through ANY of the six public entry points, regardless of the
+ * attacker-controlled `alg` header value or whether the body is JSON claims or plain text.
+ *
+ * Each test drives the REAL runtime sink (DefaultJwtParser.parse(String)) via a public JwtParser
+ * entry point. On the UNPATCHED build every stripped-signature token is ACCEPTED, so the harmful
+ * effect (attacker claims / body returned unverified) fires and the test FAILS the run (fail()).
+ * A correct fix makes the parser throw MalformedJwtException or SignatureException from that sink
+ * BEFORE any body is constructed -- which each test catches as "this payload was refused" and the
+ * run then exits 0 (GREEN). The exploit asserts the SECURITY PROPERTY, so RED => non-zero exit.
+ *
+ * Only the SPECIFIC exception types a fix raises (MalformedJwtException / SignatureException) are
+ * treated as "refused"; no broad catch is used, so a natural/unexpected error cannot masquerade as
+ * a block.
+ */
+class SignatureStrippingExploitTest {
+
+    private static final SecureRandom RANDOM = new SecureRandom()
+
+    /** A random HMAC key so the parser genuinely has verification material configured. */
+    private static byte[] randomKeyBytes() {
+        byte[] key = new byte[64]
+        RANDOM.nextBytes(key)
+        return key
+    }
+
+    /**
+     * Build a stripped-signature compact token: base64url(header) "." base64url(payload) "." with an
+     * EMPTY third segment (the attacker strips the signature but keeps the trailing dot so the parser
+     * still counts exactly two '.' separators). Constructed by hand so no builder can refuse to
+     * produce the malformed token.
+     */
+    private static String strippedToken(String headerJson, String payload) {
+        return TextCodec.BASE64URL.encode(headerJson) + '.' +
+                TextCodec.BASE64URL.encode(payload) + '.'
+    }
+
+    // The OSV's literal documented payload, tested verbatim:
+    // eyJhbGciOiJub25lIn0.eyJzdWIiOiJhZG1pbiJ9.  ->  header {"alg":"none"}, payload {"sub":"admin"}
+    private static final String OSV_LITERAL_PAYLOAD = 'eyJhbGciOiJub25lIn0.eyJzdWIiOiJhZG1pbiJ9.'
+
+    // ---------------------------------------------------------------------------------------------
+    // Route 1 (ENUMERATED): OSV literal payload, verbatim, via parse(String), key bytes configured.
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    void testOsvLiteralPayloadViaParseStringWithKeyBytes() {
+        try {
+            Jwt jwt = Jwts.parser().setSigningKey(randomKeyBytes()).parse(OSV_LITERAL_PAYLOAD)
+            // HARMFUL EFFECT: an unsigned, unverified token was accepted and its claims handed back
+            // as authentic while a signing key is configured -> authentication bypass.
+            Claims claims = (Claims) jwt.getBody()
+            fail("VULNERABLE (CWE-347): parse(String) accepted the OSV stripped-signature token and " +
+                    "returned unverified claims sub=" + claims.getSubject() +
+                    " even though a signing key is configured.")
+        } catch (MalformedJwtException | SignatureException refused) {
+            // Correct fix: the sink refused the stripped-signature token. This payload passed.
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Route 2 (ENUMERATED config form): parse(String) with a Key object (setSigningKey(Key)).
+    // Same JSON-claims payload as the OSV; different verification-material configuration.
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    void testStrippedSignatureViaParseStringWithKeyObject() {
+        Key key = new SecretKeySpec(randomKeyBytes(), "HmacSHA256")
+        String token = strippedToken('{"alg":"HS256"}', '{"sub":"admin"}')
+        try {
+            Jwt jwt = Jwts.parser().setSigningKey(key).parse(token)
+            Claims claims = (Claims) jwt.getBody()
+            fail("VULNERABLE (CWE-347): parse(String) with a Key object configured accepted a " +
+                    "stripped-signature token and returned unverified claims sub=" + claims.getSubject())
+        } catch (MalformedJwtException | SignatureException refused) {
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Route 3 (NON-ENUMERATED entry point + config form): parseClaimsJwt() with key bytes.
+    // The OSV only named parse(String); a narrow call-site patch that only guards parse(String)'s
+    // JSON-claims branch would leave this convenience method exploitable.
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    void testStrippedSignatureViaParseClaimsJwtWithKeyBytes() {
+        String token = strippedToken('{"alg":"none"}', '{"sub":"admin"}')
+        try {
+            Jwt<Header, Claims> jwt = Jwts.parser().setSigningKey(randomKeyBytes()).parseClaimsJwt(token)
+            Claims claims = jwt.getBody()
+            fail("VULNERABLE (CWE-347): parseClaimsJwt() accepted a stripped-signature token and " +
+                    "returned unverified claims sub=" + claims.getSubject() +
+                    " even though a signing key is configured.")
+        } catch (MalformedJwtException | SignatureException refused) {
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Route 4 (NON-ENUMERATED entry point + NON-JSON body): parsePlaintextJwt() with a plain-text
+    // (non-JSON) payload, key bytes configured. Exercises the DefaultJwt-plaintext construction path
+    // that the OSV's JSON-claims example never touched.
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    void testStrippedSignatureViaParsePlaintextJwtWithKeyBytes() {
+        // Non-JSON body: does not start with '{' / end with '}', so it becomes a plaintext body.
+        String token = strippedToken('{"alg":"none"}', 'attacker-controlled-plaintext')
+        try {
+            Jwt<Header, String> jwt = Jwts.parser().setSigningKey(randomKeyBytes()).parsePlaintextJwt(token)
+            String body = jwt.getBody()
+            fail("VULNERABLE (CWE-347): parsePlaintextJwt() accepted a stripped-signature token and " +
+                    "returned unverified plaintext body '" + body + "' even though a signing key is configured.")
+        } catch (MalformedJwtException | SignatureException refused) {
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Route 5 (NON-ENUMERATED config form): setSigningKeyResolver(...) with a CUSTOM resolver.
+    // Because the digest is null the entire signature block is skipped, so the resolver is NEVER
+    // invoked -- yet the attacker's claims come back trusted. We assert BOTH the harmful effect
+    // (claims returned) AND the tell-tale that the resolver was never asked for a key.
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    void testStrippedSignatureViaSigningKeyResolver() {
+        final boolean[] resolverInvoked = [false]
+        SigningKeyResolver resolver = new SigningKeyResolverAdapter() {
+            @Override
+            Key resolveSigningKey(JwsHeader header, Claims claims) {
+                resolverInvoked[0] = true
+                return new SecretKeySpec(randomKeyBytes(), "HmacSHA256")
+            }
+
+            @Override
+            Key resolveSigningKey(JwsHeader header, String plaintext) {
+                resolverInvoked[0] = true
+                return new SecretKeySpec(randomKeyBytes(), "HmacSHA256")
+            }
+        }
+        String token = strippedToken('{"alg":"HS256"}', '{"sub":"admin"}')
+        try {
+            Jwt jwt = Jwts.parser().setSigningKeyResolver(resolver).parse(token)
+            Claims claims = (Claims) jwt.getBody()
+            fail("VULNERABLE (CWE-347): parse(String) with a SigningKeyResolver configured accepted " +
+                    "a stripped-signature token and returned unverified claims sub=" + claims.getSubject() +
+                    " (resolver invoked=" + resolverInvoked[0] + " -- verification was skipped entirely).")
+        } catch (MalformedJwtException | SignatureException refused) {
+        }
+    }
+
+    // ---------------------------------------------------------------------------------------------
+    // Route 6 (NON-ENUMERATED entry point): parse(String, JwtHandler) with a custom handler.
+    // Proves the guard must live at the shared chokepoint so it also covers the handler-dispatch
+    // entry point, not only the direct parse(String) callers.
+    // ---------------------------------------------------------------------------------------------
+    @Test
+    void testStrippedSignatureViaParseWithCustomHandler() {
+        String token = strippedToken('{"alg":"none"}', '{"sub":"admin"}')
+        JwtHandler<String> handler = new JwtHandlerAdapter<String>() {
+            @Override
+            String onClaimsJwt(Jwt<Header, Claims> jwt) {
+                return jwt.getBody().getSubject()
+            }
+        }
+        try {
+            String subject = Jwts.parser().setSigningKey(randomKeyBytes()).parse(token, handler)
+            fail("VULNERABLE (CWE-347): parse(String, JwtHandler) dispatched a stripped-signature " +
+                    "token to onClaimsJwt and returned unverified subject '" + subject +
+                    "' even though a signing key is configured.")
+        } catch (MalformedJwtException | SignatureException refused) {
+        }
+    }
+
+    // =============================================================================================
+    // PRESERVATION (positive-control) tests -- prove the guard's blast radius stays INSIDE the
+    // untrusted-input boundary (Plan "Must-not-break"). The guard fires ONLY when the signature
+    // segment is absent AND verification material is configured; every legitimate path below must
+    // still succeed unchanged.
+    // =============================================================================================
+
+    /**
+     * (a) No key/keyBytes/signingKeyResolver configured -> a genuinely unsigned compact JWT
+     * (RFC 7519 unsecured JWS, empty third segment) still parses successfully via parse(String),
+     * parseClaimsJwt(), and parsePlaintextJwt(). The guard must NOT fire when no verification
+     * material is configured.
+     */
+    @Test
+    void testUnsignedTokenStillParsesWhenNoVerificationMaterialConfigured() {
+        String claimsToken = strippedToken('{"alg":"none"}', '{"sub":"guest"}')
+        Jwt jwt = Jwts.parser().parse(claimsToken)
+        assert ((Claims) jwt.getBody()).getSubject() == 'guest'
+
+        Jwt<Header, Claims> claimsJwt = Jwts.parser().parseClaimsJwt(claimsToken)
+        assert claimsJwt.getBody().getSubject() == 'guest'
+
+        String plaintextToken = strippedToken('{"alg":"none"}', 'legitimate-unsigned-plaintext')
+        Jwt<Header, String> plaintextJwt = Jwts.parser().parsePlaintextJwt(plaintextToken)
+        assert plaintextJwt.getBody() == 'legitimate-unsigned-plaintext'
+    }
+
+    /**
+     * (b) With key bytes configured, a validly-signed token still verifies and parses end-to-end via
+     * parse(String) and parseClaimsJws().
+     */
+    @Test
+    void testValidlySignedTokenStillVerifiesWithKeyBytes() {
+        byte[] key = randomKeyBytes()
+        String signed = Jwts.builder().setSubject('legit').signWith(SignatureAlgorithm.HS256, key).compact()
+
+        Jwt parsed = Jwts.parser().setSigningKey(key).parse(signed)
+        assert ((Claims) parsed.getBody()).getSubject() == 'legit'
+
+        Jws<Claims> jws = Jwts.parser().setSigningKey(key).parseClaimsJws(signed)
+        assert jws.getBody().getSubject() == 'legit'
+    }
+
+    /**
+     * (b') With a Key object configured, a validly-signed token still verifies via parse(String).
+     */
+    @Test
+    void testValidlySignedTokenStillVerifiesWithKeyObject() {
+        byte[] keyBytes = randomKeyBytes()
+        Key key = new SecretKeySpec(keyBytes, 'HmacSHA256')
+        String signed = Jwts.builder().setSubject('legit').signWith(SignatureAlgorithm.HS256, key).compact()
+
+        Jwt parsed = Jwts.parser().setSigningKey(key).parse(signed)
+        assert ((Claims) parsed.getBody()).getSubject() == 'legit'
+    }
+
+    /**
+     * (b'') With key bytes configured, a validly-signed PLAINTEXT JWS still verifies and parses via
+     * parsePlaintextJws() (the non-JSON body path).
+     */
+    @Test
+    void testValidlySignedPlaintextJwsStillVerifiesWithKeyBytes() {
+        byte[] key = randomKeyBytes()
+        String signed = Jwts.builder().setPayload('legit-plaintext')
+                .signWith(SignatureAlgorithm.HS256, key).compact()
+
+        Jws<String> jws = Jwts.parser().setSigningKey(key).parsePlaintextJws(signed)
+        assert jws.getBody() == 'legit-plaintext'
+    }
+
+    /**
+     * (c) With a CUSTOM (test-defined) SigningKeyResolver configured, a validly-signed token still
+     * causes the resolver to be invoked and its returned key honored -- the fix must not
+     * short-circuit resolver invocation for legitimate signed input.
+     */
+    @Test
+    void testValidlySignedTokenStillInvokesCustomSigningKeyResolver() {
+        final byte[] key = randomKeyBytes()
+        final boolean[] resolverInvoked = [false]
+        SigningKeyResolver resolver = new SigningKeyResolverAdapter() {
+            @Override
+            byte[] resolveSigningKeyBytes(JwsHeader header, Claims claims) {
+                resolverInvoked[0] = true
+                return key
+            }
+        }
+        String signed = Jwts.builder().setSubject('legit').signWith(SignatureAlgorithm.HS256, key).compact()
+
+        Jws<Claims> jws = Jwts.parser().setSigningKeyResolver(resolver).parseClaimsJws(signed)
+        assert jws.getBody().getSubject() == 'legit'
+        assert resolverInvoked[0]  // resolver WAS asked for the key on the legitimate signed path
+    }
+}
