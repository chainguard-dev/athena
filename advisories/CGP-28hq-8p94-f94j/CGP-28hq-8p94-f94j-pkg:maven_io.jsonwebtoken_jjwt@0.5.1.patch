diff --git a/src/test/groovy/io/jsonwebtoken/impl/crypto/TimingOracleSignatureForgeryTest.groovy b/src/test/groovy/io/jsonwebtoken/impl/crypto/TimingOracleSignatureForgeryTest.groovy
